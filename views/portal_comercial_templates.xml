<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ACCESO DESDE EL PORTAL PRINCIPAL -->

    <template
        id="portal_my_home_commercial"
        inherit_id="portal.portal_my_home"
        priority="40"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">

            <t t-if="request.env.user.has_group(
                'copier_company.group_portal_commercial_executive'
            )">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">Portal Comercial</t>

                    <t t-set="text">
                        Cotizaciones, pedidos y facturas propias
                    </t>

                    <t t-set="url" t-value="'/my/commercial'"/>

                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>

        </xpath>
    </template>

    <!-- PANEL PRINCIPAL -->

    <template
        id="portal_commercial_home"
        name="Portal Comercial"
    >
        <t t-call="portal.portal_layout">

            <div class="container py-4">

                <div
                    class="p-4 mb-4 rounded-4 text-white shadow-sm"
                    style="background: linear-gradient(
                        135deg,
                        #5b3f57,
                        #3e2c3b
                    );"
                >
                    <div class="small text-uppercase opacity-75">
                        Área privada
                    </div>

                    <h1 class="h3 mb-2">
                        Portal Comercial
                    </h1>

                    <p class="mb-0">
                        Administre sus cotizaciones,
                        pedidos y facturas.
                    </p>
                </div>

                <div class="row g-3">

                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <div class="text-muted">
                                    Cotizaciones
                                </div>

                                <div class="display-6">
                                    <t t-esc="quotation_count"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <div class="text-muted">
                                    Pedidos
                                </div>

                                <div class="display-6">
                                    <t t-esc="order_count"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <div class="text-muted">
                                    Facturas
                                </div>

                                <div class="display-6">
                                    <t t-esc="invoice_count"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <div class="text-muted">
                                    Por publicar
                                </div>

                                <div class="display-6">
                                    <t t-esc="draft_invoice_count"/>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">

                    <a
                        href="/my/commercial/orders/new"
                        class="btn btn-primary"
                    >
                        <i class="fa fa-plus me-2"/>
                        Nueva cotización
                    </a>

                    <a
                        href="/my/commercial/orders"
                        class="btn btn-outline-primary"
                    >
                        Mis pedidos
                    </a>

                    <a
                        href="/my/commercial/invoices"
                        class="btn btn-outline-primary"
                    >
                        Mis facturas
                    </a>

                </div>

            </div>

        </t>
    </template>

    <!-- LISTADO DE PEDIDOS -->

    <template
        id="portal_commercial_orders"
        name="Pedidos de la ejecutiva"
    >
        <t t-call="portal.portal_layout">

            <div class="container py-4">

                <div
                    class="d-flex justify-content-between
                           align-items-center mb-3"
                >
                    <h1 class="h3 mb-0">
                        Mis cotizaciones y pedidos
                    </h1>

                    <a
                        href="/my/commercial/orders/new"
                        class="btn btn-primary"
                    >
                        Nueva cotización
                    </a>
                </div>

                <div class="card border-0 shadow-sm">

                    <div class="table-responsive">

                        <table
                            class="table table-hover
                                   align-middle mb-0"
                        >
                            <thead class="table-light">
                                <tr>
                                    <th>Número</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th class="text-end">
                                        Total
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr
                                    t-foreach="orders"
                                    t-as="order"
                                >
                                    <td>
                                        <a
                                            t-att-href="
                                                '/my/commercial/orders/%s'
                                                % order.id
                                            "
                                        >
                                            <strong
                                                t-esc="order.name"
                                            />
                                        </a>
                                    </td>

                                    <td
                                        t-esc="
                                            order.partner_id.display_name
                                        "
                                    />

                                    <td>
                                        <span
                                            t-field="order.date_order"
                                            t-options="{
                                                'widget': 'date'
                                            }"
                                        />
                                    </td>

                                    <td>
                                        <span
                                            class="badge text-bg-secondary"
                                            t-esc="
                                                dict(
                                                    order._fields[
                                                        'state'
                                                    ].selection
                                                ).get(order.state)
                                            "
                                        />
                                    </td>

                                    <td class="text-end">
                                        <span
                                            t-field="order.amount_total"
                                            t-options="{
                                                'widget': 'monetary',
                                                'display_currency':
                                                    order.currency_id
                                            }"
                                        />
                                    </td>
                                </tr>

                                <tr t-if="not orders">
                                    <td
                                        colspan="5"
                                        class="
                                            text-center
                                            text-muted
                                            py-5
                                        "
                                    >
                                        Todavía no tiene pedidos.
                                    </td>
                                </tr>

                            </tbody>
                        </table>

                    </div>
                </div>

                <div class="mt-3">
                    <t t-call="portal.pager"/>
                </div>

            </div>

        </t>
    </template>

    <!-- CREAR COTIZACIÓN -->

    <template
        id="portal_commercial_order_new"
        name="Nueva cotización comercial"
    >
        <t t-call="portal.portal_layout">

            <div class="container py-4">

                <div class="row justify-content-center">

                    <div class="col-lg-8">

                        <div class="card border-0 shadow-sm">

                            <div class="card-body p-4">

                                <h1 class="h3 mb-4">
                                    Nueva cotización
                                </h1>

                                <div
                                    t-if="error"
                                    class="alert alert-danger"
                                    t-esc="error"
                                />

                                <form method="post">

                                    <input
                                        type="hidden"
                                        name="csrf_token"
                                        t-att-value="
                                            request.csrf_token()
                                        "
                                    />

                                    <label
                                        class="form-label fw-semibold"
                                    >
                                        Cliente
                                    </label>

                                    <select
                                        name="partner_id"
                                        class="form-select"
                                        required="required"
                                    >
                                        <option value="">
                                            Seleccione un cliente...
                                        </option>

                                        <option
                                            t-foreach="customers"
                                            t-as="customer"
                                            t-att-value="customer.id"
                                            t-esc="
                                                customer.display_name
                                            "
                                        />

                                    </select>

                                    <div
                                        class="
                                            d-flex
                                            justify-content-end
                                            gap-2
                                            mt-4
                                        "
                                    >
                                        <a
                                            href="/my/commercial/orders"
                                            class="btn btn-light"
                                        >
                                            Cancelar
                                        </a>

                                        <button
                                            type="submit"
                                            class="btn btn-primary"
                                        >
                                            Crear cotización
                                        </button>
                                    </div>

                                </form>

                            </div>
                        </div>

                    </div>
                </div>

            </div>

        </t>
    </template>

    <!-- DETALLE DEL PEDIDO -->

    <template
        id="portal_commercial_order_detail"
        name="Detalle comercial del pedido"
    >
        <t t-call="portal.portal_layout">

            <div class="container py-4">

                <div
                    t-if="error"
                    class="alert alert-danger"
                    t-esc="error"
                />

                <div
                    t-if="success"
                    class="alert alert-success"
                    t-esc="success"
                />

                <div
                    class="
                        d-flex
                        flex-wrap
                        justify-content-between
                        align-items-start
                        gap-3
                        mb-3
                    "
                >
                    <div>
                        <div class="text-muted">
                            Cotización / Pedido
                        </div>

                        <h1
                            class="h3 mb-1"
                            t-esc="order.name"
                        />

                        <div
                            t-esc="
                                order.partner_id.display_name
                            "
                        />
                    </div>

                    <div class="text-end">
                        <span
                            class="badge text-bg-secondary"
                            t-esc="
                                dict(
                                    order._fields[
                                        'state'
                                    ].selection
                                ).get(order.state)
                            "
                        />

                        <div class="h4 mt-2">
                            <span
                                t-field="order.amount_total"
                                t-options="{
                                    'widget': 'monetary',
                                    'display_currency':
                                        order.currency_id
                                }"
                            />
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3">

                    <div class="table-responsive">

                        <table
                            class="
                                table
                                align-middle
                                mb-0
                            "
                        >
                            <thead class="table-light">
                                <tr>
                                    <th>
                                        Producto / descripción
                                    </th>

                                    <th style="width: 150px;">
                                        Cantidad
                                    </th>

                                    <th class="text-end">
                                        Precio
                                    </th>

                                    <th class="text-end">
                                        Subtotal
                                    </th>

                                    <th
                                        t-if="can_edit"
                                        style="width: 60px;"
                                    />
                                </tr>
                            </thead>

                            <tbody>

                                <t
                                    t-foreach="
                                        order.order_line
                                    "
                                    t-as="line"
                                >
                                    <tr
                                        t-if="
                                            not line.display_type
                                        "
                                    >
                                        <td>
                                            <strong
                                                t-esc="
                                                    line.product_id.
                                                    display_name
                                                "
                                            />

                                            <div
                                                class="
                                                    small
                                                    text-muted
                                                "
                                                style="
                                                    white-space:
                                                    pre-line;
                                                "
                                                t-esc="line.name"
                                            />
                                        </td>

                                        <td>
                                            <form
                                                t-if="can_edit"
                                                method="post"
                                                class="d-flex gap-1"
                                                t-att-action="
                                                    '/my/commercial/'
                                                    'orders/%s/'
                                                    'line/%s/update'
                                                    % (
                                                        order.id,
                                                        line.id
                                                    )
                                                "
                                            >
                                                <input
                                                    type="hidden"
                                                    name="csrf_token"
                                                    t-att-value="
                                                        request.
                                                        csrf_token()
                                                    "
                                                />

                                                <input
                                                    name="quantity"
                                                    type="number"
                                                    min="0.01"
                                                    step="0.01"
                                                    class="
                                                        form-control
                                                        form-control-sm
                                                    "
                                                    t-att-value="
                                                        line.
                                                        product_uom_qty
                                                    "
                                                />

                                                <button
                                                    type="submit"
                                                    class="
                                                        btn
                                                        btn-sm
                                                        btn-light
                                                    "
                                                >
                                                    <i
                                                        class="
                                                            fa
                                                            fa-save
                                                        "
                                                    />
                                                </button>
                                            </form>

                                            <span
                                                t-else=""
                                                t-esc="
                                                    line.
                                                    product_uom_qty
                                                "
                                            />
                                        </td>

                                        <td class="text-end">
                                            <span
                                                t-field="
                                                    line.price_unit
                                                "
                                                t-options="{
                                                    'widget':
                                                        'monetary',
                                                    'display_currency':
                                                        order.currency_id
                                                }"
                                            />
                                        </td>

                                        <td class="text-end">
                                            <span
                                                t-field="
                                                    line.price_subtotal
                                                "
                                                t-options="{
                                                    'widget':
                                                        'monetary',
                                                    'display_currency':
                                                        order.currency_id
                                                }"
                                            />
                                        </td>

                                        <td t-if="can_edit">
                                            <form
                                                method="post"
                                                t-att-action="
                                                    '/my/commercial/'
                                                    'orders/%s/'
                                                    'line/%s/delete'
                                                    % (
                                                        order.id,
                                                        line.id
                                                    )
                                                "
                                            >
                                                <input
                                                    type="hidden"
                                                    name="csrf_token"
                                                    t-att-value="
                                                        request.
                                                        csrf_token()
                                                    "
                                                />

                                                <button
                                                    type="submit"
                                                    class="
                                                        btn
                                                        btn-sm
                                                        btn-outline-danger
                                                    "
                                                >
                                                    <i
                                                        class="
                                                            fa
                                                            fa-trash
                                                        "
                                                    />
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                </t>

                                <tr
                                    t-if="
                                        not order.order_line
                                    "
                                >
                                    <td
                                        colspan="5"
                                        class="
                                            text-center
                                            text-muted
                                            py-4
                                        "
                                    >
                                        Agregue productos
                                        a la cotización.
                                    </td>
                                </tr>

                            </tbody>
                        </table>

                    </div>
                </div>

                <!-- BUSCADOR Y PRODUCTOS -->

                <div
                    t-if="can_edit"
                    class="card border-0 shadow-sm mb-3"
                >
                    <div class="card-body">

                        <h2 class="h5">
                            Agregar producto
                        </h2>

                        <form
                            method="get"
                            class="row g-2 mb-3"
                        >
                            <div class="col">
                                <input
                                    name="q"
                                    class="form-control"
                                    t-att-value="
                                        product_query
                                    "
                                    placeholder="
                                        Buscar por nombre
                                        o referencia...
                                    "
                                />
                            </div>

                            <div class="col-auto">
                                <button
                                    type="submit"
                                    class="
                                        btn
                                        btn-outline-primary
                                    "
                                >
                                    Buscar
                                </button>
                            </div>
                        </form>

                        <form
                            method="post"
                            class="row g-2"
                            t-att-action="
                                '/my/commercial/orders/%s/'
                                'line/add'
                                % order.id
                            "
                        >
                            <input
                                type="hidden"
                                name="csrf_token"
                                t-att-value="
                                    request.csrf_token()
                                "
                            />

                            <div class="col-md-8">
                                <select
                                    name="product_id"
                                    class="form-select"
                                    required="required"
                                >
                                    <option value="">
                                        Seleccione producto...
                                    </option>

                                    <option
                                        t-foreach="products"
                                        t-as="product"
                                        t-att-value="product.id"
                                        t-esc="
                                            product.display_name
                                        "
                                    />

                                </select>
                            </div>

                            <div class="col-md-2">
                                <input
                                    name="quantity"
                                    type="number"
                                    min="0.01"
                                    step="0.01"
                                    value="1"
                                    class="form-control"
                                    required="required"
                                />
                            </div>

                            <div class="col-md-2 d-grid">
                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >
                                    Agregar
                                </button>
                            </div>
                        </form>

                    </div>
                </div>

                <!-- ACCIONES -->

                <div
                    class="
                        d-flex
                        flex-wrap
                        justify-content-end
                        gap-2
                    "
                >
                    <form
                        t-if="
                            can_edit
                            and order.order_line
                        "
                        method="post"
                        t-att-action="
                            '/my/commercial/orders/%s/send'
                            % order.id
                        "
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="
                                request.csrf_token()
                            "
                        />

                        <button
                            type="submit"
                            class="btn btn-outline-primary"
                        >
                            <i class="fa fa-envelope me-1"/>
                            Enviar cotización
                        </button>
                    </form>

                    <form
                        t-if="
                            can_edit
                            and order.order_line
                        "
                        method="post"
                        t-att-action="
                            '/my/commercial/orders/%s/confirm'
                            % order.id
                        "
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="
                                request.csrf_token()
                            "
                        />

                        <button
                            type="submit"
                            class="btn btn-success"
                        >
                            Confirmar pedido
                        </button>
                    </form>

                    <form
                        t-if="can_invoice"
                        method="post"
                        t-att-action="
                            '/my/commercial/orders/%s/invoice'
                            % order.id
                        "
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="
                                request.csrf_token()
                            "
                        />

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Crear factura en borrador
                        </button>
                    </form>
                </div>

            </div>

        </t>
    </template>

    <!-- LISTADO DE FACTURAS -->

    <template
        id="portal_commercial_invoices"
        name="Facturas de la ejecutiva"
    >
        <t t-call="portal.portal_layout">

            <div class="container py-4">

                <h1 class="h3 mb-3">
                    Mis facturas
                </h1>

                <div class="card border-0 shadow-sm">

                    <div class="table-responsive">

                        <table
                            class="
                                table
                                table-hover
                                align-middle
                                mb-0
                            "
                        >
                            <thead class="table-light">
                                <tr>
                                    <th>Número</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th>Pago</th>
                                    <th class="text-end">
                                        Total
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr
                                    t-foreach="invoices"
                                    t-as="invoice"
                                >
                                    <td>
                                        <a
                                            t-att-href="
                                                '/my/commercial/'
                                                'invoices/%s'
                                                % invoice.id
                                            "
                                            t-esc="
                                                invoice.name
                                                or 'Borrador'
                                            "
                                        />
                                    </td>

                                    <td
                                        t-esc="
                                            invoice.partner_id.
                                            display_name
                                        "
                                    />

                                    <td>
                                        <span
                                            t-field="
                                                invoice.invoice_date
                                            "
                                        />
                                    </td>

                                    <td
                                        t-esc="
                                            dict(
                                                invoice._fields[
                                                    'state'
                                                ].selection
                                            ).get(invoice.state)
                                        "
                                    />

                                    <td
                                        t-esc="
                                            dict(
                                                invoice._fields[
                                                    'payment_state'
                                                ].selection
                                            ).get(
                                                invoice.payment_state
                                            )
                                        "
                                    />

                                    <td class="text-end">
                                        <span
                                            t-field="
                                                invoice.amount_total
                                            "
                                            t-options="{
                                                'widget':
                                                    'monetary',
                                                'display_currency':
                                                    invoice.currency_id
                                            }"
                                        />
                                    </td>
                                </tr>

                                <tr t-if="not invoices">
                                    <td
                                        colspan="6"
                                        class="
                                            text-center
                                            text-muted
                                            py-5
                                        "
                                    >
                                        No tiene facturas.
                                    </td>
                                </tr>

                            </tbody>
                        </table>

                    </div>
                </div>

                <div class="mt-3">
                    <t t-call="portal.pager"/>
                </div>

            </div>

        </t>
    </template>

    <!-- DETALLE DE FACTURA -->

    <template
        id="portal_commercial_invoice_detail"
        name="Detalle de factura comercial"
    >
        <t t-call="portal.portal_layout">

            <div class="container py-4">

                <div
                    t-if="error"
                    class="alert alert-danger"
                    t-esc="error"
                />

                <div
                    t-if="success"
                    class="alert alert-success"
                    t-esc="success"
                />

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <div
                            class="
                                d-flex
                                justify-content-between
                                gap-3
                            "
                        >
                            <div>
                                <div class="text-muted">
                                    Factura
                                </div>

                                <h1
                                    class="h3"
                                    t-esc="
                                        invoice.name
                                        or 'Borrador'
                                    "
                                />

                                <div
                                    t-esc="
                                        invoice.partner_id.
                                        display_name
                                    "
                                />
                            </div>

                            <div class="text-end">
                                <span
                                    class="badge"
                                    t-att-class="
                                        invoice.state == 'posted'
                                        and 'text-bg-success'
                                        or 'text-bg-warning'
                                    "
                                    t-esc="
                                        dict(
                                            invoice._fields[
                                                'state'
                                            ].selection
                                        ).get(invoice.state)
                                    "
                                />

                                <div class="h4 mt-2">
                                    <span
                                        t-field="
                                            invoice.amount_total
                                        "
                                        t-options="{
                                            'widget':
                                                'monetary',
                                            'display_currency':
                                                invoice.currency_id
                                        }"
                                    />
                                </div>
                            </div>
                        </div>

                        <hr/>

                        <div
                            t-if="invoice.state == 'draft'"
                            class="alert alert-warning"
                        >
                            Esta factura se encuentra en borrador.
                            Un usuario interno debe revisarla
                            y publicarla.
                        </div>

                        <div
                            t-if="invoice.state == 'posted'"
                            class="
                                d-flex
                                justify-content-end
                                flex-wrap
                                gap-2
                            "
                        >
                            <a
                                class="btn btn-outline-primary"
                                t-att-href="
                                    '/my/commercial/invoices/%s/pdf'
                                    % invoice.id
                                "
                            >
                                <i class="fa fa-download me-1"/>
                                Descargar PDF
                            </a>

                            <form
                                method="post"
