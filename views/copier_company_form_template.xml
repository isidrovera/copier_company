<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="copier_company_form_template" name="Solicitud rápida de cotización">
    <t t-call="website.layout">
      <style>
        .cc-lead{background:#f4f8fd;min-height:76vh;padding:36px 16px;font-family:Arial,sans-serif;color:#183651}
        .cc-lead *{box-sizing:border-box}
        .cc-lead-wrap{max-width:850px;margin:auto}
        .cc-lead h1{text-align:center;font-weight:800;font-size:clamp(26px,4vw,38px);margin:0 0 8px}
        .cc-lead-sub{text-align:center;color:#60748a;margin:0 0 23px}
        .cc-lead-card{background:#fff;border:1px solid #e0e9f5;border-radius:18px;padding:27px;box-shadow:0 12px 38px #123e6214}
        .cc-lead .cc-section-title{font-size:17px;font-weight:700;color:#16456d;margin:22px 0 12px;border-top:1px solid #e8eef5;padding-top:17px}
        .cc-lead label{display:block;font-weight:600;font-size:13px;margin-bottom:6px}
        .cc-lead input:not([type=checkbox]),.cc-lead textarea{width:100%;border:1px solid #cbd7e6;border-radius:9px;padding:11px 12px;background:#fff;color:#19334b;min-height:44px}
        .cc-lead input[readonly]{background:#f0f5fa}
        .cc-lead .cc-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
        .cc-lead .cc-field{margin-bottom:13px;min-width:0}
        .cc-lead .cc-inline{display:flex;gap:8px;align-items:stretch}
        .cc-lead .cc-inline input{min-width:0}
        .cc-lead button{cursor:pointer}
        .cc-lead .cc-search{background:#075dcc;border:0;color:white;border-radius:9px;padding:0 16px;font-weight:700}
        .cc-lead .cc-choices{display:flex;gap:8px;flex-wrap:wrap}
        .cc-lead .cc-choice{position:relative;cursor:pointer;flex:1;min-width:85px}
        .cc-lead .cc-choice input{position:absolute;opacity:0;pointer-events:none}
        .cc-lead .cc-choice span{display:block;text-align:center;border:1px solid #bdccde;border-radius:9px;padding:11px 9px;font-weight:700}
        .cc-lead .cc-choice input:checked+span{background:#075dcc;color:#fff;border-color:#075dcc}
        .cc-lead .cc-choice input:focus-visible+span{outline:3px solid #7cb4fb}
        .cc-lead .cc-note{font-size:12px;color:#627b91;margin-top:5px}
        .cc-lead .cc-manual{display:flex;gap:8px;align-items:center;margin-top:9px;color:#115cbb;font-size:13px}
        .cc-lead .cc-manual input,.cc-lead .cc-terms input{width:17px;height:17px;flex:0 0 auto}
        .cc-lead .cc-terms{display:flex;align-items:start;gap:8px;margin:14px 0;font-size:13px}
        .cc-lead .cc-terms label{font-weight:400;margin:0}
        .cc-lead .cc-submit{width:100%;background:#075dcc;border:0;border-radius:9px;padding:14px;color:white;font-weight:800;font-size:16px}
        .cc-lead button:disabled{opacity:.6;cursor:wait}
        .cc-lead .cc-notice{background:#e9f4ff;color:#144973;padding:10px 12px;border-radius:8px;margin:10px 0}
        .cc-lead .cc-notice.cc-error{background:#fff0f0;color:#9c2530}
        .cc-lead .cc-honey{position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden}
        @media(max-width:640px){.cc-lead{padding:19px 10px}.cc-lead-card{padding:17px}.cc-lead .cc-grid{grid-template-columns:1fr}.cc-lead h1{font-size:26px}.cc-lead .cc-search{padding:0 12px}}
      </style>
      <section class="cc-lead">
        <div class="cc-lead-wrap">
          <h1>Solicita tu cotización en 1 minuto</h1>
          <p class="cc-lead-sub">Alquiler, venta o servicio técnico. Autocompletamos DNI y RUC.</p>
          <div class="cc-lead-card">
            <t t-if="error_message"><div class="cc-notice cc-error" t-esc="error_message"/></t>
            <div id="cc_notice" class="cc-notice" hidden="hidden" aria-live="polite"/>
            <form id="copier_form" action="/cotizacion/submit" method="post">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <div class="cc-honey" aria-hidden="true"><label for="website_note">No llenar</label><input id="website_note" name="website_note" tabindex="-1" autocomplete="off"/></div>
              <div class="cc-field">
                <label>¿Qué necesitas?</label>
                <div class="cc-choices">
                  <label class="cc-choice"><input type="radio" name="solicitud_tipo" value="alquiler" required="required" t-att-checked="'checked' if (form_values or {}).get('solicitud_tipo', 'alquiler') == 'alquiler' else None"/><span>Alquiler</span></label>
                  <label class="cc-choice"><input type="radio" name="solicitud_tipo" value="venta" t-att-checked="'checked' if (form_values or {}).get('solicitud_tipo') == 'venta' else None"/><span>Venta</span></label>
                  <label class="cc-choice"><input type="radio" name="solicitud_tipo" value="servicio" t-att-checked="'checked' if (form_values or {}).get('solicitud_tipo') == 'servicio' else None"/><span>Servicio</span></label>
                </div>
              </div>
              <div class="cc-section-title">Datos del contacto</div>
              <div class="cc-field">
                <label for="dni_contacto">DNI del contacto</label>
                <div class="cc-inline"><input type="text" id="dni_contacto" name="dni_contacto" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" placeholder="8 dígitos" required="required" t-att-value="(form_values or {}).get('dni_contacto', '')"/><button id="buscar_dni" class="cc-search" type="button">Buscar</button></div>
                <div class="cc-note">Buscamos automáticamente el nombre.</div>
                <div class="cc-manual"><input type="checkbox" id="manual_contacto" name="manual_contacto" value="1"/><label for="manual_contacto" style="margin:0;font-weight:400">No tengo DNI / ingresar nombre manualmente</label></div>
              </div>
              <div class="cc-field"><label for="contacto">Nombre del contacto *</label><input id="contacto" name="contacto" required="required" maxlength="150" placeholder="Nombre y apellidos" t-att-value="(form_values or {}).get('contacto', '')"/></div>
              <div class="cc-section-title">Datos de la empresa</div>
              <div class="cc-field">
                <label for="ruc_empresa">RUC de la empresa *</label>
                <div class="cc-inline"><input type="text" id="ruc_empresa" name="ruc_empresa" inputmode="numeric" pattern="[0-9]{11}" maxlength="11" placeholder="11 dígitos" required="required" t-att-value="(form_values or {}).get('ruc_empresa', '')"/><button id="buscar_ruc" class="cc-search" type="button">Buscar</button></div>
              </div>
              <div class="cc-field"><label for="razon_social">Razón social *</label><input id="razon_social" name="razon_social" maxlength="200" required="required" placeholder="Nombre de la empresa" t-att-value="(form_values or {}).get('razon_social', '')"/></div>
              <div class="cc-grid">
                <div class="cc-field"><label for="correo">Correo electrónico *</label><input type="email" id="correo" name="correo" required="required" maxlength="254" placeholder="contacto@empresa.com" t-att-value="(form_values or {}).get('correo', '')"/></div>
                <div class="cc-field"><label for="telefono">Celular / teléfono *</label><input type="tel" id="telefono" name="telefono" required="required" maxlength="35" placeholder="999 888 777" t-att-value="(form_values or {}).get('telefono', '')"/></div>
              </div>
              <div class="cc-field"><label for="detalles">Descripción breve (opcional)</label><textarea name="detalles" id="detalles" rows="2" maxlength="1800" placeholder="¿Qué equipo o servicio necesitas?" t-esc="(form_values or {}).get('detalles', '')"/></div>
              <div class="cc-terms"><input type="checkbox" name="acepta_privacidad" id="acepta_privacidad" value="1" required="required"/><label for="acepta_privacidad">Acepto el tratamiento de mis datos personales según la política de privacidad de Copier Company SAC.</label></div>
              <button id="enviar_solicitud" class="cc-submit" type="submit">Solicitar cotización</button>
            </form>
          </div>
        </div>
      </section>
      <script src="/copier_company/static/src/js/cotizacion.js?v=20261103-2"></script>
    </t>
  </template>
  <template id="confirmacion_template" name="Confirmación de solicitud">
    <t t-call="website.layout">
      <section style="max-width:650px;margin:60px auto;padding:25px;text-align:center;border:1px solid #e0e8f1;border-radius:14px;font-family:Arial,sans-serif">
        <h1 style="color:#075dcc">¡Recibimos tu solicitud!</h1>
        <p>Gracias por contactar a Copier Company SAC. Nuestro equipo revisará tu solicitud.</p>
        <p><strong>Número de solicitud:</strong> <span t-esc="cotizacion.secuencia"/></p>
        <p><strong>Tipo:</strong> <span t-esc="solicitud_tipo"/></p>
        <p><strong>Empresa:</strong> <span t-esc="empresa_nombre"/></p>
        <a href="/" style="display:inline-block;padding:12px 25px;background:#075dcc;color:white;border-radius:9px;text-decoration:none">Volver al inicio</a>
      </section>
    </t>
  </template>
</odoo>
