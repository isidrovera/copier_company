<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="pcloud_files_template" name="Descargas">
    <t t-call="website.layout">
      <main id="cc-drive" class="cc-drive" t-att-data-folder="current_folder_id or 0">
        <div class="cc-shell">
          <aside class="cc-sidebar" aria-label="Navegación de archivos">
            <div class="cc-brand"><i class="fa fa-cloud"/> <span>Mis descargas</span></div>
            <a class="cc-nav-link" href="/soporte/descargas?folder_id=0"><i class="fa fa-home"/> Todos los archivos</a>
            <div class="cc-side-label">CARPETAS DISPONIBLES</div>
            <t t-foreach="root_folders" t-as="root">
              <a class="cc-nav-link" t-att-href="'/soporte/descargas?folder_id=%s' % root['id']"><i class="fa fa-folder-o"/> <span t-esc="root['name']"/></a>
            </t>
            <div class="cc-side-help"><i class="fa fa-lock"/> Acceso para clientes con licencia</div>
          </aside>
          <section class="cc-workspace">
            <div class="cc-topbar">
              <div><span class="cc-eyebrow">COPIER COMPANY / SOPORTE</span><h1>Archivos y descargas</h1></div>
              <div class="cc-top-actions"><button class="cc-icon-btn" id="cc-grid-button" title="Cuadrícula" type="button"><i class="fa fa-th-large"/></button><button class="cc-icon-btn" id="cc-list-button" title="Lista" type="button"><i class="fa fa-list"/></button></div>
            </div>
            <div class="cc-search-row">
              <form id="cc-search-form" role="search" autocomplete="off"><i class="fa fa-search"/><input id="cc-search" type="search" placeholder="Buscar en todas las carpetas y subcarpetas..." aria-label="Buscar archivos"/><button type="button" id="cc-clear" title="Limpiar búsqueda"><i class="fa fa-times"/></button></form>
              <span id="cc-search-status" class="cc-search-status" aria-live="polite"/>
            </div>
            <nav id="cc-crumbs" class="cc-crumbs" aria-label="Ubicación">
              <a href="/soporte/descargas?folder_id=0">Inicio</a>
              <t t-foreach="folder_path" t-as="folder"><i class="fa fa-angle-right"/><a t-att-href="'/soporte/descargas?folder_id=%s' % folder['id']" t-esc="folder['name']"/></t>
            </nav>
            <div class="cc-content-head"><div><h2 id="cc-heading">Contenido</h2><p id="cc-subtitle">Haz clic en una carpeta para abrirla o en un archivo para obtener una vista previa.</p></div><span class="cc-count" id="cc-count"><t t-esc="len(contents)"/> elementos</span></div>
            <div class="cc-table-head"><span>Nombre</span><span>Modificado</span><span>Tamaño</span><span>Acciones</span></div>
            <div id="cc-items" class="cc-items cc-list-mode">
              <t t-foreach="contents" t-as="item">
                <div class="cc-entry" t-att-data-id="item['id']" t-att-data-folder="'1' if item['isfolder'] else '0'" t-att-data-name="item['name']" t-att-data-size="item['size']" t-att-data-modified="item['modified']" t-att-data-path="item.get('path', '')">
                  <button type="button" class="cc-entry-main"><span t-att-class="'cc-file-symbol ' + ('cc-is-folder' if item['isfolder'] else 'cc-is-file')"><i t-att-class="'fa ' + ('fa-folder' if item['isfolder'] else 'fa-file-o')"/></span><span class="cc-entry-info"><strong t-esc="item['name']"/><small t-esc="item.get('path', '') or ('Carpeta' if item['isfolder'] else 'Archivo')"/></span></button>
                  <span class="cc-entry-date" t-esc="item['modified']"/><span class="cc-entry-size" t-esc="item['size'] or '—'"/>
                  <span class="cc-entry-actions"><a t-if="not item['isfolder']" t-att-href="'/soporte/descarga?file_id=%s' % item['id']" title="Descargar" class="cc-download-link"><i class="fa fa-download"/></a><i t-else="" class="fa fa-angle-right"/></span>
                </div>
              </t>
            </div>
            <div id="cc-empty" class="cc-empty" t-att-hidden="None if not contents else 'hidden'"><i class="fa fa-folder-open-o"/><h3>No hay archivos para mostrar</h3><p>Prueba otra búsqueda o abre una carpeta.</p></div>
          </section>
        </div>
        <div id="cc-modal" class="cc-modal" hidden="hidden" role="dialog" aria-modal="true" aria-labelledby="cc-modal-name">
          <div class="cc-shade" data-close="1"/>
          <div class="cc-dialog"><div class="cc-dialog-head"><div><span>VISTA PREVIA</span><h3 id="cc-modal-name">Archivo</h3></div><button type="button" id="cc-close" aria-label="Cerrar"><i class="fa fa-times"/></button></div><div id="cc-preview" class="cc-preview"/><div class="cc-dialog-footer"><span id="cc-modal-detail"/><a id="cc-modal-download" class="cc-primary-button" href="#"><i class="fa fa-download"/> Descargar archivo</a></div></div>
        </div>
      </main>
    </t>
  </template>
</odoo>
