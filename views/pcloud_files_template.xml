#cc-downloads :is(a, button, input):focus-visible { outline: 3px solid #87afff; outline-offset: 3px; }
@media (max-width: 800px) {
    #cc-downloads { padding: 18px 13px 38px; }
    #cc-downloads .cc-hero { border-radius: 18px; padding: 25px 22px; }
    #cc-downloads .cc-toolbar { align-items: flex-start; flex-direction: column; gap: 16px; }
    #cc-downloads .cc-toolbar-actions { width: 100%; justify-content: space-between; }
    #cc-downloads .cc-hero-mark { display: none; }
