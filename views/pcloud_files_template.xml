<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="pcloud_files_template" name="Descargas">
        <t t-call="website.layout">
            <div id="cc-downloads" class="cc-downloads" t-att-data-view="view_mode or 'list'">
                <div class="cc-shell">
                    <header class="cc-hero">
                        <div class="cc-hero-top">
                            <div class="cc-title-group">
                                <div class="cc-eyebrow"><i class="fa fa-cloud-download" aria-hidden="true"></i> PORTAL DE SOPORTE</div>
                                <h1>Centro de descargas</h1>
                                <p>Explore las carpetas y descargue sus archivos de forma individual.</p>
                            </div>
                            <div class="cc-hero-mark" aria-hidden="true"><i class="fa fa-folder-open"></i></div>
                        </div>
                        <form id="search-form" class="cc-search" action="/soporte/descargas" method="get" role="search">
                            <input type="hidden" name="folder_id" t-att-value="current_folder_id or 0"/>
                            <input type="hidden" name="view_mode" id="cc-search-view-mode" t-att-value="view_mode or 'list'"/>
                            <i class="fa fa-search cc-search-icon" aria-hidden="true"></i>
                            <input id="search-input" type="search" name="search" class="cc-search-input" placeholder="Buscar archivos y carpetas..." aria-label="Buscar archivos y carpetas" t-att-value="search or ''" autocomplete="off"/>
                            <button class="cc-search-submit" type="submit"><i class="fa fa-search" aria-hidden="true"></i><span>Buscar</span></button>
                        </form>
                    </header>

                    <main class="cc-main">
                        <div class="cc-toolbar">
                            <nav class="cc-breadcrumb" aria-label="Ruta de carpetas">
                                <a href="/soporte/descargas?folder_id=0" class="cc-crumb-home"><i class="fa fa-home" aria-hidden="true"></i><span>Inicio</span></a>
                                <t t-foreach="folder_path or []" t-as="folder">
                                    <i class="fa fa-chevron-right cc-chevron" aria-hidden="true"></i>
                                    <a t-if="not folder_last" t-att-href="'/soporte/descargas?folder_id=%s' % folder['id']" class="cc-crumb"><t t-esc="folder['name']"/></a>
                                    <span t-else="" class="cc-crumb cc-current" aria-current="page"><t t-esc="folder['name']"/></span>
                                </t>
                            </nav>
                            <div class="cc-toolbar-actions">
                                <span class="cc-count"><strong id="cc-visible-count"><t t-esc="len(contents)"/></strong> elementos</span>
                                <div class="cc-view-switch" role="group" aria-label="Presentación de archivos">
                                    <button type="button" id="list-view-btn" class="cc-view-btn" aria-label="Vista de lista" title="Vista de lista" aria-pressed="false"><i class="fa fa-list" aria-hidden="true"></i></button>
                                    <button type="button" id="kanban-view-btn" class="cc-view-btn" aria-label="Vista de cuadrícula" title="Vista de cuadrícula" aria-pressed="false"><i class="fa fa-th-large" aria-hidden="true"></i></button>
                                </div>
                            </div>
                        </div>

                        <t t-if="search">
                            <div class="cc-query-banner">
                                <span><i class="fa fa-search" aria-hidden="true"></i> Resultados para <strong><t t-esc="search"/></strong></span>
                                <a t-att-href="'/soporte/descargas?folder_id=%s' % current_folder_id">Limpiar búsqueda <i class="fa fa-times" aria-hidden="true"></i></a>
                            </div>
                        </t>

                        <t t-if="contents">
                            <section id="list-view" class="cc-panel" aria-label="Archivos en lista">
                                <div class="cc-table-scroll">
                                    <table class="cc-table">
                                        <thead><tr>
                                            <th scope="col">Nombre</th>
                                            <th scope="col">Tamaño</th>
                                            <th scope="col"><button type="button" id="modified-header" class="cc-sort-btn" aria-label="Ordenar por fecha">Modificado <i id="sort-icon" class="fa fa-sort" aria-hidden="true"></i></button></th>
                                            <th scope="col" class="cc-actions-title">Acción</th>
                                        </tr></thead>
                                        <tbody id="files-list">
                                            <t t-foreach="contents" t-as="item">
                                                <tr class="cc-file-row" t-att-data-name="item['name']" t-att-data-date="item['modified']">
                                                    <td>
                                                        <div class="cc-name-cell">
                                                            <div t-att-class="'cc-file-symbol ' + ('cc-folder-symbol' if item['isfolder'] else 'cc-document-symbol')">
                                                                <img t-att-src="'/copier_company/static/src/img/' + item['icon']" t-att-alt="item['name']" loading="lazy"/>
                                                            </div>
                                                            <div class="cc-name-content">
                                                                <t t-if="item['isfolder']">
                                                                    <a class="cc-file-name" t-att-href="'/soporte/descargas?folder_id=%s' % item['id']"><t t-esc="item['name']"/></a>
                                                                    <span class="cc-file-kind">Carpeta</span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="cc-file-name" t-att-title="item['name']"><t t-esc="item['name']"/></span>
                                                                    <span class="cc-file-kind">Archivo</span>
                                                                </t>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="cc-muted"><t t-esc="item['size'] or '—'"/></td>
                                                    <td class="cc-muted"><t t-esc="item['modified']"/></td>
                                                    <td class="cc-actions-cell">
                                                        <t t-if="item['isfolder']"><a class="cc-item-action cc-open" t-att-href="'/soporte/descargas?folder_id=%s' % item['id']"><i class="fa fa-folder-open" aria-hidden="true"></i><span>Abrir</span></a></t>
                                                        <t t-else=""><a class="cc-item-action cc-download" t-att-href="'/soporte/descarga?file_id=%s' % item['id']"><i class="fa fa-download" aria-hidden="true"></i><span>Descargar</span></a></t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                            <section id="kanban-view" class="cc-grid-section" aria-label="Archivos en cuadrícula" hidden="hidden">
                                <div class="cc-grid" id="cc-card-grid">
                                    <t t-foreach="contents" t-as="item">
                                        <article class="cc-file-card" t-att-data-name="item['name']">
                                            <div t-att-class="'cc-card-icon ' + ('cc-folder-symbol' if item['isfolder'] else 'cc-document-symbol')"><img t-att-src="'/copier_company/static/src/img/' + item['icon']" t-att-alt="item['name']" loading="lazy"/></div>
                                            <div class="cc-card-body">
                                                <t t-if="item['isfolder']"><a class="cc-card-name" t-att-href="'/soporte/descargas?folder_id=%s' % item['id']" t-att-title="item['name']"><t t-esc="item['name']"/></a></t>
                                                <t t-else=""><div class="cc-card-name" t-att-title="item['name']"><t t-esc="item['name']"/></div></t>
                                                <div class="cc-card-meta"><span><t t-esc="'Carpeta' if item['isfolder'] else (item['size'] or 'Archivo')"/></span><span class="cc-card-date"><t t-esc="item['modified']"/></span></div>
                                            </div>
                                            <t t-if="item['isfolder']"><a class="cc-card-action cc-open" t-att-href="'/soporte/descargas?folder_id=%s' % item['id']"><i class="fa fa-folder-open" aria-hidden="true"></i> Abrir carpeta</a></t>
                                            <t t-else=""><a class="cc-card-action cc-download" t-att-href="'/soporte/descarga?file_id=%s' % item['id']"><i class="fa fa-download" aria-hidden="true"></i> Descargar archivo</a></t>
                                        </article>
                                    </t>
                                </div>
                            </section>
                            <div id="cc-filter-empty" class="cc-empty" hidden="hidden"><i class="fa fa-search" aria-hidden="true"></i><h2>No hay coincidencias</h2><p>Pruebe con otro nombre de archivo o carpeta.</p></div>
                        </t>
                        <t t-else="">
                            <div class="cc-empty"><i class="fa fa-folder-open-o" aria-hidden="true"></i><h2><t t-esc="'Sin resultados' if search else 'Esta carpeta está vacía'"/></h2><p><t t-esc="'No se encontraron archivos o carpetas con ese término.' if search else 'No hay archivos disponibles en esta ubicación.'"/></p><a href="/soporte/descargas?folder_id=0" class="cc-empty-home"><i class="fa fa-home" aria-hidden="true"></i> Volver al inicio</a></div>
                        </t>
                    </main>
                </div>
            </div>
            <link rel="stylesheet" type="text/css" href="/copier_company/static/src/css/PcloudDescargas.css"/>
            <script type="text/javascript" src="/copier_company/static/src/js/PcloudDescargas.js"></script>
        </t>
    </template>
</odoo>
