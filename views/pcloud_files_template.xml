#cc-downloads .cc-table td { padding: 15px 22px; vertical-align: middle; border-bottom: 1px solid #eef1f6; font-size: 13px; }
#cc-downloads .cc-table td:first-child { padding-left: 26px; }
#cc-downloads .cc-table tbody tr:last-child td { border-bottom: 0; }
#cc-downloads .cc-file-row:hover { background: #f9fbff; }
#cc-downloads .cc-name-cell { display: flex; align-items: center; gap: 13px; min-width: 0; }
#cc-downloads .cc-file-symbol { width: 45px; height: 45px; border-radius: 12px; display: grid; place-items: center; flex-shrink: 0; }
#cc-downloads .cc-folder-symbol { background: #fff4db; }
#cc-downloads .cc-document-symbol { background: #eaf2ff; }
#cc-downloads .cc-file-symbol img { width: 27px; height: 27px; object-fit: contain; }
#cc-downloads .cc-name-content { display: flex; flex-direction: column; min-width: 0; gap: 3px; }
#cc-downloads .cc-file-name { font-size: 13px; color: var(--cc-ink); font-weight: 700; overflow-wrap: anywhere; }
#cc-downloads a.cc-file-name:hover { color: var(--cc-primary); }
#cc-downloads .cc-file-kind { font-size: 11px; color: #90a0b3; }
#cc-downloads .cc-muted { color: var(--cc-muted); }
#cc-downloads .cc-actions-cell { text-align: right; padding-right: 26px !important; white-space: nowrap; }
#cc-downloads .cc-item-action { border: 1px solid #dbe6f7; background: #f5f9ff; color: var(--cc-primary); font-size: 12px; font-weight: 750; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 36px; padding: 0 13px; }
#cc-downloads .cc-item-action.cc-download { color: var(--cc-success); background: #f0fbf6; border-color: #d5f0e1; }
#cc-downloads .cc-item-action:hover { filter: brightness(.97); }
#cc-downloads .cc-sort-btn { border: 0; background: none; padding: 0; text-transform: uppercase; letter-spacing: inherit; color: inherit; font-weight: inherit; cursor: pointer; font-size: inherit; }
#cc-downloads .cc-sort-btn i { margin-left: 6px; }
#cc-downloads .cc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(218px, 1fr)); gap: 18px; }
#cc-downloads .cc-file-card { display: flex; flex-direction: column; min-width: 0; background: #fff; border: 1px solid var(--cc-border); border-radius: 17px; padding: 22px; box-shadow: var(--cc-shadow); transition: transform .2s, box-shadow .2s, border-color .2s; }
#cc-downloads .cc-file-card:hover { transform: translateY(-3px); box-shadow: 0 16px 35px rgba(30,55,92,.09); border-color: #c9d9f5; }
#cc-downloads .cc-card-icon { height: 64px; width: 64px; border-radius: 17px; display: grid; place-items: center; margin-bottom: 20px; }
#cc-downloads .cc-card-icon img { width: 38px; height: 38px; object-fit: contain; }
#cc-downloads .cc-card-body { flex: 1; min-width: 0; }
#cc-downloads .cc-card-name { font-size: 14px; font-weight: 750; color: var(--cc-ink); line-height: 1.45; overflow-wrap: anywhere; min-height: 40px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
#cc-downloads a.cc-card-name:hover { color: var(--cc-primary); }
#cc-downloads .cc-card-meta { margin: 9px 0 19px; display: flex; flex-direction: column; gap: 4px; color: var(--cc-muted); font-size: 11px; }
#cc-downloads .cc-card-date { color: #94a1b3; }
#cc-downloads .cc-card-action { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 8px; min-height: 42px; border-radius: 10px; background: #edf4ff; color: var(--cc-primary); font-size: 12px; font-weight: 750; }
#cc-downloads .cc-card-action.cc-download { background: #eaf8f1; color: var(--cc-success); }
#cc-downloads .cc-card-action:hover { filter: brightness(.97); }
#cc-downloads .cc-empty { background: #fff; border: 1px dashed #d7e0ed; border-radius: 18px; padding: 65px 22px; text-align: center; color: var(--cc-muted); }
#cc-downloads .cc-empty > i { font-size: 50px; color: #a2b4d0; margin-bottom: 15px; }
#cc-downloads .cc-empty h2 { color: var(--cc-ink); font-size: 20px; font-weight: 750; margin: 0 0 9px; }
