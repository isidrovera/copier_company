<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pcloud_files_template" name="Descargas">
        <t t-call="website.layout">

            <div id="cc-dropbox" class="cc-dropbox"
                 t-att-data-folder-id="current_folder_id or 0">

                <div class="cc-container">

                    <!-- CABECERA -->
                    <header class="cc-header">
                        <div class="cc-heading">
                            <div class="cc-heading-icon">
                                <i class="fa fa-cloud-download"/>
                            </div>
                            <div>
                                <span class="cc-overline">COPIER COMPANY</span>
                                <h1>Centro de descargas</h1>
                                <p>Explora, visualiza y descarga tus archivos.</p>
                            </div>
                        </div>
                    </header>

                    <!-- BARRA DE HERRAMIENTAS -->
                    <section class="cc-toolbar">
                        <form id="search-form"
                              class="cc-search-form"
                              action="/soporte/descargas"
                              method="get">

                            <input type="hidden"
                                   name="folder_id"
                                   t-att-value="current_folder_id or 0"/>

                            <div class="cc-search-box">
                                <i class="fa fa-search"/>
                                <input type="search"
                                       id="search-input"
                                       name="search"
                                       placeholder="Buscar archivos y carpetas..."
                                       autocomplete="off"
                                       t-att-value="search or ''"/>

                                <button type="button"
                                        id="cc-clear-search"
                                        class="cc-clear-search"
                                        aria-label="Limpiar búsqueda">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>
                        </form>

                        <div class="cc-view-switch">
                            <button type="button"
                                    id="kanban-view-btn"
                                    class="cc-view-btn"
                                    title="Cuadrícula">
                                <i class="fa fa-th-large"/>
                            </button>
                            <button type="button"
                                    id="list-view-btn"
                                    class="cc-view-btn"
                                    title="Lista">
                                <i class="fa fa-list"/>
                            </button>
                        </div>
                    </section>

                    <!-- NAVEGACIÓN -->
                    <nav class="cc-breadcrumbs"
                         aria-label="Ruta de carpetas">

                        <a href="/soporte/descargas?folder_id=0"
                           class="cc-breadcrumb-home">
                            <i class="fa fa-home"/>
                            Inicio
                        </a>

                        <t t-foreach="folder_path or []" t-as="folder">
                            <i class="fa fa-angle-right cc-separator"/>

                            <a t-if="not folder_last"
                               t-att-href="'/soporte/descargas?folder_id=%s' % folder['id']"
                               class="cc-breadcrumb-link">
                                <t t-esc="folder['name']"/>
                            </a>

                            <span t-else=""
                                  class="cc-breadcrumb-current">
                                <t t-esc="folder['name']"/>
                            </span>
                        </t>
                    </nav>

                    <!-- INDICADORES -->
                    <section class="cc-summary">
                        <div class="cc-summary-heading">
                            <h2>Mis archivos</h2>
                            <span id="cc-item-count" class="cc-count">
                                <t t-esc="len(contents)"/> elementos
                            </span>
                        </div>
                        <p class="cc-summary-description">
                            Selecciona una carpeta para explorar su contenido
                            o un archivo para visualizar sus opciones.
                        </p>
                    </section>

                    <!-- ARCHIVOS RECIENTES -->
                    <section id="cc-recent-section"
                             class="cc-special-section"
                             hidden="hidden">
                        <div class="cc-section-header">
                            <div>
                                <h3>
                                    <i class="fa fa-clock-o"/>
                                    Añadidos recientemente
                                </h3>
                                <p>Últimos archivos disponibles</p>
                            </div>
                        </div>
                        <div id="cc-recent-grid" class="cc-recent-grid"/>
                    </section>

                    <!-- MÁS DESCARGADOS -->
                    <t t-if="popular_files">
                        <section class="cc-special-section">
                            <div class="cc-section-header">
                                <div>
                                    <h3>
                                        <i class="fa fa-line-chart"/>
                                        Más descargados
                                    </h3>
                                    <p>Archivos populares entre los clientes</p>
                                </div>
                            </div>

                            <div class="cc-popular-grid">
                                <t t-foreach="popular_files" t-as="popular">
                                    <div class="cc-popular-item">
                                        <div class="cc-popular-icon">
                                            <i class="fa fa-file-o"/>
                                        </div>

                                        <div class="cc-popular-info">
                                            <strong>
                                                <t t-esc="popular['name']"/>
                                            </strong>
                                            <small>
                                                <t t-esc="popular['downloads']"/>
                                                descargas
                                            </small>
                                        </div>

                                        <a t-att-href="'/soporte/descarga?file_id=%s' % popular['id']"
                                           class="cc-popular-download"
                                           title="Descargar">
                                            <i class="fa fa-download"/>
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </section>
                    </t>

                    <!-- EXPLORADOR -->
                    <section class="cc-explorer">

                        <div class="cc-explorer-header">
                            <h3>
                                <i class="fa fa-folder-open-o"/>
                                Contenido
                            </h3>

                            <span class="cc-explorer-count">
                                <t t-esc="len(contents)"/> elementos
                            </span>
                        </div>

                        <!-- CUADRÍCULA -->
                        <div id="kanban-view" class="cc-grid-view">
                            <div id="cc-card-grid" class="cc-files-grid">

                                <t t-foreach="contents" t-as="item">

                                    <t t-if="item['isfolder']">

                                        <!-- CARPETA -->
                                        <a class="cc-file-card cc-folder-card"
                                           t-att-href="'/soporte/descargas?folder_id=%s' % item['id']"
                                           t-att-data-name="item['name']"
                                           data-type="folder">

                                            <div class="cc-card-top">
                                                <span class="cc-file-type">
                                                    Carpeta
                                                </span>
                                            </div>

                                            <div class="cc-card-visual cc-folder-visual">
                                                <i class="fa fa-folder"/>
                                            </div>

                                            <div class="cc-card-info">
                                                <strong t-att-title="item['name']">
                                                    <t t-esc="item['name']"/>
                                                </strong>

                                                <span class="cc-card-details">
                                                    <i class="fa fa-folder-o"/>
                                                    Abrir carpeta
                                                </span>
                                            </div>
                                        </a>

                                    </t>

                                    <t t-else="">

                                        <!-- ARCHIVO -->
                                        <button type="button"
                                                class="cc-file-card cc-document-card cc-file-trigger"
                                                t-att-data-file-id="item['id']"
                                                t-att-data-name="item['name']"
                                                t-att-data-date="item['modified']"
                                                t-att-data-size="item['size']"
                                                t-att-data-icon="item['icon']"
                                                data-type="file">

                                            <div class="cc-card-top">
                                                <span class="cc-file-type">
                                                    Archivo
                                                </span>

                                                <span class="cc-card-more">
                                                    <i class="fa fa-ellipsis-h"/>
                                                </span>
                                            </div>

                                            <div class="cc-card-visual cc-document-visual">
                                                <img t-att-src="'/copier_company/static/src/img/' + item['icon']"
                                                     alt=""
                                                     loading="lazy"/>
                                            </div>

                                            <div class="cc-card-info">
                                                <strong t-att-title="item['name']">
                                                    <t t-esc="item['name']"/>
                                                </strong>

                                                <span class="cc-card-details">
                                                    <t t-esc="item['size']"/>
                                                </span>
                                            </div>
                                        </button>

                                    </t>

                                </t>
                            </div>
                        </div>

                        <!-- LISTA -->
                        <div id="list-view"
                             class="cc-list-view"
                             hidden="hidden">

                            <div class="cc-table-wrapper">
                                <table class="cc-files-table">
                                    <thead>
                                        <tr>
                                            <th>Nombre</th>
                                            <th>Tipo</th>
                                            <th>Tamaño</th>
                                            <th>
                                                <button type="button"
                                                        id="modified-header"
                                                        class="cc-sort-control">
                                                    Modificado
                                                    <i id="sort-icon"
                                                       class="fa fa-sort"/>
                                                </button>
                                            </th>
                                            <th>Acción</th>
                                        </tr>
                                    </thead>

                                    <tbody id="files-list">

                                        <t t-foreach="contents" t-as="item">

                                            <tr class="cc-file-row"
                                                t-att-data-name="item['name']"
                                                t-att-data-date="item['modified']">

                                                <td>
                                                    <div class="cc-row-name">

                                                        <div class="cc-row-icon">
                                                            <t t-if="item['isfolder']">
                                                                <i class="fa fa-folder"/>
                                                            </t>

                                                            <t t-else="">
                                                                <img t-att-src="'/copier_company/static/src/img/' + item['icon']"
                                                                     alt=""/>
                                                            </t>
                                                        </div>

                                                        <t t-if="item['isfolder']">
                                                            <a t-att-href="'/soporte/descargas?folder_id=%s' % item['id']"
                                                               class="cc-row-link">
                                                                <t t-esc="item['name']"/>
                                                            </a>
                                                        </t>

                                                        <t t-else="">
                                                            <button type="button"
                                                                    class="cc-row-link cc-file-trigger"
                                                                    t-att-data-file-id="item['id']"
                                                                    t-att-data-name="item['name']"
                                                                    t-att-data-date="item['modified']"
                                                                    t-att-data-size="item['size']"
                                                                    t-att-data-icon="item['icon']">
                                                                <t t-esc="item['name']"/>
                                                            </button>
                                                        </t>
                                                    </div>
                                                </td>

                                                <td>
                                                    <t t-esc="'Carpeta' if item['isfolder'] else 'Archivo'"/>
                                                </td>

                                                <td>
                                                    <t t-esc="item['size'] or '—'"/>
                                                </td>

                                                <td>
                                                    <t t-esc="item['modified']"/>
                                                </td>

                                                <td>
                                                    <t t-if="item['isfolder']">
                                                        <a t-att-href="'/soporte/descargas?folder_id=%s' % item['id']"
                                                           class="cc-row-action"
                                                           title="Abrir carpeta">
                                                            <i class="fa fa-arrow-right"/>
                                                        </a>
                                                    </t>

                                                    <t t-else="">
                                                        <a t-att-href="'/soporte/descarga?file_id=%s' % item['id']"
                                                           class="cc-row-action"
                                                           title="Descargar archivo">
                                                            <i class="fa fa-download"/>
                                                        </a>
                                                    </t>
                                                </td>
                                            </tr>

                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- SIN RESULTADOS DE BÚSQUEDA -->
                        <div id="cc-filter-empty"
                             class="cc-empty-state"
                             hidden="hidden">
                            <i class="fa fa-search"/>
                            <h3>No se encontraron coincidencias</h3>
                            <p>Prueba con otro nombre de archivo o carpeta.</p>
                        </div>

                        <!-- CARPETA VACÍA -->
                        <t t-if="not contents">
                            <div class="cc-empty-state">
                                <i class="fa fa-folder-open-o"/>
                                <h3>No hay elementos disponibles</h3>
                                <p>
                                    Esta carpeta está vacía o no se encontraron
                                    archivos con la búsqueda indicada.
                                </p>
                            </div>
                        </t>

                    </section>

                </div>

                <!-- MODAL DE ARCHIVO -->
                <div id="cc-file-modal"
                     class="cc-modal"
                     hidden="hidden"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="cc-modal-filename">

                    <div class="cc-modal-backdrop"
                         id="cc-modal-backdrop"/>

                    <div class="cc-modal-panel">

                        <div class="cc-modal-header">
                            <div class="cc-modal-title">
                                <i class="fa fa-file-o"/>
                                <h3 id="cc-modal-filename">Archivo</h3>
                            </div>

                            <button type="button"
                                    id="cc-modal-close"
                                    class="cc-modal-close"
                                    aria-label="Cerrar">
                                <i class="fa fa-times"/>
                            </button>
                        </div>

                        <div class="cc-modal-content">
                            <div id="cc-preview-container"
                                 class="cc-preview-container">
                                <div class="cc-preview-placeholder">
                                    <i class="fa fa-file-o"/>
                                    <p>Selecciona una opción para continuar.</p>
                                </div>
                            </div>

                            <div class="cc-modal-details">
                                <div>
                                    <span>Tamaño</span>
                                    <strong id="cc-modal-size">—</strong>
                                </div>
                                <div>
                                    <span>Modificado</span>
                                    <strong id="cc-modal-date">—</strong>
                                </div>
                            </div>
                        </div>

                        <div class="cc-modal-footer">
                            <button type="button"
                                    id="cc-preview-btn"
                                    class="cc-btn cc-btn-secondary">
                                <i class="fa fa-eye"/>
                                Vista previa
                            </button>

                            <a id="cc-modal-download"
                               href="#"
                               class="cc-btn cc-btn-primary">
                                <i class="fa fa-download"/>
                                Descargar
                            </a>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ESTILOS EXTERNOS -->
            <link rel="stylesheet"
                  type="text/css"
                  href="/copier_company/static/src/css/PcloudDescargas.css"/>

            <!-- JAVASCRIPT EXTERNO -->
            <script type="text/javascript"
                    src="/copier_company/static/src/js/PcloudDescargas.js"/>

        </t>
    </template>
</odoo>