#cc-downloads .cc-shell { max-width: 1400px; margin: 0 auto; }
#cc-downloads .cc-hero {
    background: linear-gradient(117deg, #102c63 0%, #1e50a0 58%, #2563eb 100%);
    border-radius: 24px; padding: 34px 38px 38px; color: #fff;
    box-shadow: 0 18px 44px rgba(34, 80, 158, .17); overflow: hidden;
}
#cc-downloads .cc-hero-top { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
#cc-downloads .cc-eyebrow { font-size: 11px; font-weight: 800; letter-spacing: 1.4px; color: #b8d5ff; margin-bottom: 11px; }
#cc-downloads .cc-eyebrow i { margin-right: 7px; }
#cc-downloads .cc-title-group h1 { color: #fff; font-weight: 750; font-size: clamp(28px, 3vw, 39px); line-height: 1.15; letter-spacing: -.9px; margin: 0 0 10px; }
#cc-downloads .cc-title-group p { color: #dce9ff; margin: 0; font-size: 14px; }
#cc-downloads .cc-hero-mark { width: 76px; height: 76px; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid rgba(255,255,255,.22); border-radius: 23px; font-size: 34px; background: rgba(255,255,255,.10); }
#cc-downloads .cc-search { background: #fff; border: 1px solid rgba(255,255,255,.8); display: flex; align-items: center; border-radius: 15px; min-height: 58px; margin-top: 28px; padding: 6px 6px 6px 19px; box-shadow: 0 9px 25px rgba(5,20,50,.09); }
#cc-downloads .cc-search-icon { color: #8694a9; font-size: 17px; }
#cc-downloads .cc-search-input { flex: 1; min-width: 0; padding: 8px 14px; border: 0; outline: none; background: transparent; color: var(--cc-ink); font-size: 15px; box-shadow: none; }
#cc-downloads .cc-search-input:focus { outline: none; box-shadow: none; }
#cc-downloads .cc-search-input::placeholder { color: #91a0b3; }
#cc-downloads .cc-search-submit { border: 0; background: var(--cc-primary); color: #fff; font-size: 13px; font-weight: 700; border-radius: 11px; height: 44px; display: flex; align-items: center; justify-content: center; gap: 8px; padding: 0 24px; transition: background .2s; }
#cc-downloads .cc-search-submit:hover { background: var(--cc-primary-dark); }
#cc-downloads .cc-main { padding-top: 26px; }
#cc-downloads .cc-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 20px; }
#cc-downloads .cc-breadcrumb { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; min-width: 0; font-size: 13px; }
#cc-downloads .cc-crumb-home { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: var(--cc-primary); }
#cc-downloads .cc-crumb { color: var(--cc-muted); font-weight: 600; overflow-wrap: anywhere; }
#cc-downloads a.cc-crumb:hover { color: var(--cc-primary); }
#cc-downloads .cc-crumb.cc-current { color: var(--cc-ink); }
#cc-downloads .cc-chevron { font-size: 10px; color: #adbacd; }
#cc-downloads .cc-toolbar-actions { display: flex; align-items: center; flex: 0 0 auto; gap: 16px; }
#cc-downloads .cc-count { color: var(--cc-muted); font-size: 13px; }
#cc-downloads .cc-count strong { color: var(--cc-ink); }
#cc-downloads .cc-view-switch { display: flex; gap: 3px; background: #e9eef8; border-radius: 11px; padding: 4px; }
#cc-downloads .cc-view-btn { border: none; display: grid; place-items: center; width: 37px; height: 34px; border-radius: 8px; color: #74869f; background: transparent; cursor: pointer; }
#cc-downloads .cc-view-btn.active { background: #fff; color: var(--cc-primary); box-shadow: 0 2px 9px rgba(27,46,80,.09); }
#cc-downloads .cc-query-banner { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 0 0 16px; padding: 13px 17px; background: #eaf1fe; border: 1px solid #dae7ff; border-radius: 12px; font-size: 13px; color: #29466f; }
#cc-downloads .cc-query-banner i { margin-right: 5px; }
#cc-downloads .cc-query-banner a { white-space: nowrap; color: var(--cc-primary); font-weight: 700; }
#cc-downloads .cc-panel { background: var(--cc-surface); border: 1px solid var(--cc-border); border-radius: 17px; box-shadow: var(--cc-shadow); overflow: hidden; }
#cc-downloads .cc-table-scroll { width: 100%; overflow-x: auto; }
#cc-downloads .cc-table { border-collapse: collapse; width: 100%; min-width: 690px; margin: 0; }
#cc-downloads .cc-table thead { background: #f9fbff; }
#cc-downloads .cc-table th { font-size: 11px; text-transform: uppercase; letter-spacing: .6px; text-align: left; color: #7d8ba0; font-weight: 750; padding: 18px 22px; border-bottom: 1px solid var(--cc-border); }
#cc-downloads .cc-table th:first-child { width: 48%; padding-left: 26px; }
#cc-downloads .cc-table th:nth-child(2) { width: 15%; }
#cc-downloads .cc-table th:nth-child(3) { width: 21%; }
