}
@media (max-width: 520px) {
    #cc-downloads .cc-hero { padding: 22px 16px; }
    #cc-downloads .cc-title-group h1 { font-size: 26px; }
    #cc-downloads .cc-title-group p { font-size: 12px; }
    #cc-downloads .cc-search { min-height: 52px; padding-left: 13px; margin-top: 23px; }
    #cc-downloads .cc-search-submit { padding: 0 14px; }
    #cc-downloads .cc-search-submit span { display: none; }
    #cc-downloads .cc-query-banner { flex-wrap: wrap; }
    #cc-downloads .cc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    #cc-downloads .cc-file-card { padding: 14px; }
    #cc-downloads .cc-card-icon { height: 52px; width: 52px; margin-bottom: 13px; }
    #cc-downloads .cc-card-icon img { height: 30px; width: 30px; }
    #cc-downloads .cc-card-name { font-size: 12px; }
    #cc-downloads .cc-card-action { font-size: 11px; }
}
@media (prefers-reduced-motion: reduce) {
    #cc-downloads .cc-file-card, #cc-downloads .cc-search-submit { transition: none; }
}

