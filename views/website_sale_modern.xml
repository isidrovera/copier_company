<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="copier_company_modern_products"
              name="Copier Company - Tienda moderna"
              inherit_id="website_sale.products"
              priority="90">

        <!-- Clase principal -->
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class"
                       add="cc-modern-shop"
                       separator=" "/>
        </xpath>

        <!-- Selector cuadrícula/lista -->
        <xpath expr="//div[contains(@class, 'products_header')]"
               position="inside">

            <div class="cc-view-switcher"
                 title="Cambiar presentación">

                <input type="radio"
                       name="cc_shop_view"
                       id="cc-view-grid"
                       class="cc-view-option"
                       checked="checked"/>

                <label for="cc-view-grid"
                       title="Vista cuadrícula">
                    <i class="fa fa-th-large"/>
                    <span>Cuadrícula</span>
                </label>

                <input type="radio"
                       name="cc_shop_view"
                       id="cc-view-list"
                       class="cc-view-option"/>

                <label for="cc-view-list"
                       title="Vista lista">
                    <i class="fa fa-list"/>
                    <span>Lista</span>
                </label>

            </div>

        </xpath>

        <!-- Estilos directos -->
        <xpath expr="//div[@id='wrap']" position="inside">

            <style type="text/css">

                /* =====================================================
                   CONFIGURACIÓN GENERAL
                   ===================================================== */

                .cc-modern-shop {
                    --cc-primary: #0a315a;
                    --cc-primary-hover: #125b9f;
                    --cc-accent: #f0b323;
                    --cc-text: #152033;
                    --cc-muted: #667085;
                    --cc-border: #e1e7ef;
                    --cc-background: #f4f7fb;
                    --cc-white: #ffffff;

                    min-height: 75vh;
                    padding-top: 76px;
                    padding-bottom: 40px;
                    color: var(--cc-text);
                    background: var(--cc-background);
                }

                .cc-modern-shop #o_wsale_container {
                    padding-top: 18px;
                    padding-bottom: 25px;
                }

                .cc-modern-shop .o_wsale_products_main_row {
                    gap: 20px;
                }

                /* =====================================================
                   FILTROS LATERALES
                   ===================================================== */

                .cc-modern-shop #products_grid_before:not(
                    :has(.products_categories)
                ):not(
                    :has(.products_attributes_filters *)
                ) {
                    display: none !important;
                }

                .cc-modern-shop #products_grid_before {
                    flex: 0 0 225px;
                    width: 225px;
                    padding-top: 0 !important;
                }

                .cc-modern-shop
                .o_wsale_products_grid_before_rail {
                    height: auto !important;
                    max-height: calc(100vh - 125px);
                    padding: 18px !important;
                    border: 1px solid var(--cc-border);
                    border-radius: 14px;
                    background: var(--cc-white);
                    box-shadow: 0 5px 20px rgba(18,38,63,0.05);
                    scrollbar-width: thin;
                }

                .cc-modern-shop
                .o_wsale_products_grid_before_rail::before {
                    display: block;
                    margin-bottom: 12px;
                    color: var(--cc-primary);
                    font-size: 12px;
                    font-weight: 800;
                    letter-spacing: 0.05em;
                    content: "CATEGORÍAS Y FILTROS";
                }

                .cc-modern-shop .products_categories {
                    font-size: 13px;
                }

                .cc-modern-shop .products_categories a {
                    display: block;
                    padding: 8px 10px;
                    border-radius: 8px;
                    color: #273244;
                    font-weight: 600;
                    transition:
                        color 0.2s ease,
                        background 0.2s ease;
                }

                .cc-modern-shop .products_categories a:hover {
                    color: var(--cc-primary-hover);
                    background: #eef5fd;
                }

                /* =====================================================
                   CABECERA DE LA TIENDA
                   ===================================================== */

                .cc-modern-shop #o_wsale_products_header {
                    margin-bottom: 18px;
                    padding: 16px 18px !important;
                    border: 1px solid var(--cc-border);
                    border-radius: 14px;
                    background: var(--cc-white);
                    box-shadow: 0 6px 22px rgba(18,38,63,0.05);
                }

                .cc-modern-shop .o_wsale_shop_title,
                .cc-modern-shop .o_wsale_category_title {
                    position: relative;
                    margin: 0 0 12px !important;
                    padding-left: 14px;
                    color: var(--cc-primary);
                    font-size: 23px !important;
                    font-weight: 800;
                    line-height: 1.2;
                    letter-spacing: -0.025em;
                }

                .cc-modern-shop .o_wsale_shop_title::before,
                .cc-modern-shop .o_wsale_category_title::before {
                    position: absolute;
                    top: 2px;
                    bottom: 2px;
                    left: 0;
                    width: 4px;
                    border-radius: 4px;
                    background: var(--cc-accent);
                    content: "";
                }

                .cc-modern-shop .products_header {
                    margin: 0;
                    gap: 9px !important;
                }

                /* =====================================================
                   BUSCADOR
                   ===================================================== */

                .cc-modern-shop
                .o_wsale_products_header_search_form_container {
                    width: 100%;
                    max-width: 390px;
                }

                .cc-modern-shop
                .products_header
                .input-group {
                    overflow: hidden;
                    min-height: 41px;
                    border: 1px solid #d9e1eb;
                    border-radius: 10px !important;
                    background: #f8fafc;
                    transition:
                        border-color 0.2s ease,
                        box-shadow 0.2s ease;
                }

                .cc-modern-shop
                .products_header
                .input-group:focus-within {
                    border-color: #85add4;
                    box-shadow: 0 0 0 3px rgba(18,91,159,0.10);
                }

                .cc-modern-shop
                .products_header
                input {
                    border: 0 !important;
                    background: transparent !important;
                    color: var(--cc-text);
                    font-size: 13px;
                    box-shadow: none !important;
                }

                .cc-modern-shop
                .products_header
                .oe_search_button {
                    width: 42px;
                    border: 0 !important;
                    color: var(--cc-primary) !important;
                    background: transparent !important;
                }

                /* =====================================================
                   SELECTOR DE MONEDA
                   ===================================================== */

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-toggle,
                .cc-modern-shop
                .o_sortby_dropdown
                .dropdown-toggle {
                    display: inline-flex;
                    min-height: 40px;
                    align-items: center;
                    gap: 7px;
                    padding: 7px 11px !important;
                    border: 1px solid #d9e1eb;
                    border-radius: 9px;
                    color: var(--cc-text);
                    background: var(--cc-white);
                    font-size: 12px;
                    font-weight: 700;
                    box-shadow: none;
                }

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-toggle:hover,
                .cc-modern-shop
                .o_sortby_dropdown
                .dropdown-toggle:hover {
                    border-color: #9db8d3;
                    color: var(--cc-primary-hover);
                    background: #f8fafc;
                }

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-toggle
                small {
                    display: none !important;
                }

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-toggle
                span.d-none.d-md-inline {
                    display: inline-flex !important;
                    align-items: center;
                    gap: 7px;
                    font-size: 0;
                }

                /* PEN seleccionado */

                .cc-modern-shop
                .o_pricelist_dropdown:has(
                    .dropdown-item.active
                    .switcher_pricelist[data-pl_id="1"]
                )
                .dropdown-toggle
                span.d-none.d-md-inline::before {
                    display: inline-block;
                    width: 21px;
                    height: 14px;
                    border: 1px solid #d7dce2;
                    border-radius: 2px;
                    background:
                        linear-gradient(
                            90deg,
                            #d91023 0%,
                            #d91023 33.33%,
                            #ffffff 33.33%,
                            #ffffff 66.66%,
                            #d91023 66.66%,
                            #d91023 100%
                        );
                    content: "";
                }

                .cc-modern-shop
                .o_pricelist_dropdown:has(
                    .dropdown-item.active
                    .switcher_pricelist[data-pl_id="1"]
                )
                .dropdown-toggle
                span.d-none.d-md-inline::after {
                    color: var(--cc-text);
                    font-size: 12px;
                    content: "Soles (PEN)";
                }

                /* USD seleccionado */

                .cc-modern-shop
                .o_pricelist_dropdown:has(
                    .dropdown-item.active
                    .switcher_pricelist[data-pl_id="2"]
                )
                .dropdown-toggle
                span.d-none.d-md-inline::before {
                    display: inline-block;
                    width: 21px;
                    height: 14px;
                    border: 1px solid #d7dce2;
                    border-radius: 2px;
                    background:
                        linear-gradient(
                            #3c3b6e,
                            #3c3b6e
                        ) 0 0 / 42% 54% no-repeat,
                        repeating-linear-gradient(
                            to bottom,
                            #b22234 0,
                            #b22234 7.69%,
                            #ffffff 7.69%,
                            #ffffff 15.38%
                        );
                    content: "";
                }

                .cc-modern-shop
                .o_pricelist_dropdown:has(
                    .dropdown-item.active
                    .switcher_pricelist[data-pl_id="2"]
                )
                .dropdown-toggle
                span.d-none.d-md-inline::after {
                    color: var(--cc-text);
                    font-size: 12px;
                    content: "Dólares (USD)";
                }

                /* Banderas dentro del menú */

                .cc-modern-shop .switcher_pricelist {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                }

                .cc-modern-shop
                .switcher_pricelist[data-pl_id="1"]::before {
                    display: inline-block;
                    width: 21px;
                    height: 14px;
                    border: 1px solid #d7dce2;
                    border-radius: 2px;
                    background:
                        linear-gradient(
                            90deg,
                            #d91023 0%,
                            #d91023 33.33%,
                            #ffffff 33.33%,
                            #ffffff 66.66%,
                            #d91023 66.66%,
                            #d91023 100%
                        );
                    content: "";
                }

                .cc-modern-shop
                .switcher_pricelist[data-pl_id="2"]::before {
                    display: inline-block;
                    width: 21px;
                    height: 14px;
                    border: 1px solid #d7dce2;
                    border-radius: 2px;
                    background:
                        linear-gradient(
                            #3c3b6e,
                            #3c3b6e
                        ) 0 0 / 42% 54% no-repeat,
                        repeating-linear-gradient(
                            to bottom,
                            #b22234 0,
                            #b22234 7.69%,
                            #ffffff 7.69%,
                            #ffffff 15.38%
                        );
                    content: "";
                }

                /* Menús desplegables */

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-menu,
                .cc-modern-shop
                .o_sortby_dropdown
                .dropdown-menu {
                    overflow: hidden;
                    min-width: 215px;
                    margin-top: 7px;
                    padding: 6px;
                    border: 1px solid #dfe5ec;
                    border-radius: 10px;
                    background: var(--cc-white);
                    box-shadow: 0 14px 32px rgba(16,36,64,0.14);
                }

                .cc-modern-shop
                .dropdown-menu
                .dropdown-item {
                    padding: 9px 11px;
                    border-radius: 7px;
                    color: var(--cc-text);
                    font-size: 12px;
                }

                .cc-modern-shop
                .dropdown-menu
                .dropdown-item:hover {
                    color: var(--cc-primary-hover);
                    background: #eef5fd;
                }

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-item.active {
                    color: var(--cc-white);
                    background: var(--cc-primary);
                }

                /* =====================================================
                   SELECTOR CUADRÍCULA / LISTA
                   ===================================================== */

                .cc-modern-shop .cc-view-switcher {
                    display: inline-flex;
                    overflow: hidden;
                    flex: 0 0 auto;
                    align-items: center;
                    margin-left: 1px;
                    padding: 3px;
                    border: 1px solid #d9e1eb;
                    border-radius: 10px;
                    background: #f5f7fa;
                }

                .cc-modern-shop .cc-view-option {
                    position: absolute;
                    width: 1px;
                    height: 1px;
                    opacity: 0;
                    pointer-events: none;
                }

                .cc-modern-shop
                .cc-view-switcher label {
                    display: inline-flex;
                    min-height: 32px;
                    align-items: center;
                    justify-content: center;
                    gap: 6px;
                    margin: 0;
                    padding: 6px 10px;
                    border-radius: 7px;
                    color: var(--cc-muted);
                    font-size: 11px;
                    font-weight: 700;
                    cursor: pointer;
                    transition:
                        color 0.2s ease,
                        background 0.2s ease,
                        box-shadow 0.2s ease;
                }

                .cc-modern-shop
                .cc-view-switcher label:hover {
                    color: var(--cc-primary);
                }

                .cc-modern-shop
                .cc-view-option:checked + label {
                    color: var(--cc-white);
                    background: var(--cc-primary);
                    box-shadow: 0 3px 8px rgba(10,49,90,0.18);
                }

                /* =====================================================
                   VISTA CUADRÍCULA
                   ===================================================== */

                .cc-modern-shop #o_wsale_products_grid {
                    display: grid !important;
                    grid-template-columns:
                        repeat(4, minmax(0, 1fr)) !important;
                    grid-auto-flow: row !important;
                    grid-auto-rows: auto !important;
                    align-items: stretch !important;
                    gap: 16px !important;

                    --o-wsale-card-flex-direction: column !important;
                    --o-wsale-card-info-flex-direction: column !important;
                    --o-wsale-card-thumb-aspect-ratio: auto !important;
                    --o-wsale-card-height: auto !important;
                }

                .cc-modern-shop
                #o_wsale_products_grid
                .oe_product,
                .cc-modern-shop
                #o_wsale_products_grid
                .oe_product:nth-child(n) {
                    grid-column: auto !important;
                    grid-row: auto !important;
                    width: 100% !important;
                    height: 378px !important;
                    min-height: 378px !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    align-self: stretch !important;
                }

                /* Tarjeta de la cuadrícula */

                .cc-modern-shop
                .o_wsale_product_grid_wrapper {
                    display: block !important;
                    overflow: hidden !important;
                    position: relative !important;
                    width: 100% !important;
                    height: 378px !important;
                    min-height: 378px !important;
                    border: 1px solid var(--cc-border) !important;
                    border-radius: 15px !important;
                    background: var(--cc-white) !important;
                    box-shadow: 0 6px 20px rgba(18,38,63,0.06);
                    transition:
                        transform 0.22s ease,
                        border-color 0.22s ease,
                        box-shadow 0.22s ease;
                }

                .cc-modern-shop
                .o_wsale_product_grid_wrapper:hover {
                    border-color: #a9c4df !important;
                    box-shadow: 0 15px 34px rgba(16,50,95,0.13);
                    transform: translateY(-3px);
                }

                .cc-modern-shop .oe_product_cart {
                    display: flex !important;
                    position: relative !important;
                    width: 100% !important;
                    height: 100% !important;
                    min-height: 0 !important;
                    flex-direction: column !important;
                    align-items: stretch !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    background: var(--cc-white) !important;
                }

                /* Imagen de la cuadrícula */

                .cc-modern-shop .oe_product_image {
                    display: flex !important;
                    overflow: hidden !important;
                    position: relative !important;
                    flex: 0 0 175px !important;
                    width: 100% !important;
                    min-width: 100% !important;
                    height: 175px !important;
                    min-height: 175px !important;
                    align-items: center !important;
                    justify-content: center !important;
                    border: 0 !important;
                    border-bottom: 1px solid #edf0f4 !important;
                    background:
                        linear-gradient(
                            145deg,
                            #fafbfd,
                            #f0f3f7
                        ) !important;
                }

                .cc-modern-shop .oe_product_image_link {
                    display: flex !important;
                    overflow: hidden !important;
                    position: relative !important;
                    width: 100% !important;
                    height: 175px !important;
                    min-height: 175px !important;
                    align-items: center !important;
                    justify-content: center !important;
                    aspect-ratio: auto !important;
                    background: transparent !important;
                }

                .cc-modern-shop
                .oe_product_image_img_wrapper {
                    display: flex !important;
                    overflow: hidden !important;
                    position: static !important;
                    width: 100% !important;
                    height: 100% !important;
                    min-height: 0 !important;
                    align-items: center !important;
                    justify-content: center !important;
                    inset: auto !important;
                    transform: none !important;
                }

                .cc-modern-shop .oe_product_image_img {
                    display: block !important;
                    position: static !important;
                    width: auto !important;
                    height: auto !important;
                    max-width: calc(100% - 20px) !important;
                    max-height: calc(100% - 20px) !important;
                    margin: auto !important;
                    padding: 0 !important;
                    object-fit: contain !important;
                    object-position: center center !important;
                    transform: none !important;
                }

                .cc-modern-shop
                .oe_product_image_img_wrapper_secondary {
                    display: none !important;
                }

                /* Información de la cuadrícula */

                .cc-modern-shop
                .o_wsale_product_information {
                    display: flex !important;
                    position: static !important;
                    flex: 1 1 auto !important;
                    width: 100% !important;
                    min-height: 0 !important;
                    flex-direction: column !important;
                    align-items: stretch !important;
                    margin: 0 !important;
                    padding: 13px !important;
                    background: var(--cc-white) !important;
                }

                .cc-modern-shop
                .o_wsale_product_information_text {
                    width: 100% !important;
                    margin: 0 !important;
                    padding: 0 !important;
                }

                .cc-modern-shop
                .o_wsale_product_information_text::before {
                    display: block;
                    width: 34px;
                    height: 3px;
                    margin-bottom: 8px;
                    border-radius: 3px;
                    background: var(--cc-accent);
                    content: "";
                }

                .cc-modern-shop
                .o_wsale_products_item_title {
                    min-height: 38px !important;
                    margin: 0 !important;
                    color: var(--cc-text);
                    font-size: 14px !important;
                    font-weight: 700 !important;
                    line-height: 1.35 !important;
                }

                .cc-modern-shop
                .o_wsale_products_item_title a {
                    display: -webkit-box !important;
                    overflow: hidden !important;
                    color: var(--cc-text) !important;
                    text-decoration: none !important;
                    -webkit-box-orient: vertical;
                    -webkit-line-clamp: 2;
                }

                .cc-modern-shop
                .o_wsale_products_item_title a:hover {
                    color: var(--cc-primary-hover) !important;
                }

                .cc-modern-shop
                .oe_subdescription_wrapper {
                    display: none !important;
                }

                /* Precio y botón de la cuadrícula */

                .cc-modern-shop .o_wsale_product_sub {
                    display: flex !important;
                    position: static !important;
                    width: 100% !important;
                    flex: 1 1 auto !important;
                    flex-direction: column !important;
                    align-items: stretch !important;
                    justify-content: flex-end !important;
                    gap: 9px !important;
                    margin: 0 !important;
                    padding: 9px 0 0 !important;
                    border: 0 !important;
                    border-top: 1px solid #edf0f4 !important;
                }

                .cc-modern-shop .product_price {
                    display: flex !important;
                    width: 100% !important;
                    min-width: 0 !important;
                    align-items: center !important;
                    justify-content: flex-start !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    color: var(--cc-primary) !important;
                    font-size: 17px !important;
                    font-weight: 800 !important;
                    line-height: 1.2 !important;
                    white-space: nowrap !important;
                }

                .cc-modern-shop .product_price span,
                .cc-modern-shop .product_price del {
                    display: inline-block !important;
                    margin: 0 !important;
                    text-align: left !important;
                }

                .cc-modern-shop .product_price::before,
                .cc-modern-shop
                .o_wsale_product_btn::before {
                    display: none !important;
                }

                .cc-modern-shop .o_wsale_product_btn,
                .cc-modern-shop
                .o_wsale_product_action_row {
                    display: flex !important;
                    width: 100% !important;
                    margin: 0 !important;
                    padding: 0 !important;
                }

                .cc-modern-shop
                .o_wsale_product_btn_primary {
                    display: inline-flex !important;
                    width: 100% !important;
                    min-height: 38px !important;
                    align-items: center !important;
                    justify-content: center !important;
                    margin: 0 !important;
                    padding: 8px 11px !important;
                    border: 0 !important;
                    border-radius: 9px !important;
                    color: var(--cc-white) !important;
                    background: var(--cc-primary) !important;
                    font-size: 12px !important;
                    font-weight: 700 !important;
                    line-height: 1.2 !important;
                    box-shadow: none !important;
                }

                .cc-modern-shop
                .o_wsale_product_btn_primary
                .o_label {
                    display: inline !important;
                    margin-left: 6px !important;
                    font-size: 12px !important;
                }

                .cc-modern-shop
                .o_wsale_product_btn_primary:hover {
                    color: var(--cc-white) !important;
                    background: var(--cc-primary-hover) !important;
                }

                /* =====================================================
                   VISTA LISTA
                   ===================================================== */

                @media (min-width: 768px) {

                    .cc-modern-shop
                    #products_grid:has(#cc-view-list:checked)
                    #o_wsale_products_grid {
                        display: flex !important;
                        flex-direction: column !important;
                        gap: 12px !important;
                    }

                    .cc-modern-shop
                    #products_grid:has(#cc-view-list:checked)
                    #o_wsale_products_grid
                    .oe_product,
                    .cc-modern-shop
                    #products_grid:has(#cc-view-list:checked)
                    #o_wsale_products_grid
                    .oe_product:nth-child(n) {
                        display: block !important;
                        width: 100% !important;
                        height: 165px !important;
                        min-height: 165px !important;
                        margin: 0 !important;
                    }

                    .cc-modern-shop
                    #products_grid:has(#cc-view-list:checked)
                    .o_wsale_product_grid_wrapper {
                        width: 100% !important;
                        height: 165px !important;
                        min-height: 165px !important;
                        border-radius: 13px !important;
                    }

                    .cc-modern-shop
                    #products_grid:has(#cc-view-list:checked)
                    .oe_product_cart {
                        display: flex !important;
                        width: 100% !important;
                        height: 100% !important;
                        flex-direction: row !important;
                        align-items: stretch !important;
                    }

                    /* Imagen de lista */

                    .cc-modern-shop
                    #products_grid:has(#cc-view-list:checked)
                    .oe_product_image {
                        flex: 0 0 210px !important;
                        width: 210px !important;
                        min-width: 210px !important;
                        height: 100% !important;
                        min-height: 100% !important;
                        border-right: 1px solid #edf0f4 !important;
                        border-bottom: 0 !important;
                    }

                    .cc-modern-shop
                    #products_grid:has(#cc-view-list:checked)
                    .oe_product_image_link {
                        width: 210px !important;
                        height: 100% !important;
                        min-height: 100% !important;
                    }

                    .cc-modern-shop
                    #products_grid:has(#cc-view-list:checked)
                    .oe_product_image_img {
                        max-width: calc(100% - 18px) !important;
                        max-height: calc(100% - 18px) !important;
                    }

                    /* Información de lista */

                    .cc-modern-shop
                    #products_grid:has(#cc-view-list:checked)
                    .o_wsale_product_information {
