<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="copier_company_modern_products"
              name="Copier Company - Catálogo mosaico"
              inherit_id="website_sale.products"
              priority="90">

        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class"
                       add="cc-mosaic-shop"
                       separator=" "/>
        </xpath>

        <xpath expr="//div[@id='wrap']" position="inside">

            <style type="text/css">

                /* =====================================================
                   PÁGINA GENERAL
                   ===================================================== */

                .cc-mosaic-shop {
                    min-height: 70vh;
                    padding-bottom: 35px;
                    color: #172033;
                    background: #f5f6f8;
                }

                .cc-mosaic-shop #o_wsale_container {
                    padding-top: 18px;
                    padding-bottom: 30px;
                }

                .cc-mosaic-shop .o_wsale_products_main_row {
                    gap: 18px;
                }

                /* Ocultar lateral vacío */

                .cc-mosaic-shop #products_grid_before:not(
                    :has(.products_categories)
                ):not(
                    :has(.products_attributes_filters &gt; *)
                ) {
                    display: none !important;
                }

                /* =====================================================
                   FILTROS LATERALES
                   ===================================================== */

                .cc-mosaic-shop #products_grid_before {
                    flex: 0 0 210px;
                    width: 210px;
                    padding-top: 0 !important;
                }

                .cc-mosaic-shop
                .o_wsale_products_grid_before_rail {
                    height: auto !important;
                    max-height: calc(100vh - 110px);
                    padding: 18px !important;
                    border: 1px solid #e5e7eb;
                    border-radius: 4px;
                    background: #ffffff;
                    box-shadow: none;
                }

                .cc-mosaic-shop .products_categories a {
                    display: block;
                    padding: 8px 10px;
                    border-radius: 3px;
                    color: #252b35;
                    font-size: 12px;
                    font-weight: 600;
                    text-transform: uppercase;
                }

                .cc-mosaic-shop .products_categories a:hover {
                    color: #0b335d;
                    background: #f3f5f7;
                }

                /* =====================================================
                   CABECERA COMPACTA
                   ===================================================== */

                .cc-mosaic-shop #o_wsale_products_header {
                    margin-bottom: 14px;
                    padding: 13px 16px !important;
                    border: 0;
                    border-radius: 4px;
                    background: #ffffff;
                    box-shadow: none;
                }

                .cc-mosaic-shop .o_wsale_shop_title,
                .cc-mosaic-shop .o_wsale_category_title {
                    margin: 0 0 8px !important;
                    color: #111827;
                    font-size: 20px !important;
                    font-weight: 700;
                    letter-spacing: -0.02em;
                }

                .cc-mosaic-shop .products_header {
                    margin: 0;
                    gap: 10px !important;
                }

                .cc-mosaic-shop
                .o_wsale_products_header_search_form_container {
                    max-width: 330px;
                }

                .cc-mosaic-shop
                .products_header
                .input-group {
                    overflow: hidden;
                    min-height: 39px;
                    border: 1px solid #dfe3e8;
                    border-radius: 3px !important;
                    background: #ffffff;
                }

                .cc-mosaic-shop
                .products_header
                input {
                    border: 0 !important;
                    background: transparent !important;
                    font-size: 13px;
                    box-shadow: none !important;
                }

                .cc-mosaic-shop
                .products_header
                .oe_search_button {
                    border: 0 !important;
                    background: transparent !important;
                    color: #111827 !important;
                }

                /* =====================================================
                   MONEDA
                   ===================================================== */

                .cc-mosaic-shop
                .o_pricelist_dropdown
                .dropdown-toggle,
                .cc-mosaic-shop
                .o_sortby_dropdown
                .dropdown-toggle {
                    display: inline-flex;
                    min-height: 38px;
                    align-items: center;
                    padding: 7px 11px !important;
                    border: 1px solid #dfe3e8;
                    border-radius: 3px;
                    color: #222831;
                    background: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                }

                .cc-mosaic-shop
                .o_pricelist_dropdown
                .dropdown-toggle
                small {
                    display: none !important;
                }

                .cc-mosaic-shop
                .o_pricelist_dropdown
                .dropdown-toggle
                &gt; span.d-none.d-md-inline {
                    font-size: 0;
                }

                .cc-mosaic-shop
                .o_pricelist_dropdown:has(
                    .dropdown-item.active
                    .switcher_pricelist[data-pl_id="1"]
                )
                .dropdown-toggle
                &gt; span.d-none.d-md-inline::after {
                    content: "🇵🇪  PEN";
                    font-size: 12px;
                }

                .cc-mosaic-shop
                .o_pricelist_dropdown:has(
                    .dropdown-item.active
                    .switcher_pricelist[data-pl_id="2"]
                )
                .dropdown-toggle
                &gt; span.d-none.d-md-inline::after {
                    content: "🇺🇸  USD";
                    font-size: 12px;
                }

                .cc-mosaic-shop
                .switcher_pricelist[data-pl_id="1"]::before {
                    margin-right: 7px;
                    content: "🇵🇪";
                }

                .cc-mosaic-shop
                .switcher_pricelist[data-pl_id="2"]::before {
                    margin-right: 7px;
                    content: "🇺🇸";
                }

                .cc-mosaic-shop
                .o_pricelist_dropdown
                .dropdown-menu,
                .cc-mosaic-shop
                .o_sortby_dropdown
                .dropdown-menu {
                    padding: 5px;
                    border: 1px solid #e1e4e8;
                    border-radius: 4px;
                    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
                }

                .cc-mosaic-shop
                .dropdown-menu
                .dropdown-item {
                    padding: 8px 10px;
                    border-radius: 2px;
                    font-size: 12px;
                }

                .cc-mosaic-shop
                .o_pricelist_dropdown
                .dropdown-item.active {
                    color: #ffffff;
                    background: #0b335d;
                }

                /* =====================================================
                   MOSAICO
                   ===================================================== */

                .cc-mosaic-shop #o_wsale_products_grid {
                    display: grid !important;
                    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
                    grid-auto-flow: dense !important;
                    grid-auto-rows: 1px !important;
                    column-gap: 12px !important;
                    row-gap: 0 !important;
                }

                .cc-mosaic-shop
                #o_wsale_products_grid
                .oe_product {
                    grid-column: auto !important;
                    grid-row: span 310 !important;
                    min-width: 0 !important;
                    height: 310px !important;
                    padding-bottom: 12px;
                }

                .cc-mosaic-shop
                #o_wsale_products_grid
                .oe_product:nth-child(6n + 2) {
                    grid-row: span 385 !important;
                    height: 385px !important;
                }

                .cc-mosaic-shop
                #o_wsale_products_grid
                .oe_product:nth-child(6n + 3) {
                    grid-row: span 335 !important;
                    height: 335px !important;
                }

                .cc-mosaic-shop
                #o_wsale_products_grid
                .oe_product:nth-child(6n + 4) {
                    grid-row: span 365 !important;
                    height: 365px !important;
                }

                .cc-mosaic-shop
                #o_wsale_products_grid
                .oe_product:nth-child(6n + 5) {
                    grid-row: span 300 !important;
                    height: 300px !important;
                }

                .cc-mosaic-shop
                #o_wsale_products_grid
                .oe_product:nth-child(6n + 6) {
                    grid-row: span 350 !important;
                    height: 350px !important;
                }

                /* =====================================================
                   PRODUCTO COMO BLOQUE DE IMAGEN
                   ===================================================== */

                .cc-mosaic-shop
                .o_wsale_product_grid_wrapper {
                    overflow: hidden;
                    position: relative;
                    width: 100%;
                    height: calc(100% - 12px) !important;
                    min-height: 0 !important;
                    border: 0 !important;
                    border-radius: 2px !important;
                    background: #ffffff !important;
                    box-shadow: none !important;
                    transition:
                        transform 0.25s ease,
                        box-shadow 0.25s ease;
                }

                .cc-mosaic-shop
                .o_wsale_product_grid_wrapper:hover {
                    z-index: 3;
                    box-shadow: 0 15px 32px rgba(0,0,0,0.15) !important;
                    transform: translateY(-3px);
                }

                .cc-mosaic-shop .oe_product_cart {
                    display: block !important;
                    position: relative !important;
                    width: 100% !important;
                    height: 100% !important;
                    min-height: 0 !important;
                    background: #ffffff !important;
                }

                /* =====================================================
                   IMAGEN COMPLETA Y CENTRADA
                   ===================================================== */

                .cc-mosaic-shop .oe_product_image,
                .cc-mosaic-shop .oe_product_image_link,
                .cc-mosaic-shop
                .oe_product_image_img_wrapper {
                    display: flex !important;
                    overflow: hidden !important;
                    position: absolute !important;
                    inset: 0 !important;
                    width: 100% !important;
                    height: 100% !important;
                    min-width: 0 !important;
                    min-height: 0 !important;
                    align-items: center !important;
                    justify-content: center !important;
                    aspect-ratio: auto !important;
                    background: #f1f2f3 !important;
                    transform: none !important;
                }

                .cc-mosaic-shop .oe_product_image_img {
                    display: block !important;
                    position: static !important;
                    width: auto !important;
                    height: auto !important;
                    max-width: 100% !important;
                    max-height: 100% !important;
                    margin: auto !important;
                    padding: 0 !important;
                    object-fit: contain !important;
                    object-position: center center !important;
                    transform: none !important;
                }

                .cc-mosaic-shop
                .oe_product_image_img_wrapper_secondary {
                    display: none !important;
                }

                /* =====================================================
                   INFORMACIÓN SUPERPUESTA
                   ===================================================== */

                .cc-mosaic-shop
                .o_wsale_product_information {
                    display: flex !important;
                    position: absolute !important;
                    z-index: 5;
                    right: 0;
                    bottom: 0;
                    left: 0;
                    width: 100% !important;
                    min-height: 105px !important;
                    flex-direction: column !important;
                    justify-content: flex-end !important;
                    margin: 0 !important;
                    padding: 42px 16px 14px !important;
                    background:
                        linear-gradient(
                            to bottom,
                            rgba(255,255,255,0),
                            rgba(255,255,255,0.90) 34%,
                            #ffffff 70%
                        ) !important;
                }

                .cc-mosaic-shop
                .o_wsale_product_information_text {
                    width: 100% !important;
                    padding: 0 !important;
                }

                .cc-mosaic-shop
                .o_wsale_product_information_text::before {
                    display: block;
                    width: 40px;
                    height: 2px;
                    margin-bottom: 7px;
                    background: #f0b323;
                    content: "";
                }

                .cc-mosaic-shop
                .o_wsale_products_item_title {
                    min-height: 0 !important;
                    margin: 0 0 5px !important;
                    font-size: 14px !important;
                    font-weight: 700;
                    line-height: 1.25;
                }

                .cc-mosaic-shop
                .o_wsale_products_item_title a {
                    display: -webkit-box;
                    overflow: hidden;
                    color: #15191f !important;
                    -webkit-box-orient: vertical;
                    -webkit-line-clamp: 2;
                }

                .cc-mosaic-shop
                .oe_subdescription_wrapper {
                    display: none !important;
                }

                /* PRECIO Y CARRITO */

                .cc-mosaic-shop .o_wsale_product_sub {
                    display: flex !important;
                    width: 100% !important;
                    align-items: center !important;
                    justify-content: space-between !important;
                    flex-wrap: nowrap !important;
                    gap: 8px !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    border: 0 !important;
                }

                .cc-mosaic-shop .product_price {
                    min-width: 0 !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    color: #0b335d !important;
                    font-size: 13px !important;
                    font-weight: 800 !important;
                }

                .cc-mosaic-shop .product_price::before,
                .cc-mosaic-shop
                .o_wsale_product_btn::before {
                    display: none !important;
                }

                .cc-mosaic-shop .o_wsale_product_btn {
                    width: auto !important;
                    margin: 0 0 0 auto !important;
                    padding: 0 !important;
                }

                .cc-mosaic-shop
                .o_wsale_product_btn
                .btn {
                    overflow: hidden;
                    width: 34px !important;
                    min-width: 34px !important;
                    height: 34px !important;
                    min-height: 34px !important;
                    padding: 0 !important;
                    border: 0 !important;
                    border-radius: 50% !important;
                    color: #ffffff !important;
                    background: #0b335d !important;
                    font-size: 0 !important;
                    line-height: 34px !important;
                    text-align: center;
                }

                .cc-mosaic-shop
                .o_wsale_product_btn
                .btn i {
                    margin: 0 !important;
                    font-size: 12px !important;
                    line-height: 34px !important;
                }

                .cc-mosaic-shop
                .o_wsale_product_btn
                .btn:hover {
                    background: #f0b323 !important;
                }

                /* =====================================================
                   RESPONSIVE
                   ===================================================== */

                @media (max-width: 1199.98px) {
                    .cc-mosaic-shop #o_wsale_products_grid {
                        grid-template-columns:
                            repeat(3, minmax(0, 1fr)) !important;
                    }
                }

                @media (max-width: 767.98px) {
                    .cc-mosaic-shop #o_wsale_products_grid {
                        grid-template-columns:
                            repeat(2, minmax(0, 1fr)) !important;
                    }

                    .cc-mosaic-shop .products_header {
                        flex-wrap: wrap !important;
                    }

                    .cc-mosaic-shop
                    .o_wsale_products_header_search_form_container {
                        width: 100%;
                        max-width: none;
                    }
                }

                @media (max-width: 575.98px) {
                    .cc-mosaic-shop #o_wsale_container {
                        padding-top: 10px;
                    }

                    .cc-mosaic-shop #o_wsale_products_header {
                        padding: 12px !important;
                    }

                    .cc-mosaic-shop #o_wsale_products_grid {
                        grid-template-columns:
                            minmax(0, 1fr) !important;
                    }

                    .cc-mosaic-shop
                    #o_wsale_products_grid
                    .oe_product,
                    .cc-mosaic-shop
                    #o_wsale_products_grid
                    .oe_product:nth-child(n) {
                        grid-row: span 330 !important;
                        height: 330px !important;
                    }
                }

            </style>

        </xpath>

    </template>

</odoo>