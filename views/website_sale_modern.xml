<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="copier_company_modern_products"
              name="Copier Company - Tienda moderna"
              inherit_id="website_sale.products"
              priority="90">

        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class"
                       add="cc-modern-shop"
                       separator=" "/>
        </xpath>

        <xpath expr="//div[@id='oe_structure_website_sale_products_1']"
               position="after">

            <section t-if="not category and not search"
                     class="cc-shop-hero">

                <div class="container">
                    <div class="cc-shop-hero-content">

                        <div class="cc-shop-hero-copy">

                            <span class="cc-shop-eyebrow">
                                CATÁLOGO COPIER COMPANY
                            </span>

                            <h1>
                                Soluciones de impresión
                                <span>para tu empresa</span>
                            </h1>

                            <p>
                                Equipos, repuestos, consumibles, firmware y
                                servicios especializados con asesoría técnica.
                            </p>

                            <div class="cc-shop-benefits">

                                <span>
                                    <i class="fa fa-check-circle"/>
                                    Compra segura
                                </span>

                                <span>
                                    <i class="fa fa-headphones"/>
                                    Asesoría especializada
                                </span>

                                <span>
                                    <i class="fa fa-shield"/>
                                    Soporte técnico
                                </span>

                            </div>
                        </div>

                        <div class="cc-shop-hero-icon"
                             aria-hidden="true">
                            <i class="fa fa-print"/>
                        </div>

                    </div>
                </div>
            </section>

        </xpath>

    </template>

</odoo>