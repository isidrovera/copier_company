<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="copier_company_modern_products"
              name="Copier Company - Tienda compacta"
              inherit_id="website_sale.products"
              priority="90">

        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class"
                       add="cc-modern-shop"
                       separator=" "/>
        </xpath>

        <xpath expr="//div[@id='wrap']" position="inside">

            <style type="text/css">

                /* =====================================================
                   ESTRUCTURA GENERAL
                   ===================================================== */

                .cc-modern-shop {
                    min-height: 70vh;
                    padding-bottom: 35px;
                    color: #172033;
                    background: #f3f6fa;
                }

                .cc-modern-shop #o_wsale_container {
                    padding-top: 22px;
                    padding-bottom: 25px;
                }

                .cc-modern-shop .o_wsale_products_main_row {
                    gap: 20px;
                }

                /*
                 * Ocultar la columna izquierda cuando no tiene
                 * categorías ni filtros reales.
                 */
                .cc-modern-shop #products_grid_before:not(
                    :has(.products_categories)
                ):not(
                    :has(.products_attributes_filters &gt; *)
                ) {
                    display: none !important;
                }

                /* =====================================================
                   FILTROS LATERALES
                   ===================================================== */

                .cc-modern-shop #products_grid_before {
                    flex: 0 0 225px;
                    width: 225px;
                    padding-top: 0 !important;
                }

                .cc-modern-shop
                .o_wsale_products_grid_before_rail {
                    height: auto !important;
                    max-height: calc(100vh - 120px);
                    padding: 17px !important;
                    border: 1px solid #e1e7ef;
                    border-radius: 14px;
                    background: #ffffff;
                    box-shadow: 0 5px 18px rgba(18,38,63,0.05);
                    scrollbar-width: thin;
                }

                .cc-modern-shop .products_categories {
                    font-size: 13px;
                }

                .cc-modern-shop .products_categories a {
                    border-radius: 8px;
                    color: #263244;
                    font-weight: 500;
                }

                .cc-modern-shop .products_categories a:hover {
                    color: #1769e0;
                    background: #edf5ff;
                }

                /* =====================================================
                   CABECERA COMPACTA
                   ===================================================== */

                .cc-modern-shop #o_wsale_products_header {
                    margin-bottom: 18px;
                    padding: 15px 18px !important;
                    border: 1px solid #e1e7ef;
                    border-radius: 14px;
                    background: #ffffff;
                    box-shadow: 0 5px 18px rgba(18,38,63,0.05);
                }

                .cc-modern-shop .o_wsale_shop_title,
                .cc-modern-shop .o_wsale_category_title {
                    margin: 0 0 10px !important;
                    color: #0b1f3a;
                    font-size: 22px !important;
                    font-weight: 800;
                    letter-spacing: -0.02em;
                }

                .cc-modern-shop .products_header {
                    margin-top: 0;
                    gap: 10px !important;
                }

                .cc-modern-shop
                .o_wsale_products_header_search_form_container {
                    max-width: 390px;
                }

                .cc-modern-shop
                .products_header
                .input-group {
                    overflow: hidden;
                    min-height: 42px;
                    border: 1px solid #d8e0eb;
                    border-radius: 10px !important;
                    background: #f8fafc;
                    box-shadow: none;
                }

                .cc-modern-shop
                .products_header
                input {
                    border: 0 !important;
                    background: transparent !important;
                    font-size: 14px;
                    box-shadow: none !important;
                }

                .cc-modern-shop
                .products_header
                .oe_search_button {
                    border: 0 !important;
                    background: transparent !important;
                    color: #0b1f3a !important;
                }

                /* =====================================================
                   MONEDA CON BANDERAS
                   ===================================================== */

                .cc-modern-shop .o_pricelist_dropdown {
                    position: relative;
                }

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-toggle {
                    display: inline-flex;
                    min-height: 40px;
                    align-items: center;
                    padding: 7px 12px !important;
                    border: 1px solid #d8e0eb;
                    border-radius: 10px;
                    color: #172033;
                    background: #ffffff;
                    font-size: 13px;
                    font-weight: 700;
                }

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-toggle
                small {
                    display: none !important;
                }

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-toggle
                &gt; span.d-none.d-md-inline {
                    font-size: 0;
                }

                /*
                 * Lista activa PEN.
                 */
                .cc-modern-shop
                .o_pricelist_dropdown:has(
                    .dropdown-item.active
                    .switcher_pricelist[data-pl_id="1"]
                )
                .dropdown-toggle
                &gt; span.d-none.d-md-inline::after {
                    content: "🇵🇪  PEN";
                    font-size: 13px;
                }

                /*
                 * Lista activa USD.
                 */
                .cc-modern-shop
                .o_pricelist_dropdown:has(
                    .dropdown-item.active
                    .switcher_pricelist[data-pl_id="2"]
                )
                .dropdown-toggle
                &gt; span.d-none.d-md-inline::after {
                    content: "🇺🇸  USD";
                    font-size: 13px;
                }

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-menu {
                    overflow: hidden;
                    min-width: 205px;
                    margin-top: 7px;
                    padding: 6px;
                    border: 1px solid #dfe5ed;
                    border-radius: 11px;
                    box-shadow: 0 12px 30px rgba(16,36,64,0.15);
                }

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-item {
                    padding: 9px 11px;
                    border-radius: 7px;
                    font-size: 13px;
                }

                .cc-modern-shop
                .switcher_pricelist[data-pl_id="1"]::before {
                    margin-right: 8px;
                    content: "🇵🇪";
                }

                .cc-modern-shop
                .switcher_pricelist[data-pl_id="2"]::before {
                    margin-right: 8px;
                    content: "🇺🇸";
                }

                .cc-modern-shop
                .o_pricelist_dropdown
                .dropdown-item.active {
                    color: #ffffff;
                    background: #0b335d;
                }

                /* =====================================================
                   ORDENAMIENTO
                   ===================================================== */

                .cc-modern-shop
                .o_sortby_dropdown
                .dropdown-toggle {
                    display: inline-flex;
                    min-height: 40px;
                    align-items: center;
                    padding: 7px 12px !important;
                    border: 1px solid #d8e0eb;
                    border-radius: 10px;
                    color: #172033;
                    background: #ffffff;
                    font-size: 13px;
                }

                .cc-modern-shop
                .o_sortby_dropdown
                .dropdown-menu {
                    padding: 6px;
                    border: 1px solid #dfe5ed;
                    border-radius: 10px;
                    box-shadow: 0 12px 30px rgba(16,36,64,0.14);
                }

                .cc-modern-shop
                .o_sortby_dropdown
                .dropdown-item {
                    padding: 8px 11px;
                    border-radius: 7px;
                    font-size: 13px;
                }

                /* =====================================================
                   CUADRÍCULA: 4 PRODUCTOS
                   ===================================================== */

                .cc-modern-shop #o_wsale_products_grid {
                    --o-wsale-products-grid-gap: 16px !important;
                    --o-wsale-card-thumb-aspect-ratio: auto !important;
                    --o-wsale-card-height: auto !important;
                }

                .cc-modern-shop
                #o_wsale_products_grid
                .oe_product {
                    grid-column: span 3 !important;
                    grid-row: span 1 !important;
                    min-height: 0 !important;
                    align-self: start !important;
                }

                /* =====================================================
                   TARJETAS COMPACTAS
                   ===================================================== */

                .cc-modern-shop
                .o_wsale_product_grid_wrapper {
                    overflow: hidden;
                    height: auto !important;
                    min-height: 0 !important;
                    border: 1px solid #e0e6ee;
                    border-radius: 14px !important;
                    background: #ffffff !important;
                    box-shadow: 0 5px 17px rgba(18,38,63,0.06);
                    transition:
                        transform 0.22s ease,
                        box-shadow 0.22s ease,
                        border-color 0.22s ease;
                }

                .cc-modern-shop
                .o_wsale_product_grid_wrapper:hover {
                    border-color: #abcbed;
                    box-shadow: 0 13px 28px rgba(16,50,95,0.12);
                    transform: translateY(-3px);
                }

                .cc-modern-shop .oe_product_cart {
                    display: flex !important;
                    flex-direction: column !important;
                    height: auto !important;
                    min-height: 0 !important;
                    align-items: stretch !important;
                    background: #ffffff !important;
                }

                /* IMAGEN MÁS PEQUEÑA */

                .cc-modern-shop .oe_product_image {
                    width: 100% !important;
                    min-width: 100% !important;
                    height: 135px !important;
                    min-height: 135px !important;
                    border-bottom: 1px solid #edf0f5;
                    background: #f7f9fc;
                }

                .cc-modern-shop .oe_product_image_link,
                .cc-modern-shop
                .oe_product_image_img_wrapper {
                    display: flex !important;
                    width: 100% !important;
                    height: 135px !important;
                    min-height: 0 !important;
                    aspect-ratio: auto !important;
                    align-items: center;
                    justify-content: center;
                }

                .cc-modern-shop .oe_product_image_img {
                    width: 100% !important;
                    height: 100% !important;
                    padding: 10px !important;
                    object-fit: contain !important;
                    transition: transform 0.25s ease;
                }

                .cc-modern-shop
                .o_wsale_product_grid_wrapper:hover
                .oe_product_image_img {
                    transform: scale(1.025);
                }

                /* INFORMACIÓN */

                .cc-modern-shop
                .o_wsale_product_information {
                    display: flex !important;
                    flex: 0 0 auto !important;
                    flex-direction: column !important;
                    width: 100% !important;
                    min-height: 135px !important;
                    margin: 0 !important;
                    padding: 12px !important;
                    gap: 0 !important;
                }

                .cc-modern-shop
                .o_wsale_product_information_text {
                    width: 100% !important;
                    padding: 0 !important;
                }

                .cc-modern-shop
                .o_wsale_products_item_title {
                    min-height: 39px !important;
                    margin: 0 0 7px !important;
                    font-size: 14px !important;
                    font-weight: 700;
                    line-height: 1.35;
                }

                .cc-modern-shop
                .o_wsale_products_item_title a {
                    display: -webkit-box;
                    overflow: hidden;
                    color: #172033 !important;
                    -webkit-box-orient: vertical;
                    -webkit-line-clamp: 2;
                }

                .cc-modern-shop
                .o_wsale_products_item_title a:hover {
                    color: #1769e0 !important;
                }

                /* Ocultar descripción para mantener compacta la tarjeta */

                .cc-modern-shop
                .oe_subdescription_wrapper {
                    display: none !important;
                }

                /* PRECIO Y BOTÓN */

                .cc-modern-shop .o_wsale_product_sub {
                    display: flex !important;
                    width: 100% !important;
                    align-items: center !important;
                    justify-content: space-between !important;
                    flex-wrap: nowrap !important;
                    gap: 8px !important;
                    margin-top: auto !important;
                    padding-top: 10px !important;
                    border-top: 1px solid #edf0f5;
                }

                .cc-modern-shop .product_price {
                    min-width: 0 !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    color: #0b1f3a !important;
                    font-size: 16px !important;
                    font-weight: 800 !important;
                    white-space: nowrap;
                }

                .cc-modern-shop .product_price::before,
                .cc-modern-shop
                .o_wsale_product_btn::before {
                    display: none !important;
                }

                .cc-modern-shop .o_wsale_product_btn {
                    width: auto !important;
                    margin: 0 0 0 auto !important;
                    padding: 0 !important;
                }

                .cc-modern-shop
                .o_wsale_product_btn
                .btn {
                    min-height: 34px !important;
                    padding: 6px 9px !important;
                    border: 0 !important;
                    border-radius: 8px !important;
                    background: #0b335d !important;
                    color: #ffffff !important;
                    font-size: 11px !important;
                    font-weight: 700;
                    white-space: nowrap;
                }

                .cc-modern-shop
                .o_wsale_product_btn
                .btn:hover {
                    background: #1769e0 !important;
                }

                /* =====================================================
                   RESPONSIVE
                   ===================================================== */

                @media (max-width: 1199.98px) {
                    .cc-modern-shop
                    #o_wsale_products_grid
                    .oe_product {
                        grid-column: span 4 !important;
                    }
                }

                @media (max-width: 991.98px) {
                    .cc-modern-shop
                    #o_wsale_products_grid
                    .oe_product {
                        grid-column: span 6 !important;
                    }

                    .cc-modern-shop
                    .products_header {
                        flex-wrap: wrap !important;
                    }
                }

                @media (max-width: 575.98px) {
                    .cc-modern-shop #o_wsale_container {
                        padding-top: 13px;
                    }

                    .cc-modern-shop #o_wsale_products_header {
                        padding: 13px !important;
                        border-radius: 12px;
                    }

                    .cc-modern-shop
                    #o_wsale_products_grid
                    .oe_product {
                        grid-column: span 12 !important;
                    }

                    .cc-modern-shop .oe_product_image,
                    .cc-modern-shop .oe_product_image_link,
                    .cc-modern-shop
                    .oe_product_image_img_wrapper {
                        height: 165px !important;
                        min-height: 165px !important;
                    }
                }

            </style>

        </xpath>

    </template>

</odoo>