<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="libro_reclamaciones_form" name="Libro de Reclamaciones">
        <t t-call="website.layout">
            <t t-set="additional_title">Libro de Reclamaciones</t>

            <style>
                .lr-page{background:#f5f7fb;padding:48px 0 70px}
                .lr-wrap{max-width:1050px;margin:0 auto;padding:0 18px}
                .lr-hero{background:linear-gradient(135deg,#17233f,#243f71);color:#fff;border-radius:22px;padding:34px 36px;margin-bottom:24px;box-shadow:0 18px 50px rgba(20,38,71,.16)}
                .lr-hero h1{font-size:2rem;font-weight:800;margin:0 0 8px}
                .lr-hero p{margin:0;color:rgba(255,255,255,.82)}
                .lr-card{background:#fff;border:1px solid #e8edf5;border-radius:20px;padding:28px;margin-bottom:20px;box-shadow:0 8px 30px rgba(20,38,71,.06)}
                .lr-card-title{font-size:1.05rem;font-weight:800;color:#17233f;margin-bottom:20px;display:flex;align-items:center;gap:10px}
                .lr-number{width:30px;height:30px;border-radius:9px;background:#eef3ff;color:#2854b8;display:inline-flex;align-items:center;justify-content:center;font-size:.9rem}
                .lr-label{font-size:.88rem;font-weight:700;color:#334155;margin-bottom:7px}
                .lr-required{color:#dc3545}
                .lr-control{border:1px solid #dbe3ef;border-radius:12px;min-height:48px;padding:10px 13px;background:#fff;width:100%;transition:.2s}
                .lr-control:focus{border-color:#4d74d6;box-shadow:0 0 0 .2rem rgba(77,116,214,.12);outline:none}
                textarea.lr-control{min-height:120px;resize:vertical}
                .lr-doc-status{font-size:.82rem;margin-top:7px;min-height:18px}
                .lr-money-grid{display:grid;grid-template-columns:minmax(230px,1fr) minmax(230px,1fr);gap:14px}
                .lr-currency-card{border:1px solid #dbe3ef;border-radius:14px;padding:12px 14px;background:#fff;display:flex;align-items:center;gap:12px;width:100%;min-height:52px}
                .lr-flag{font-size:1.45rem}
                .lr-money-input{position:relative}
                .lr-money-symbol{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-weight:800;color:#17233f;z-index:2}
                .lr-money-input input{padding-left:46px;font-size:1.05rem;font-weight:700}
                .lr-signature-box{border:1px solid #dbe3ef;border-radius:16px;background:#fff;overflow:hidden}
                #lr_signature_canvas{display:block;width:100%;height:210px;touch-action:none;cursor:crosshair;background:#fff}
                .lr-signature-tools{display:flex;justify-content:flex-end;border-top:1px solid #edf1f7;padding:10px}
                .lr-btn-clear{border:0;background:#eef2f7;color:#475569;padding:8px 14px;border-radius:9px;font-weight:700}
                .lr-submit{width:100%;border:0;border-radius:14px;background:#1e3a6d;color:#fff;font-size:1rem;font-weight:800;padding:15px 20px;box-shadow:0 10px 24px rgba(30,58,109,.22)}
                .lr-submit:hover{background:#172f5c}
                .lr-note{font-size:.84rem;color:#64748b}
                .lr-error{background:#fff2f2;border:1px solid #ffc9c9;color:#a61b1b;border-radius:14px;padding:14px 16px;margin-bottom:20px}
                .lr-check{display:flex;gap:10px;align-items:flex-start;margin-bottom:12px}
                .lr-check input{margin-top:4px}
                @media(max-width:768px){.lr-page{padding-top:24px}.lr-hero{padding:26px 22px}.lr-card{padding:20px}.lr-money-grid{grid-template-columns:1fr}}
            </style>

            <main class="lr-page">
                <div class="lr-wrap">

                    <section class="lr-hero">
                        <h1>Libro de Reclamaciones</h1>
                        <p>Registre aquí su reclamo o queja. Al finalizar recibirá un número de hoja y podrá descargar su constancia.</p>
                    </section>

                    <t t-if="error">
                        <div class="lr-error">
                            <i class="fa fa-exclamation-circle me-2"/>
                            <t t-esc="error"/>
                        </div>
                    </t>

                    <form id="lr_form" action="/libro-de-reclamaciones/enviar" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="firma_consumidor_data" id="lr_signature_data"/>

                        <section class="lr-card">
                            <div class="lr-card-title"><span class="lr-number">1</span> Identificación del consumidor</div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="lr-label">Tipo de documento <span class="lr-required">*</span></label>
                                    <select class="lr-control" name="tipo_documento" id="lr_tipo_documento" required="required">
                                        <option value="dni">DNI</option>
                                        <option value="ce">Carné de extranjería</option>
                                        <option value="pasaporte">Pasaporte</option>
                                    </select>
                                </div>

                                <div class="col-md-4">
                                    <label class="lr-label">Número de documento <span class="lr-required">*</span></label>
                                    <input class="lr-control" type="text" name="numero_documento" id="lr_numero_documento" maxlength="20" autocomplete="off" required="required"/>
                                    <div id="lr_doc_status" class="lr-doc-status"></div>
                                </div>

                                <div class="col-md-4">
                                    <label class="lr-label">Nombre completo <span class="lr-required">*</span></label>
                                    <input class="lr-control" type="text" name="nombre_consumidor" id="lr_nombre_consumidor" maxlength="180" required="required"/>
                                </div>

                                <div class="col-md-6">
                                    <label class="lr-label">Domicilio <span class="lr-required">*</span></label>
                                    <input class="lr-control" type="text" name="domicilio_consumidor" maxlength="250" required="required"/>
                                </div>

                                <div class="col-md-3">
                                    <label class="lr-label">Teléfono <span class="lr-required">*</span></label>
                                    <input class="lr-control" type="tel" name="telefono" maxlength="30" required="required"/>
                                </div>

                                <div class="col-md-3">
                                    <label class="lr-label">Correo electrónico <span class="lr-required">*</span></label>
                                    <input class="lr-control" type="email" name="email" maxlength="180" required="required"/>
                                </div>

                                <div class="col-12">
                                    <label class="lr-label">Nombre del padre, madre o apoderado <span class="text-muted fw-normal">(si corresponde)</span></label>
                                    <input class="lr-control" type="text" name="representante_menor_nombre" maxlength="180"/>
                                </div>
                            </div>
                        </section>

                        <section class="lr-card">
                            <div class="lr-card-title"><span class="lr-number">2</span> Identificación del bien contratado</div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="lr-label">Tipo <span class="lr-required">*</span></label>
                                    <select class="lr-control" name="tipo_bien" required="required">
                                        <option value="">Seleccione</option>
                                        <option value="producto">Producto</option>
                                        <option value="servicio">Servicio</option>
                                    </select>
                                </div>

                                <div class="col-md-8">
                                    <label class="lr-label">Comprobante o documento relacionado</label>
                                    <input class="lr-control" type="text" name="numero_documento_comercial" maxlength="100"/>
                                </div>

                                <div class="col-12">
                                    <label class="lr-label">Monto reclamado</label>
                                    <div class="lr-money-grid">
                                        <select class="lr-currency-card" name="currency_code" id="lr_currency">
                                            <option value="PEN">🇵🇪 PEN · S/ · Sol peruano</option>
                                            <option value="USD">🇺🇸 USD · $ · Dólar estadounidense</option>
                                        </select>

                                        <div class="lr-money-input">
                                            <span class="lr-money-symbol" id="lr_currency_symbol">S/</span>
                                            <input class="lr-control" type="number" name="monto_reclamado" id="lr_monto" min="0" step="0.01" inputmode="decimal" placeholder="0.00"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="lr-label">Descripción del producto o servicio <span class="lr-required">*</span></label>
                                    <textarea class="lr-control" name="descripcion_bien" required="required"></textarea>
                                </div>
                            </div>
                        </section>

                        <section class="lr-card">
                            <div class="lr-card-title"><span class="lr-number">3</span> Detalle de la reclamación y pedido</div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="lr-label">Tipo <span class="lr-required">*</span></label>
                                    <select class="lr-control" name="tipo_reclamacion" required="required">
                                        <option value="">Seleccione</option>
                                        <option value="reclamo">Reclamo</option>
                                        <option value="queja">Queja</option>
                                    </select>
                                </div>

                                <div class="col-12">
                                    <label class="lr-label">Detalle <span class="lr-required">*</span></label>
                                    <textarea class="lr-control" name="detalle" required="required"></textarea>
                                </div>

                                <div class="col-12">
                                    <label class="lr-label">Pedido del consumidor <span class="lr-required">*</span></label>
                                    <textarea class="lr-control" name="pedido_consumidor" required="required"></textarea>
                                </div>
                            </div>
                        </section>

                        <section class="lr-card">
                            <div class="lr-card-title"><span class="lr-number">4</span> Firma y adjuntos</div>

                            <label class="lr-label">Firma del consumidor <span class="lr-required">*</span></label>
                            <div class="lr-signature-box">
                                <canvas id="lr_signature_canvas"></canvas>
                                <div class="lr-signature-tools">
                                    <button class="lr-btn-clear" id="lr_clear_signature" type="button"><i class="fa fa-eraser me-1"/> Limpiar firma</button>
                                </div>
                            </div>

                            <div class="mt-4">
                                <label class="lr-label">Adjuntar archivos <span class="text-muted fw-normal">(opcional)</span></label>
                                <input class="lr-control" type="file" name="adjuntos" multiple="multiple" accept=".pdf,.png,.jpg,.jpeg"/>
                                <div class="lr-note mt-2">Puede adjuntar comprobantes, fotografías u otros documentos relacionados.</div>
                            </div>
                        </section>

                        <section class="lr-card">
                            <div class="lr-check">
                                <input type="checkbox" name="acepta_declaracion" value="1" id="lr_declaracion" required="required"/>
                                <label for="lr_declaracion">Declaro que la información registrada es correcta y corresponde a mi reclamación.</label>
                            </div>

                            <div class="lr-check">
                                <input type="checkbox" name="acepta_privacidad" value="1" id="lr_privacidad" required="required"/>
                                <label for="lr_privacidad">Autorizo el tratamiento de los datos proporcionados para la atención de esta reclamación.</label>
                            </div>

                            <button class="lr-submit" type="submit" id="lr_submit">
                                <i class="fa fa-paper-plane me-2"/>
                                Registrar reclamación
                            </button>
                        </section>
                    </form>

                    <section class="lr-card">
                        <div class="lr-note">
                            <strong>Reclamo:</strong> disconformidad relacionada con los productos o servicios contratados.
                            <br/>
                            <strong>Queja:</strong> disconformidad no relacionada directamente con los productos o servicios, o malestar respecto de la atención al público.
                        </div>
                    </section>
                </div>
            </main>

            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function () {
                    const form = document.getElementById("lr_form");
                    const tipoDocumento = document.getElementById("lr_tipo_documento");
                    const numeroDocumento = document.getElementById("lr_numero_documento");
                    const nombreConsumidor = document.getElementById("lr_nombre_consumidor");
                    const docStatus = document.getElementById("lr_doc_status");
                    const currency = document.getElementById("lr_currency");
                    const currencySymbol = document.getElementById("lr_currency_symbol");
                    const canvas = document.getElementById("lr_signature_canvas");
                    const signatureData = document.getElementById("lr_signature_data");
                    const clearSignature = document.getElementById("lr_clear_signature");
                    const submitButton = document.getElementById("lr_submit");
                    const ctx = canvas.getContext("2d");

                    let drawing = false;
                    let hasSignature = false;
                    let dniTimer = null;

                    function resizeCanvas() {
                        const ratio = Math.max(window.devicePixelRatio || 1, 1);
                        const rect = canvas.getBoundingClientRect();
                        const saved = hasSignature ? canvas.toDataURL("image/png") : null;
                        canvas.width = Math.floor(rect.width * ratio);
                        canvas.height = Math.floor(210 * ratio);
                        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
                        ctx.lineWidth = 2;
                        ctx.lineCap = "round";
                        ctx.lineJoin = "round";
                        ctx.strokeStyle = "#17233f";
                        if (saved) {
                            const image = new Image();
                            image.onload = function () {
                                ctx.drawImage(image, 0, 0, rect.width, 210);
                            };
                            image.src = saved;
                        }
                    }

                    function point(event) {
                        const rect = canvas.getBoundingClientRect();
                        const source = event.touches ? event.touches[0] : event;
                        return {x: source.clientX - rect.left, y: source.clientY - rect.top};
                    }

                    function start(event) {
                        event.preventDefault();
                        drawing = true;
                        hasSignature = true;
                        const p = point(event);
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                    }

                    function move(event) {
                        if (!drawing) return;
                        event.preventDefault();
                        const p = point(event);
                        ctx.lineTo(p.x, p.y);
                        ctx.stroke();
                    }

                    function end(event) {
                        if (!drawing) return;
                        event.preventDefault();
                        drawing = false;
                    }

                    canvas.addEventListener("mousedown", start);
                    canvas.addEventListener("mousemove", move);
                    window.addEventListener("mouseup", end);
                    canvas.addEventListener("touchstart", start, {passive:false});
                    canvas.addEventListener("touchmove", move, {passive:false});
                    canvas.addEventListener("touchend", end, {passive:false});

                    clearSignature.addEventListener("click", function () {
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        hasSignature = false;
                        signatureData.value = "";
                    });

                    window.addEventListener("resize", resizeCanvas);
                    resizeCanvas();

                    function updateDocumentMode() {
                        const isDni = tipoDocumento.value === "dni";
                        numeroDocumento.maxLength = isDni ? 8 : 20;
                        numeroDocumento.inputMode = isDni ? "numeric" : "text";
                        docStatus.textContent = "";
                        docStatus.className = "lr-doc-status";
                        if (!isDni) {
                            nombreConsumidor.readOnly = false;
                        }
                    }

                    async function lookupDni() {
                        if (tipoDocumento.value !== "dni") return;
                        const dni = numeroDocumento.value.replace(/\D/g, "");
                        numeroDocumento.value = dni;
                        if (dni.length !== 8) {
                            docStatus.textContent = "";
                            nombreConsumidor.readOnly = false;
                            return;
                        }

                        docStatus.textContent = "Consultando...";
                        docStatus.className = "lr-doc-status text-muted";

                        try {
                            const response = await fetch("/libro-de-reclamaciones/consultar-dni", {
                                method: "POST",
                                headers: {"Content-Type": "application/json"},
                                body: JSON.stringify({
                                    jsonrpc: "2.0",
                                    method: "call",
                                    params: {numero: dni},
                                    id: Date.now()
                                })
                            });

                            const payload = await response.json();
                            const result = payload.result || {};

                            if (result.ok) {
                                nombreConsumidor.value = result.nombre || "";
                                nombreConsumidor.readOnly = true;
                                docStatus.textContent = "Documento validado";
                                docStatus.className = "lr-doc-status text-success";
                            } else {
                                nombreConsumidor.readOnly = false;
                                docStatus.textContent = result.message || "Ingrese el nombre completo manualmente.";
                                docStatus.className = "lr-doc-status text-muted";
                            }
                        } catch (error) {
                            nombreConsumidor.readOnly = false;
                            docStatus.textContent = "Ingrese el nombre completo manualmente.";
                            docStatus.className = "lr-doc-status text-muted";
                        }
                    }

                    tipoDocumento.addEventListener("change", function () {
                        numeroDocumento.value = "";
                        nombreConsumidor.value = "";
                        nombreConsumidor.readOnly = false;
                        updateDocumentMode();
                    });

                    numeroDocumento.addEventListener("input", function () {
                        if (tipoDocumento.value === "dni") {
                            numeroDocumento.value = numeroDocumento.value.replace(/\D/g, "").slice(0, 8);
                            clearTimeout(dniTimer);
                            dniTimer = setTimeout(lookupDni, 450);
                        }
                    });

                    currency.addEventListener("change", function () {
                        currencySymbol.textContent = currency.value === "USD" ? "$" : "S/";
                    });

                    form.addEventListener("submit", function (event) {
                        if (!hasSignature) {
                            event.preventDefault();
                            alert("Debe registrar su firma antes de enviar la reclamación.");
                            canvas.scrollIntoView({behavior:"smooth", block:"center"});
                            return;
                        }

                        signatureData.value = canvas.toDataURL("image/png");
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i> Registrando...';
                    });

                    updateDocumentMode();
                });
            </script>
        </t>
    </template>

    <template id="libro_reclamaciones_confirmacion" name="Confirmación - Libro de Reclamaciones">
        <t t-call="website.layout">
            <main style="background:#f5f7fb;padding:70px 20px;min-height:65vh;">
                <div style="max-width:760px;margin:0 auto;background:#fff;border:1px solid #e8edf5;border-radius:22px;padding:38px;box-shadow:0 12px 35px rgba(20,38,71,.08);text-align:center;">
                    <div style="width:68px;height:68px;border-radius:50%;background:#e9f8ef;color:#21854b;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;font-size:30px;"><i class="fa fa-check"/></div>
                    <h1 style="font-weight:800;color:#17233f;">Reclamación registrada</h1>
                    <p style="color:#64748b;">Su hoja fue registrada correctamente con el número:</p>
                    <div style="font-size:1.4rem;font-weight:800;color:#1e3a6d;margin:18px 0;"><t t-esc="reclamacion.name"/></div>
                    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                        <a class="btn btn-primary" t-att-href="'/libro-de-reclamaciones/pdf/%s' % reclamacion.public_token" target="_blank"><i class="fa fa-file-pdf-o me-2"/> Ver PDF</a>
                        <a class="btn btn-outline-primary" t-att-href="'/libro-de-reclamaciones/descargar/%s' % reclamacion.public_token"><i class="fa fa-download me-2"/> Descargar constancia</a>
                    </div>
                </div>
            </main>
        </t>
    </template>

    <template id="libro_reclamaciones_constancia" name="Constancia - Libro de Reclamaciones">
        <t t-call="website.layout">
            <main style="background:#f5f7fb;padding:50px 20px;">
                <div style="max-width:900px;margin:0 auto;background:#fff;border-radius:20px;padding:30px;border:1px solid #e8edf5;">
                    <h2 style="font-weight:800;color:#17233f;">Constancia de reclamación</h2>
                    <hr/>
                    <div class="row g-3">
                        <div class="col-md-6"><strong>N.º Hoja:</strong><br/><t t-esc="reclamacion.name"/></div>
                        <div class="col-md-6"><strong>Fecha:</strong><br/><span t-field="reclamacion.fecha_reclamo"/></div>
                        <div class="col-md-6"><strong>Consumidor:</strong><br/><t t-esc="reclamacion.nombre_consumidor"/></div>
                        <div class="col-md-6"><strong>Documento:</strong><br/><t t-esc="reclamacion.numero_documento"/></div>
                        <div class="col-md-6"><strong>Tipo:</strong><br/><t t-esc="dict(reclamacion._fields['tipo_reclamacion'].selection).get(reclamacion.tipo_reclamacion)"/></div>
                        <div class="col-md-6"><strong>Monto:</strong><br/><span t-field="reclamacion.monto_reclamado" t-options='{"widget":"monetary","display_currency":reclamacion.currency_id}'/></div>
                    </div>
                    <div class="mt-4">
                        <a class="btn btn-primary" t-att-href="'/libro-de-reclamaciones/descargar/%s' % reclamacion.public_token"><i class="fa fa-download me-2"/> Descargar PDF</a>
                    </div>
                </div>
            </main>
        </t>
    </template>

    <template id="footer_libro_reclamaciones_link" inherit_id="website.layout" name="Enlace Libro de Reclamaciones">
        <xpath expr="//footer" position="inside">
            <div class="container py-2 text-center">
                <a href="/libro-de-reclamaciones" class="text-decoration-none">Libro de Reclamaciones</a>
            </div>
        </xpath>
    </template>

</odoo>
