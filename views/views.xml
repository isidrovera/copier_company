<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!-- LISTA DE MÁQUINAS                                        -->
        <!-- ========================================================= -->
        <record model="ir.ui.view" id="copier_company.list">
            <field name="name">copier.company.list</field>
            <field name="model">copier.company</field>
            <field name="arch" type="xml">
                <list string="Máquinas"
                      default_order="secuencia desc, id desc"
                      class="cc_machine_list"
                      decoration-success="estado_maquina_id and estado_maquina_id.name == 'Alquilada'"
                      decoration-info="estado_maquina_id and estado_maquina_id.name == 'Disponible'"
                      decoration-warning="estado_maquina_id and estado_maquina_id.name == 'En Mantenimiento'"
                      decoration-danger="estado_maquina_id and estado_maquina_id.name == 'Fuera de Servicio'">

                    <field name="secuencia" string="Código"/>
                    <field name="marca_id" string="Marca"/>
                    <field name="name" string="Modelo"/>
                    <field name="serie_id" string="Serie"/>
                    <field name="cliente_id" string="Cliente"/>
                    <field name="billing_group_id" string="Grupo Facturación" optional="show"/>
                    <field name="sede" string="Sede"/>
                    <field name="ubicacion" string="Ubicación"/>
                    <field name="estado_maquina_id" string="Estado"/>
                    <field name="estado_renovacion" string="Contrato" optional="show"/>
                    <field name="fecha_inicio_alquiler" string="Inicio" optional="show"/>
                    <field name="fecha_fin_alquiler" string="Fin" optional="hide"/>
                    <field name="total_facturar_mensual"
                           string="Total Mensual"
                           widget="monetary"
                           optional="show"
                           sum="Total General"/>

                    <field name="tipo" optional="hide"/>
                    <field name="currency_id" optional="hide"/>
                    <field name="dia_facturacion" optional="hide"/>
                    <field name="duracion_alquiler_id" string="Duración" optional="hide"/>
                    <field name="volumen_mensual_bn"
                           string="Vol. Mensual B/N"
                           optional="hide"
                           sum="Total Vol. B/N"/>
                    <field name="volumen_mensual_color"
                           string="Vol. Mensual Color"
                           optional="hide"
                           sum="Total Vol. Color"/>
                    <field name="costo_copia_bn"
                           string="Costo B/N"
                           optional="hide"
                           avg="Promedio Costo B/N"/>
                    <field name="costo_copia_color"
                           string="Costo Color"
                           optional="hide"
                           avg="Promedio Costo Color"/>
                    <field name="renta_mensual_bn"
                           string="Renta B/N"
                           widget="monetary"
                           optional="hide"
                           sum="Total Renta B/N"/>
                    <field name="renta_mensual_color"
                           string="Renta Color"
                           widget="monetary"
                           optional="hide"
                           sum="Total Renta Color"/>
                    <field name="subtotal_sin_igv"
                           string="Subtotal"
                           widget="monetary"
                           optional="hide"
                           sum="Total Subtotal"/>
                    <field name="igv" optional="hide"/>
                    <field name="monto_igv"
                           string="Monto IGV"
                           widget="monetary"
                           optional="hide"
                           sum="Total IGV"/>
                    <field name="descuento" optional="hide"/>
                    <field name="producto_facturable_bn_id" string="Producto B/N" optional="hide"/>
                    <field name="producto_facturable_color_id" string="Producto Color" optional="hide"/>
                    <field name="qr_code" optional="hide"/>

                    <button name="action_crear_servicio_tecnico"
                            string="Servicio"
                            type="object"
                            icon="fa-wrench"
                            class="btn-link"/>
                    <button name="generar_qr_code"
                            string="QR"
                            type="object"
                            icon="fa-qrcode"
                            class="btn-link"/>
                </list>
            </field>
        </record>


        <!-- ========================================================= -->
        <!-- FORMULARIO DE MÁQUINA                                    -->
        <!-- ========================================================= -->
        <record id="view_maquinas_form" model="ir.ui.view">
            <field name="name">copier.company.form</field>
            <field name="model">copier.company</field>
            <field name="arch" type="xml">
                <form class="cc_machine_form">

                    <header>
                        <button name="action_crear_servicio_tecnico"
                                string="Crear Ticket"
                                type="object"
                                icon="fa-wrench"
                                class="btn-primary"/>

                        <button name="generar_qr_code"
                                string="Generar QR"
                                type="object"
                                icon="fa-qrcode"
                                class="btn-secondary"/>

                        <button name="action_print_report"
                                string="Cotización"
                                type="object"
                                icon="fa-file-pdf-o"
                                class="btn-secondary"/>

                        <button name="send_whatsapp_report"
                                string="WhatsApp"
                                type="object"
                                icon="fa-whatsapp"
                                class="btn-secondary"
                                invisible="not estado_maquina_id"
                                data-hotkey="w"/>

                        <button name="enviar_correo_propuesta"
                                string="Enviar Propuesta"
                                type="object"
                                icon="fa-envelope"
                                class="btn-secondary"/>

                        <button name="action_renovar_contrato"
                                string="Renovar Contrato"
                                type="object"
                                icon="fa-refresh"
                                class="btn-secondary"/>

                        <button name="generar_sticker_corporativo"
                                string="Generar Sticker"
                                type="object"
                                icon="fa-qrcode"
                                class="btn-secondary"/>

                        <button name="action_print_stickers"
                                string="Imprimir Stickers"
                                type="object"
                                icon="fa-print"
                                class="btn-secondary"/>

                        <field name="estado_maquina_id"
                               widget="statusbar"
                               options="{'clickable': '1'}"/>
                    </header>

                    <sheet>

                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button"
                                    type="object"
                                    name="action_view_counters"
                                    icon="fa-calculator">
                                <field name="counter_count"
                                       string="Lecturas"
                                       widget="statinfo"/>
                            </button>

                            <button class="oe_stat_button"
                                    type="object"
                                    name="action_ver_usuarios_internos"
                                    icon="fa-users">
                                <field name="user_count"
                                       string="Usuarios"
                                       widget="statinfo"/>
                            </button>
                        </div>

                        <!-- CABECERA -->
                        <div class="cc_machine_hero">
                            <div class="cc_machine_hero_icon">
                                <i class="fa fa-print"/>
                            </div>

                            <div class="cc_machine_hero_content">
                                <div class="cc_machine_eyebrow">
                                    Gestión de equipo
                                </div>

                                <div class="oe_title">
                                    <h1>
                                        <field name="name" placeholder="Modelo del equipo"/>
                                    </h1>
                                </div>

                                <div class="cc_machine_meta">
                                    <span>
                                        <i class="fa fa-barcode"/>
                                        Serie:
                                        <field name="serie_id"/>
                                    </span>

                                    <span>
                                        <i class="fa fa-tag"/>
                                        Código:
                                        <field name="secuencia" readonly="1"/>
                                    </span>

                                    <span>
                                        <i class="fa fa-copyright"/>
                                        <field name="marca_id"/>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- RESUMEN -->
                        <div class="cc_machine_summary">
                            <div class="cc_summary_item">
                                <span class="cc_summary_label">Cliente</span>
                                <strong>
                                    <field name="cliente_id"/>
                                </strong>
                            </div>

                            <div class="cc_summary_item">
                                <span class="cc_summary_label">Sede</span>
                                <strong>
                                    <field name="sede"/>
                                </strong>
                            </div>

                            <div class="cc_summary_item">
                                <span class="cc_summary_label">Ubicación</span>
                                <strong>
                                    <field name="ubicacion"/>
                                </strong>
                            </div>

                            <div class="cc_summary_item">
                                <span class="cc_summary_label">Tipo</span>
                                <strong>
                                    <field name="tipo"/>
                                </strong>
                            </div>
                        </div>

                        <!-- DATOS PRINCIPALES -->
                        <div class="cc_panel">
                            <div class="cc_panel_title">
                                <i class="fa fa-info-circle"/>
                                Datos principales
                            </div>

                            <group col="2">
                                <group string="Equipo">
                                    <field name="marca_id" required="1"/>
                                    <field name="name" required="1"/>
                                    <field name="serie_id" required="1"/>
                                    <field name="tipo" required="1"/>
                                    <field name="accesorios_ids" widget="many2many_tags"/>
                                </group>

                                <group string="Cliente y Ubicación">
                                    <field name="cliente_id" required="1"/>
                                    <field name="billing_group_id"
                                           domain="[('cliente_id', '=', cliente_id), ('active', '=', True)]"
                                           context="{'default_cliente_id': cliente_id}"/>
                                    <field name="tipo_identificacion"/>
                                    <field name="identificacion"/>
                                    <field name="sede" required="1"/>
                                    <field name="ubicacion" required="1"/>
                                </group>
                            </group>
                        </div>

                        <notebook class="cc_machine_notebook">

                            <!-- FACTURACIÓN -->
                            <page name="facturacion" string="Facturación">
                                <div class="cc_tab_header">
                                    <div>
                                        <strong>Contrato y facturación</strong>
                                        <span>
                                            Configuración económica y condiciones del alquiler.
                                        </span>
                                    </div>
                                </div>

                                <div class="cc_panel cc_panel_inside">
                                    <div class="cc_panel_title">
                                        <i class="fa fa-calendar"/>
                                        Contrato
                                    </div>

                                    <group col="2">
                                        <group>
                                            <field name="currency_id"/>
                                            <field name="payment_term_id"
                                                   options="{'no_create': True, 'no_edit': True}"/>
                                            <field name="fecha_inicio_alquiler" required="1"/>
                                            <field name="duracion_alquiler_id" required="1"/>
                                        </group>

                                        <group>
                                            <field name="fecha_fin_alquiler" readonly="1"/>
                                            <field name="dia_facturacion"/>
                                            <field name="facturacion_automatica"/>
                                            <field name="estado_renovacion"/>
                                        </group>
                                    </group>
                                </div>

                                <div class="cc_panel cc_panel_inside">
                                    <div class="cc_panel_title">
                                        <i class="fa fa-cubes"/>
                                        Productos facturables
                                    </div>

                                    <group col="2">
                                        <group>
                                            <field name="producto_facturable_id"
                                                   options="{'no_create': True}"/>
                                            <field name="producto_facturable_bn_id"
                                                   string="Producto B/N"/>
                                        </group>

                                        <group>
                                            <field name="producto_facturable_color_id"
                                                   string="Producto Color"
                                                   invisible="tipo == 'monocroma'"/>
                                        </group>
                                    </group>
                                </div>

                                <div class="cc_panel cc_panel_inside">
                                    <div class="cc_panel_title">
                                        <i class="fa fa-line-chart"/>
                                        Volúmenes y tarifas
                                    </div>

                                    <group col="2">
                                        <group string="Blanco y Negro">
                                            <field name="volumen_mensual_bn"/>
                                            <field name="costo_copia_bn"
                                                   readonly="tipo_calculo != 'auto'"/>
                                            <field name="precio_bn_incluye_igv"
                                                   invisible="tipo_calculo != 'auto'"/>
                                            <field name="renta_mensual_bn" readonly="1"/>
                                        </group>

                                        <group string="Color"
                                               invisible="tipo == 'monocroma'">
                                            <field name="volumen_mensual_color"/>
                                            <field name="costo_copia_color"
                                                   readonly="tipo_calculo != 'auto'"/>
                                            <field name="precio_color_incluye_igv"
                                                   invisible="tipo_calculo != 'auto'"/>
                                            <field name="renta_mensual_color" readonly="1"/>
                                        </group>
                                    </group>
                                </div>

                                <div class="cc_panel cc_panel_inside">
                                    <div class="cc_panel_title">
                                        <i class="fa fa-calculator"/>
                                        Tipo de cálculo
                                    </div>

                                    <group>
                                        <field name="tipo_calculo" widget="radio"/>

                                        <group col="3">
                                            <field name="monto_mensual_bn"
                                                   invisible="tipo_calculo not in ['manual_sin_igv_bn', 'manual_con_igv_bn']"
                                                   placeholder="Monto mensual B/N"/>

                                            <field name="monto_mensual_color"
                                                   invisible="tipo_calculo not in ['manual_sin_igv_color', 'manual_con_igv_color'] or tipo == 'monocroma'"
                                                   placeholder="Monto mensual Color"/>

                                            <field name="monto_mensual_total"
                                                   invisible="tipo_calculo not in ['manual_sin_igv_total', 'manual_con_igv_total']"
                                                   placeholder="Monto mensual total"/>
                                        </group>
                                    </group>
                                </div>

                                <div class="cc_billing_total">
                                    <div class="cc_billing_breakdown">
                                        <group>
                                            <field name="subtotal_sin_igv" readonly="1"/>
                                            <field name="igv"/>
                                            <field name="monto_igv" readonly="1"/>
                                            <field name="descuento"/>
                                        </group>
                                    </div>

                                    <div class="cc_billing_grand_total">
                                        <span class="cc_total_label">TOTAL MENSUAL</span>
                                        <field name="total_facturar_mensual"
                                               readonly="1"
                                               nolabel="1"/>
                                    </div>
                                </div>
                            </page>

                            <!-- RENOVACIONES -->
                            <page name="renovaciones" string="Renovaciones">
                                <div class="cc_tab_header">
                                    <div>
                                        <strong>Historial de renovaciones</strong>
                                        <span>
                                            Seguimiento de vigencia y renovaciones del contrato.
                                        </span>
                                    </div>
                                </div>

                                <div class="cc_status_panel">
                                    <field name="estado_renovacion"
                                           widget="statusbar"
                                           statusbar_visible="vigente,por_vencer,renovado,finalizado"/>
                                </div>

                                <field name="historial_renovaciones" nolabel="1">
                                    <list default_order="fecha_renovacion desc">
                                        <field name="fecha_renovacion"/>
                                        <field name="fecha_anterior"/>
                                        <field name="fecha_fin_anterior"/>
                                        <field name="duracion_anterior_id"/>
                                        <field name="notas"/>
                                    </list>
                                </field>
                            </page>

                            <!-- ESPECIFICACIONES -->
                            <page name="especificaciones" string="Especificaciones">
                                <div class="cc_tab_header">
                                    <div>
                                        <strong>Información técnica</strong>
                                        <span>
                                            Ficha técnica, imagen del equipo y código QR.
                                        </span>
                                    </div>
                                </div>

                                <group col="2">
                                    <group string="Ficha Técnica">
                                        <field name="especificaciones_id"/>
                                    </group>

                                    <group string="Imagen y QR">
                                        <field name="imagen_id"/>
                                        <field name="qr_code"
                                               invisible="not qr_code"/>
                                    </group>
                                </group>
                            </page>

                        </notebook>

                    </sheet>

                    <chatter/>
                </form>
            </field>
        </record>


        <!-- ========================================================= -->
        <!-- KANBAN                                                    -->
        <!-- ========================================================= -->
        <record model="ir.ui.view" id="copier_company.kanban">
            <field name="name">copier_company.kanban</field>
            <field name="model">copier.company</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile cc_machine_kanban"
                        records_draggable="0"
                        create="1"
                        quick_create="0">

                    <field name="name"/>
                    <field name="marca_id"/>
                    <field name="serie_id"/>
                    <field name="cliente_id"/>
                    <field name="billing_group_id"/>
                    <field name="sede"/>
                    <field name="ubicacion"/>
                    <field name="estado_maquina_id"/>
                    <field name="tipo"/>
                    <field name="formato"/>
                    <field name="secuencia"/>

                    <templates>
                        <t t-name="card">
                            <div class="cc_kanban_card">

                                <div class="cc_kanban_head">
                                    <div>
                                        <div class="cc_kanban_code">
                                            <field name="secuencia"/>
                                        </div>

                                        <div class="cc_kanban_model">
                                            <field name="name"/>
                                        </div>

                                        <div class="cc_kanban_serial">
                                            Serie:
                                            <field name="serie_id"/>
                                        </div>
                                    </div>

                                    <div class="cc_kanban_state">
                                        <field name="estado_maquina_id"/>
                                    </div>
                                </div>

                                <div class="cc_kanban_content">
                                    <div class="cc_kanban_row">
                                        <i class="fa fa-copyright"/>
                                        <span>
                                            <field name="marca_id"/>
                                        </span>
                                    </div>

                                    <div class="cc_kanban_row">
                                        <i class="fa fa-building-o"/>
                                        <span>
                                            <field name="cliente_id"/>
                                        </span>
                                    </div>

                                    <div class="cc_kanban_row"
                                         t-if="record.billing_group_id.value">
                                        <i class="fa fa-object-group"/>
                                        <span>
                                            <field name="billing_group_id"/>
                                        </span>
                                    </div>

                                    <div class="cc_kanban_row">
                                        <i class="fa fa-map-marker"/>
                                        <span>
                                            <field name="sede"/>
                                            <t t-if="record.ubicacion.value">
                                                · <field name="ubicacion"/>
                                            </t>
                                        </span>
                                    </div>

                                    <div class="cc_kanban_row">
                                        <i class="fa fa-print"/>
                                        <span>
                                            <field name="tipo"/>
                                            <t t-if="record.formato.value">
                                                · <field name="formato"/>
                                            </t>
                                        </span>
                                    </div>
                                </div>

                                <div class="cc_kanban_actions">
                                    <button name="action_crear_servicio_tecnico"
                                            type="object"
                                            class="btn btn-primary btn-sm">
                                        <i class="fa fa-wrench"/>
                                        Servicio
                                    </button>

                                    <button name="generar_qr_code"
                                            type="object"
                                            class="btn btn-light btn-sm">
                                        <i class="fa fa-qrcode"/>
                                        QR
                                    </button>

                                    <button name="enviar_correo_propuesta"
                                            type="object"
                                            class="btn btn-light btn-sm">
                                        <i class="fa fa-envelope"/>
                                        Email
                                    </button>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- ========================================================= -->
        <!-- BÚSQUEDA - SIN AGRUPACIONES                               -->
        <!-- ========================================================= -->
        <record id="copier_company_search" model="ir.ui.view">
            <field name="name">copier.company.search</field>
            <field name="model">copier.company</field>
            <field name="arch" type="xml">
                <search string="Buscar Máquinas">

                    <field name="secuencia" string="Código"/>
                    <field name="name" string="Modelo"/>
                    <field name="serie_id" string="Serie"/>
                    <field name="cliente_id" string="Cliente"/>
                    <field name="billing_group_id" string="Grupo de Facturación"/>
                    <field name="sede" string="Sede"/>
                    <field name="marca_id" string="Marca"/>

                    <separator/>

                    <filter name="disponible"
                            string="Disponibles"
                            domain="[('estado_maquina_id.name', '=', 'Disponible')]"/>

                    <filter name="alquilada"
                            string="Alquiladas"
                            domain="[('estado_maquina_id.name', '=', 'Alquilada')]"/>

                    <filter name="mantenimiento"
                            string="En Mantenimiento"
                            domain="[('estado_maquina_id.name', '=', 'En Mantenimiento')]"/>

                    <filter name="fuera_servicio"
                            string="Fuera de Servicio"
                            domain="[('estado_maquina_id.name', '=', 'Fuera de Servicio')]"/>

                    <separator/>

                    <filter name="monocroma"
                            string="Monocromas"
                            domain="[('tipo', '=', 'monocroma')]"/>

                    <filter name="color"
                            string="A Color"
                            domain="[('tipo', '=', 'color')]"/>

                    <separator/>

                    <filter name="vigente"
                            string="Vigente"
                            domain="[('estado_renovacion', '=', 'vigente')]"/>

                    <filter name="por_vencer"
                            string="Por Vencer"
                            domain="[('estado_renovacion', '=', 'por_vencer')]"/>

                    <filter name="vencido"
                            string="Vencido"
                            domain="[('estado_renovacion', '=', 'vencido')]"/>

                    <filter name="renovado"
                            string="Renovado"
                            domain="[('estado_renovacion', '=', 'renovado')]"/>

                    <separator/>

                    <filter name="con_facturacion_auto"
                            string="Facturación Automática"
                            domain="[('facturacion_automatica', '=', True)]"/>

                    <filter name="sin_facturacion_auto"
                            string="Facturación Manual"
                            domain="[('facturacion_automatica', '=', False)]"/>

                </search>
            </field>
        </record>

    </data>
</odoo>
