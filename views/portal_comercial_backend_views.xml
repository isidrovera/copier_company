<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- EJECUTIVA PORTAL EN COTIZACIONES Y PEDIDOS -->
    <!-- ===================================================== -->

    <record id="sale_order_form_portal_executive" model="ir.ui.view">
        <field name="name">sale.order.form.portal.executive</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='user_id']" position="after">
                <field
                    name="portal_executive_id"
                    string="Ejecutiva Portal"
                    options="{'no_create': True}"
                    domain="[('user_ids.share', '=', True)]"
                />
            </xpath>

        </field>
    </record>

    <!-- ===================================================== -->
    <!-- EJECUTIVA PORTAL EN FACTURAS -->
    <!-- ===================================================== -->

    <record id="account_move_form_portal_executive" model="ir.ui.view">
        <field name="name">account.move.form.portal.executive</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field
                    name="portal_executive_id"
                    string="Ejecutiva Portal"
                    options="{'no_create': True}"
                    domain="[('user_ids.share', '=', True)]"
                />
            </xpath>

        </field>
    </record>

</odoo>