                <div id="wrap" class="oe_structure cc-homepage">

                    <style>

                        @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css');

                        /* ==================================================
                           VARIABLES
                           ================================================== */

                        .cc-homepage {
                            --cc-primary: #0d6efd;
                            --cc-primary-dark: #0756c9;
                            --cc-navy: #0b2865;
                            --cc-text: #334155;
                            --cc-muted: #64748b;
                            --cc-border: #e2e8f0;
                            --cc-light: #f7faff;
                            --cc-whatsapp: #25d366;

                            background: #ffffff;
                            color: var(--cc-text);
                        }


                        /* ==================================================
                           GENERALES
                           ================================================== */

                        .cc-section {
                            padding: 48px 0;
                        }

                        .cc-section-soft {
                            background: #f8fafc;
                        }

                        .cc-section-title {
                            color: var(--cc-navy);
                            font-weight: 800;
                            font-size: clamp(1.6rem, 2.6vw, 2.25rem);
                            line-height: 1.15;
                            letter-spacing: -0.02em;
                        }

                        .cc-muted {
                            color: var(--cc-muted);
                        }


                        /* ==================================================
                           HERO
                           ================================================== */

                        .cc-hero {
                            position: relative;
                            overflow: hidden;

                            background:
                                radial-gradient(
                                    circle at 90% 20%,
                                    rgba(13, 110, 253, .10),
                                    transparent 35%
                                ),
                                linear-gradient(
                                    180deg,
                                    #fbfdff 0%,
                                    #f1f6ff 100%
                                );

                            padding: 32px 0 28px;
                        }

                        .cc-kicker {
                            display: inline-flex;
                            align-items: center;
                            gap: .45rem;

                            background: #eaf2ff;
                            color: var(--cc-primary);

                            padding: .45rem .75rem;
                            border-radius: 999px;

                            font-size: .78rem;
                            font-weight: 700;
                        }

                        .cc-title {
                            color: var(--cc-navy);

                            font-size: clamp(
                                1.8rem,
                                3.3vw,
                                3rem
                            );

                            line-height: 1.05;
                            font-weight: 800;
                            letter-spacing: -0.035em;

                            max-width: 570px;
                        }

                        .cc-hero-text {
                            color: #475569;

                            font-size: .95rem;
                            line-height: 1.55;

                            max-width: 530px;
                        }


                        /* ==================================================
                           BOTONES HERO
                           ================================================== */

                        .cc-hero-actions {
                            display: flex;
                            flex-wrap: wrap;
                            gap: .65rem;
                        }

                        .cc-hero-actions .btn {
                            border-radius: 11px;

                            padding: .68rem 1.05rem;

                            font-size: .88rem;
                            font-weight: 700;
                        }

                        .cc-btn-primary {
                            background: var(--cc-primary);
                            border-color: var(--cc-primary);
                            color: #ffffff;

                            box-shadow:
                                0 8px 18px
                                rgba(13, 110, 253, .17);
                        }

                        .cc-btn-primary:hover {
                            background: var(--cc-primary-dark);
                            border-color: var(--cc-primary-dark);
                            color: #ffffff;
                        }

                        .cc-whatsapp-btn {
                            background: var(--cc-whatsapp);
                            border-color: var(--cc-whatsapp);
                            color: #ffffff;
                        }

                        .cc-whatsapp-btn:hover {
                            background: #1ebd5a;
                            border-color: #1ebd5a;
                            color: #ffffff;
                        }


                        /* ==================================================
                           ACCESOS RÁPIDOS
                           ================================================== */

                        .cc-services-shortcuts {
                            margin-top: 16px;
                        }

                        .cc-service-link {
                            min-height: 54px;

                            display: flex;
                            align-items: center;

                            gap: .5rem;

                            padding: .6rem .72rem;

                            background: #ffffff;

                            border:
                                1px solid
                                var(--cc-border);

                            border-radius: 12px;

                            color: var(--cc-navy);
                            text-decoration: none;

                            box-shadow:
                                0 5px 16px
                                rgba(15, 23, 42, .04);

                            transition:
                                transform .2s ease,
                                box-shadow .2s ease;
                        }

                        .cc-service-link:hover {
                            color: var(--cc-primary);

                            transform:
                                translateY(-2px);

                            box-shadow:
                                0 8px 18px
                                rgba(15, 23, 42, .07);
                        }

                        .cc-service-link i {
                            color: var(--cc-primary);
                            font-size: 1rem;
                        }

                        .cc-service-link span {
                            font-size: .87rem;
                            font-weight: 700;
                            line-height: 1.1;
                        }


                        /* ==================================================
                           IMAGEN HERO
                           ================================================== */

                        .cc-hero-image-wrapper {
                            width: 100%;
                        }

                        .cc-hero-image {
                            display: block;

                            width: 100%;
                            height: 330px;

                            object-fit: cover;

                            border-radius: 22px;

                            box-shadow:
                                0 18px 45px
                                rgba(15, 23, 42, .13);
                        }


                        /* ==================================================
                           SOLUCIONES
                           ================================================== */

                        .cc-solution-card {
                            height: 100%;

                            overflow: hidden;

                            background: #ffffff;

                            border:
                                1px solid
                                var(--cc-border);

                            border-radius: 16px;

                            box-shadow:
                                0 7px 22px
                                rgba(15, 23, 42, .05);
                        }

                        .cc-solution-card img {
                            display: block;

                            width: 100%;
                            height: 170px;

                            object-fit: cover;
                        }

                        .cc-solution-body {
                            padding: 1.15rem;
                        }

                        .cc-solution-body h3 {
                            color: var(--cc-navy);

                            font-size: 1.1rem;
                            font-weight: 800;
                        }

                        .cc-solution-body p {
                            font-size: .9rem;
                        }

                        .cc-link {
                            color: var(--cc-primary);

                            text-decoration: none;
                            font-size: .88rem;
                            font-weight: 700;
                        }

                        .cc-link:hover {
                            text-decoration: underline;
                        }


                        /* ==================================================
                           POR QUÉ COPIER COMPANY
                           ================================================== */

                        .cc-feature-card {
                            height: 100%;

                            padding: 1.4rem;

                            background: #ffffff;

                            border:
                                1px solid
                                var(--cc-border);

                            border-radius: 16px;

                            box-shadow:
                                0 7px 22px
                                rgba(15, 23, 42, .04);
                        }

                        .cc-feature-icon {
                            width: 50px;
                            height: 50px;

                            margin-bottom: .9rem;

                            display: inline-flex;
                            align-items: center;
                            justify-content: center;

                            border-radius: 50%;

                            background: #edf4ff;
                            color: var(--cc-primary);

                            font-size: 1.3rem;
                        }

                        .cc-feature-card h3 {
                            color: var(--cc-navy);

                            font-size: 1rem;
                            font-weight: 800;
                        }

                        .cc-feature-card p {
                            font-size: .88rem;
                        }


                        /* ==================================================
                           MARCAS
                           ================================================== */

                        .cc-brand-strip {
                            display: grid;

                            grid-template-columns:
                                repeat(
                                    3,
                                    minmax(0, 1fr)
                                );

                            gap: 1rem;
                        }

                        .cc-brand {
                            min-height: 78px;

                            display: flex;
                            align-items: center;
                            justify-content: center;

                            padding: .8rem 1.25rem;

                            border:
                                1px solid
                                var(--cc-border);

                            border-radius: 14px;

                            background: #ffffff;
                        }

                        .cc-brand img {
                            max-height: 42px;
                            max-width: 85%;

                            object-fit: contain;
                        }


                        /* ==================================================
                           MPS
                           ================================================== */

                        .cc-mps-box {
                            padding: 1.6rem;

                            border:
                                1px solid #dbe8ff;

                            border-radius: 18px;

                            background:
                                linear-gradient(
                                    180deg,
                                    #eff5ff 0%,
                                    #f9fbff 100%
                                );
                        }

                        .cc-mps-main-icon {
                            width: 82px;
                            height: 82px;

                            display: inline-flex;
                            align-items: center;
                            justify-content: center;

                            border-radius: 20px;

                            background: #ffffff;
                            color: var(--cc-primary);

                            font-size: 2.2rem;

                            box-shadow:
                                0 8px 22px
                                rgba(15, 23, 42, .06);
                        }

                        .cc-mps-feature {
                            display: flex;
                            align-items: flex-start;

                            gap: .6rem;
                        }

                        .cc-mps-icon {
                            flex: 0 0 auto;

                            width: 38px;
                            height: 38px;

                            display: inline-flex;
                            align-items: center;
                            justify-content: center;

                            border-radius: 50%;

                            background: #ffffff;
                            color: var(--cc-primary);
                        }

                        .cc-mps-feature h4 {
                            color: var(--cc-navy);

                            margin-bottom: .15rem;

                            font-size: .9rem;
                            font-weight: 800;
                        }


                        /* ==================================================
                           CTA FINAL
                           ================================================== */

                        .cc-final-cta {
                            overflow: hidden;

                            padding: 1.8rem 2rem;

                            border-radius: 18px;

                            color: #ffffff;

                            background:
                                linear-gradient(
                                    135deg,
                                    #0d6efd 0%,
                                    #07358a 100%
                                );
                        }

                        .cc-final-cta h2 {
                            font-size: 1.7rem;
                        }

                        .cc-final-cta p {
                            font-size: .95rem;
                        }


                        /* ==================================================
                           RESPONSIVE
                           ================================================== */

                        @media (max-width: 991.98px) {

                            .cc-hero {
                                padding:
                                    28px 0
                                    30px;
                            }

                            .cc-hero-image {
                                height: 300px;
                            }

                            .cc-section {
                                padding: 40px 0;
                            }

                        }


                        @media (max-width: 767.98px) {

                            .cc-title {
                                font-size: 2.25rem;
                            }

                            .cc-hero-text {
                                font-size: .92rem;
                            }

                            .cc-hero-actions .btn {
                                width: 100%;
                            }

                            .cc-hero-image {
                                height: 260px;
                            }

                            .cc-brand-strip {
                                grid-template-columns:
                                    1fr;
                            }

                            .cc-section {
                                padding: 34px 0;
                            }

                            .cc-final-cta {
                                padding:
                                    1.5rem;
                            }

