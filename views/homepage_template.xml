<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="copier_company_modern_homepage"
                  name="Copier Company Modern Homepage"
                  inherit_id="website.homepage">

            <xpath expr="//div[@id='wrap']" position="replace">
                <div id="wrap" class="oe_structure cc-homepage">

                    <style>
                        @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css');

                        .cc-homepage {
                            --cc-primary: #0d6efd;
                            --cc-primary-dark: #0a3d91;
                            --cc-navy: #0b1f52;
                            --cc-text: #334155;
                            --cc-muted: #64748b;
                            --cc-border: #e2e8f0;
                            --cc-light: #f8fafc;
                            background: #ffffff;
                            color: var(--cc-text);
                        }

                        .cc-section {
                            padding: 64px 0;
                        }

                        .cc-section-soft {
                            background: var(--cc-light);
                        }

                        .cc-title {
                            color: var(--cc-navy);
                            font-size: clamp(1.75rem, 3.2vw, 3rem);
                            line-height: 1.05;
                            font-weight: 800;
                            letter-spacing: -0.03em;
                        }

                        .cc-section-title {
                            color: var(--cc-navy);
                            font-size: clamp(1.8rem, 3vw, 2.65rem);
                            line-height: 1.15;
                            font-weight: 800;
                            letter-spacing: -0.02em;
                        }

                        .cc-muted {
                            color: var(--cc-muted);
                        }

                        .cc-hero {
                            position: relative;
                            overflow: hidden;
                            background:
                                radial-gradient(circle at 90% 20%, rgba(13,110,253,.12), transparent 34%),
                                linear-gradient(180deg, #fbfdff 0%, #f2f7ff 100%);
                            padding: 34px 0 28px;
                        }

                        .cc-kicker {
                            display: inline-flex;
                            align-items: center;
                            gap: .55rem;
                            padding: .5rem .8rem;
                            border-radius: 999px;
                            background: #eaf2ff;
                            color: var(--cc-primary);
                            font-weight: 700;
                            font-size: .78rem;
                        }

                        .cc-hero-text {
                            font-size: .94rem;
                            line-height: 1.5;
                            color: #475569;
                            max-width: 520px;
                        }

                        .cc-hero-actions .btn {
                            font-size: .9rem;
                            padding: .7rem 1.05rem;
                            border-radius: 12px;
                            white-space: nowrap;
                        }

                        .cc-btn-primary {
                            background: var(--cc-primary);
                            border-color: var(--cc-primary);
                            box-shadow: 0 10px 24px rgba(13,110,253,.18);
                        }

                        .cc-btn-primary:hover {
                            background: #0b5ed7;
                            border-color: #0b5ed7;
                        }

                        .cc-service-link {
                            min-height: 56px;
                            display: flex;
                            align-items: center;
                            gap: .55rem;
                            padding: .65rem .8rem;
                            border: 1px solid var(--cc-border);
                            border-radius: 13px;
                            background: #fff;
                            color: var(--cc-navy);
                            text-decoration: none;
                            box-shadow: 0 8px 22px rgba(15,23,42,.05);
                            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
                        }

                        .cc-service-link:hover {
                            color: var(--cc-primary);
                            border-color: #bfd6ff;
                            transform: translateY(-3px);
                            box-shadow: 0 12px 26px rgba(15,23,42,.08);
                        }

                        .cc-service-link i {
                            font-size: 1rem;
                            color: var(--cc-primary);
                        }

                        .cc-service-link span {
                            font-size: .9rem;
                            line-height: 1.15;
                        }

                        .cc-hero-visual {
                            position: relative;
                            min-height: 330px;
                        }

                        .cc-hero-image {
                            width: 100%;
                            height: 330px;
                            object-fit: cover;
                            border-radius: 26px;
                            box-shadow: 0 22px 60px rgba(15,23,42,.14);
                        }

                        .cc-floating-card {
                            position: absolute;
                            right: 14px;
                            display: flex;
                            align-items: center;
                            gap: .55rem;
                            width: 165px;
                            padding: .65rem .75rem;
                            background: rgba(255,255,255,.94);
                            border: 1px solid var(--cc-border);
                            border-radius: 13px;
                            box-shadow: 0 14px 34px rgba(15,23,42,.13);
                        }

                        .cc-floating-card.cc-float-top { top: 14px; }
                        .cc-floating-card.cc-float-middle { top: 105px; }
                        .cc-floating-card.cc-float-bottom { top: 196px; }

                        .cc-floating-card .fw-bold {
                            font-size: .88rem;
                            line-height: 1.15;
                        }

                        .cc-floating-card .small {
                            font-size: .78rem;
                            line-height: 1.25;
                        }

                        .cc-mini-icon,
                        .cc-feature-icon,
                        .cc-mps-icon {
                            flex: 0 0 auto;
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                            border-radius: 50%;
                            background: #edf4ff;
                            color: var(--cc-primary);
                        }

                        .cc-mini-icon {
                            width: 48px;
                            height: 48px;
                            font-size: 1rem;
                        }

                        .cc-feature-card {
                            height: 100%;
                            padding: 1.75rem;
                            background: #fff;
                            border: 1px solid var(--cc-border);
                            border-radius: 20px;
                            box-shadow: 0 10px 30px rgba(15,23,42,.05);
                        }

                        .cc-feature-icon {
                            width: 64px;
                            height: 64px;
                            font-size: 1.6rem;
                            margin-bottom: 1rem;
                        }

                        .cc-feature-card h3 {
                            color: var(--cc-navy);
                            font-size: 1rem;
                            font-weight: 800;
                        }

                        .cc-solution-card {
                            height: 100%;
                            overflow: hidden;
                            background: #fff;
                            border: 1px solid var(--cc-border);
                            border-radius: 20px;
                            box-shadow: 0 10px 30px rgba(15,23,42,.06);
                        }

                        .cc-solution-card img {
                            width: 100%;
                            height: 210px;
                            object-fit: cover;
                        }

                        .cc-solution-body {
                            padding: 1.4rem;
                        }

                        .cc-solution-body h3 {
                            color: var(--cc-navy);
                            font-size: 1.35rem;
                            font-weight: 800;
                        }

                        .cc-link {
                            color: var(--cc-primary);
                            text-decoration: none;
                            font-weight: 700;
                        }

                        .cc-link:hover {
                            text-decoration: underline;
                        }

                        .cc-brand-strip {
                            display: grid;
                            grid-template-columns: repeat(3, minmax(0, 1fr));
                            gap: 1rem;
                        }

                        .cc-brand {
                            min-height: 92px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            padding: 1rem 1.5rem;
                            background: #fff;
                            border: 1px solid var(--cc-border);
                            border-radius: 13px;
                        }

                        .cc-brand img {
                            max-height: 48px;
                            max-width: 88%;
                            object-fit: contain;
                        }

                        .cc-mps-box {
                            padding: 2rem;
                            border: 1px solid #d7e6ff;
                            border-radius: 24px;
                            background: linear-gradient(180deg, #eef5ff 0%, #f9fbff 100%);
                        }

                        .cc-mps-main-icon {
                            width: 112px;
                            height: 112px;
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                            border-radius: 28px;
                            background: #fff;
                            color: var(--cc-primary);
                            font-size: 3rem;
                            box-shadow: 0 12px 28px rgba(15,23,42,.07);
                        }

                        .cc-mps-feature {
                            display: flex;
                            gap: .8rem;
                            align-items: flex-start;
                        }

                        .cc-mps-icon {
                            width: 46px;
                            height: 46px;
                            font-size: 1.15rem;
                        }

                        .cc-mps-feature h4 {
                            color: var(--cc-navy);
                            font-size: 1rem;
                            font-weight: 800;
                            margin-bottom: .2rem;
                        }

                        .cc-final-cta {
                            position: relative;
                            overflow: hidden;
                            padding: 2.5rem;
                            border-radius: 24px;
                            color: #fff;
                            background: linear-gradient(135deg, #0d6efd 0%, #063a98 100%);
                        }

                        .cc-final-cta::before {
                            content: '';
                            position: absolute;
                            right: -80px;
                            bottom: -120px;
                            width: 320px;
                            height: 280px;
                            border: 1px solid rgba(255,255,255,.14);
                            border-radius: 50%;
                            box-shadow:
                                0 0 0 40px rgba(255,255,255,.04),
                                0 0 0 80px rgba(255,255,255,.025);
                        }

                        .cc-final-cta .position-relative {
                            z-index: 2;
                        }

                        /*
                         * El contenido debe ser visible SIEMPRE.
                         * No dependemos de JavaScript para mostrar secciones.
                         */
                        .cc-reveal,
                        .cc-reveal.cc-visible {
                            opacity: 1 !important;
                            transform: none !important;
                        }

                        @media (max-width: 991.98px) {
                            .cc-hero {
                                padding: 30px 0 24px;
                            }

                            .cc-section {
                                padding: 52px 0;
                            }

                            .cc-hero-visual {
                                min-height: auto;
                            }

                            .cc-hero-image {
                                height: 310px;
                            }

                            .cc-floating-card {
                                position: static;
                                width: 100%;
                                margin-top: .75rem;
                            }
                        }

                        @media (max-width: 767.98px) {
                            .cc-brand-strip {
                                grid-template-columns: 1fr;
                            }

                            .cc-kicker {
                                font-size: .84rem;
                                padding: .6rem .9rem;
                            }

                            .cc-title {
                                font-size: 2rem;
                            }

                            .cc-hero-text {
                                font-size: .9rem;
                            }

                            .cc-hero-actions .btn {
                                width: 100%;
                                white-space: normal;
                            }

                            .cc-hero-image {
                                height: 280px;
                            }

                            .cc-final-cta {
                                padding: 2rem 1.5rem;
                            }
                        }
                    </style>

                    <!-- HERO -->
                    <section class="cc-hero">
                        <div class="container">
                            <div class="row align-items-center g-4">
                                <div class="col-lg-6">
                                    <div class="cc-kicker mb-3">
                                        <i class="bi bi-building"></i>
                                        <span>Soluciones de impresión para empresas</span>
                                    </div>

                                    <h1 class="cc-title mb-3">
                                        Alquiler y venta de fotocopiadoras para tu empresa
                                    </h1>

                                    <p class="cc-hero-text mb-3">
                                        Equipos multifuncionales, servicio técnico, repuestos y soluciones de monitoreo para las necesidades de impresión de tu empresa.
                                    </p>

                                    <div class="d-flex flex-column flex-sm-row gap-2 mb-3 cc-hero-actions">
                                        <a href="/cotizacion/form" class="btn btn-primary cc-btn-primary fw-bold">
                                            Solicitar cotización
                                            <i class="bi bi-arrow-right ms-2"></i>
                                        </a>
                                        <a href="/contactus" class="btn btn-outline-primary fw-semibold">
                                            <i class="bi bi-chat-dots me-2"></i>
                                            Hablar con un asesor
                                        </a>
                                    </div>

                                    <div class="row g-2">
                                        <div class="col-6 col-xl-3">
                                            <a href="/cotizacion/form" class="cc-service-link">
                                                <i class="bi bi-printer"></i>
                                                <span class="fw-semibold">Alquiler</span>
                                            </a>
                                        </div>
                                        <div class="col-6 col-xl-3">
                                            <a href="/cotizacion/form" class="cc-service-link">
                                                <i class="bi bi-tag"></i>
                                                <span class="fw-semibold">Venta</span>
                                            </a>
                                        </div>
                                        <div class="col-6 col-xl-3">
                                            <a href="/our-services" class="cc-service-link">
                                                <i class="bi bi-tools"></i>
                                                <span class="fw-semibold">Servicio técnico</span>
                                            </a>
                                        </div>
                                        <div class="col-6 col-xl-3">
                                            <a href="/our-services" class="cc-service-link">
                                                <i class="bi bi-box-seam"></i>
                                                <span class="fw-semibold">Repuestos</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <div class="cc-hero-visual">
                                        <img src="https://filedn.com/lSeVjMkwzjCzV24eJl1FUoj/MFP-A3/0852640001525386084WEhFP7GP3L.jpg"
                                             alt="Equipo multifuncional Copier Company"
                                             class="cc-hero-image"/>

                                        <div class="cc-floating-card cc-float-bottom">
                                            <span class="cc-mini-icon"><i class="bi bi-shield-check"></i></span>
                                            <div>
                                                <div class="fw-bold text-dark">Mantenimiento</div>
                                                <div class="small cc-muted">Soporte para equipos</div>
                                            </div>
                                        </div>

                                        <div class="cc-floating-card cc-float-top">
                                            <span class="cc-mini-icon"><i class="bi bi-headset"></i></span>
                                            <div>
                                                <div class="fw-bold text-dark">Servicio técnico</div>
                                                <div class="small cc-muted">Atención especializada</div>
                                            </div>
                                        </div>

                                        <div class="cc-floating-card cc-float-middle">
                                            <span class="cc-mini-icon"><i class="bi bi-bar-chart-line"></i></span>
                                            <div>
                                                <div class="fw-bold text-dark">Monitoreo MPS</div>
                                                <div class="small cc-muted">Control de flota</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- SERVICIOS PRINCIPALES -->
                    <section class="cc-section bg-white">
                        <div class="container">
                            <div class="text-center mb-5 cc-reveal">
                                <h2 class="cc-section-title mb-3">Soluciones para tu empresa</h2>
                                <p class="cc-muted mb-0">Concentramos nuestros principales servicios en una sola sección para que encuentres rápidamente lo que necesitas.</p>
                            </div>

                            <div class="row g-4">
                                <div class="col-lg-4 cc-reveal">
                                    <div class="cc-solution-card">
                                        <img src="https://filedn.com/lSeVjMkwzjCzV24eJl1FUoj/MFP-A3/images.jpg" alt="Alquiler de fotocopiadoras"/>
                                        <div class="cc-solution-body">
                                            <h3>Alquiler de equipos</h3>
                                            <p class="cc-muted">Equipos multifuncionales para empresas con servicio y mantenimiento según las condiciones de cada plan.</p>
                                            <a href="/cotizacion/form" class="cc-link">Solicitar información <i class="bi bi-arrow-right ms-1"></i></a>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 cc-reveal">
                                    <div class="cc-solution-card">
                                        <img src="https://filedn.com/lSeVjMkwzjCzV24eJl1FUoj/MFP-A4/iR-ADV_C355i_No_076_EU_1920x1080.jpg" alt="Venta de fotocopiadoras"/>
                                        <div class="cc-solution-body">
                                            <h3>Venta de equipos</h3>
                                            <p class="cc-muted">Soluciones de impresión para diferentes volúmenes y necesidades de trabajo.</p>
                                            <a href="/cotizacion/form" class="cc-link">Solicitar información <i class="bi bi-arrow-right ms-1"></i></a>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 cc-reveal">
                                    <div class="cc-solution-card">
                                        <img src="https://filedn.com/lSeVjMkwzjCzV24eJl1FUoj/MFP-A3/bizhub-iseries-media2.jpg" alt="Servicio técnico de fotocopiadoras"/>
                                        <div class="cc-solution-body">
                                            <h3>Servicio técnico</h3>
                                            <p class="cc-muted">Diagnóstico, mantenimiento y reparación de equipos multifuncionales.</p>
                                            <a href="/our-services" class="cc-link">Conocer el servicio <i class="bi bi-arrow-right ms-1"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- POR QUÉ ELEGIRNOS -->
                    <section class="cc-section cc-section-soft">
                        <div class="container">
                            <div class="text-center mb-5 cc-reveal">
                                <h2 class="cc-section-title mb-3">¿Por qué Copier Company?</h2>
                                <p class="cc-muted mb-0">Tres pilares que resumen nuestra propuesta de servicio.</p>
                            </div>

                            <div class="row g-4">
                                <div class="col-lg-4 cc-reveal">
                                    <div class="cc-feature-card text-center">
                                        <span class="cc-feature-icon"><i class="bi bi-tools"></i></span>
                                        <h3>Servicio y mantenimiento</h3>
                                        <p class="cc-muted mb-0">Acompañamiento técnico para mantener tus equipos en operación.</p>
                                    </div>
                                </div>

                                <div class="col-lg-4 cc-reveal">
                                    <div class="cc-feature-card text-center">
                                        <span class="cc-feature-icon"><i class="bi bi-printer"></i></span>
                                        <h3>Equipos para distintas necesidades</h3>
                                        <p class="cc-muted mb-0">Opciones para diferentes volúmenes, formatos y requerimientos de impresión.</p>
                                    </div>
                                </div>

                                <div class="col-lg-4 cc-reveal">
                                    <div class="cc-feature-card text-center">
                                        <span class="cc-feature-icon"><i class="bi bi-bar-chart-line"></i></span>
                                        <h3>Monitoreo MPS</h3>
                                        <p class="cc-muted mb-0">Seguimiento de contadores, niveles de consumibles y estado de equipos compatibles.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- MARCAS -->
                    <section class="cc-section bg-white">
                        <div class="container">
                            <div class="text-center mb-4 cc-reveal">
                                <h2 class="cc-section-title mb-3">Marcas con las que trabajamos</h2>
                            </div>

                            <div class="cc-brand-strip cc-reveal">
                                <div class="cc-brand">
                                    <img src="https://filedn.com/lSeVjMkwzjCzV24eJl1FUoj/ricoh-vector-logo-seeklogo/ricoh-seeklogo.png" alt="Ricoh"/>
                                </div>
                                <div class="cc-brand">
                                    <img src="https://filedn.com/lSeVjMkwzjCzV24eJl1FUoj/konica-minolta-vector-logo-seeklogo/konica-minolta-seeklogo.png" alt="Konica Minolta"/>
                                </div>
                                <div class="cc-brand">
                                    <img src="https://filedn.com/lSeVjMkwzjCzV24eJl1FUoj/canon-vector-logo-seeklogo/canon-seeklogo.png" alt="Canon"/>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- MPS -->
                    <section class="cc-section cc-section-soft">
                        <div class="container">
                            <div class="cc-mps-box cc-reveal">
                                <div class="row align-items-center g-4">
                                    <div class="col-lg-3 text-center">
                                        <div class="cc-mps-main-icon">
                                            <i class="bi bi-display"></i>
                                        </div>
                                    </div>

                                    <div class="col-lg-9">
                                        <h2 class="cc-section-title mb-3">Monitoreo inteligente MPS</h2>
                                        <p class="cc-muted mb-4">
                                            Herramientas de monitoreo para consultar información de los equipos y facilitar la gestión de la flota de impresión.
                                        </p>

                                        <div class="row g-4">
                                            <div class="col-md-4">
                                                <div class="cc-mps-feature">
                                                    <span class="cc-mps-icon"><i class="bi bi-speedometer2"></i></span>
                                                    <div>
                                                        <h4>Lecturas remotas</h4>
                                                        <div class="small cc-muted">Consulta de contadores.</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-4">
                                                <div class="cc-mps-feature">
                                                    <span class="cc-mps-icon"><i class="bi bi-droplet"></i></span>
                                                    <div>
                                                        <h4>Consumibles</h4>
                                                        <div class="small cc-muted">Seguimiento de niveles disponibles.</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-md-4">
                                                <div class="cc-mps-feature">
                                                    <span class="cc-mps-icon"><i class="bi bi-clipboard-data"></i></span>
                                                    <div>
                                                        <h4>Gestión de flota</h4>
                                                        <div class="small cc-muted">Información centralizada de equipos compatibles.</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- CTA FINAL -->
                    <section class="cc-section bg-white pt-0">
                        <div class="container">
                            <div class="cc-final-cta cc-reveal">
                                <div class="row align-items-center g-4 position-relative">
                                    <div class="col-lg-8">
                                        <h2 class="fw-bold mb-3">Encuentra la solución adecuada para tu empresa</h2>
                                        <p class="mb-4 fs-5 opacity-90">
                                            Cuéntanos tus necesidades de impresión y solicita una cotización.
                                        </p>

                                        <div class="d-flex flex-column flex-sm-row gap-3">
                                            <a href="/cotizacion/form" class="btn btn-light btn-lg px-4 py-3 fw-bold text-primary">
                                                Cotizar ahora
                                                <i class="bi bi-arrow-right ms-2"></i>
                                            </a>
                                            <a href="/contactus" class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold">
                                                <i class="bi bi-chat-dots me-2"></i>
                                                Contactar
                                            </a>
                                        </div>
                                    </div>

                                    <div class="col-lg-4 text-center">
                                        <i class="bi bi-printer" style="font-size: 5.5rem; opacity: .9;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <script type="text/javascript" src="/copier_company/static/src/js/copier_homepage_scripts.js"></script>

                </div>
            </xpath>
        </template>
    </data>
</odoo>
