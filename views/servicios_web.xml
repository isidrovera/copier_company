<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <template id="copier_services_modern" name="Servicios">
      <t t-call="website.layout">
        <div id="wrap" class="cc-services-page">
          <style>
            @import url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css');

            .cc-services-page{
              --cc-primary:#0d6efd;--cc-navy:#0b2865;--cc-text:#334155;
              --cc-muted:#64748b;--cc-border:#e2e8f0;--cc-soft:#f6f9ff;
              --cc-whatsapp:#25d366;color:var(--cc-text);background:#fff;
            }
            .cc-section{padding:44px 0}
            .cc-soft{background:var(--cc-soft)}
            .cc-title{color:var(--cc-navy);font-size:clamp(2rem,3.5vw,3.2rem);line-height:1.05;font-weight:800;letter-spacing:-.035em}
            .cc-section-title{color:var(--cc-navy);font-size:clamp(1.55rem,2.5vw,2.15rem);font-weight:800;line-height:1.15}
            .cc-muted{color:var(--cc-muted)}

            .cc-services-hero{
              padding:32px 0 28px;
              background:radial-gradient(circle at 90% 10%,rgba(13,110,253,.11),transparent 34%),
                         linear-gradient(180deg,#fbfdff 0%,#f1f6ff 100%);
            }
            .cc-kicker{
              display:inline-flex;align-items:center;gap:.45rem;padding:.45rem .72rem;
              border-radius:999px;background:#eaf2ff;color:var(--cc-primary);
              font-size:.8rem;font-weight:700;
            }
            .cc-services-hero p{max-width:610px;font-size:.95rem;line-height:1.55;color:#475569}
            .cc-hero-actions .btn{font-size:.86rem;font-weight:700;padding:.68rem 1rem;border-radius:10px}
            .cc-btn-whatsapp{background:var(--cc-whatsapp);border-color:var(--cc-whatsapp);color:#fff}
            .cc-btn-whatsapp:hover{background:#1ebd5a;border-color:#1ebd5a;color:#fff}

            .cc-hero-service-strip{
              display:grid;grid-template-columns:repeat(5,minmax(0,1fr));
              gap:.6rem;margin-top:1rem;
            }
            .cc-hero-chip{
              display:flex;align-items:center;gap:.4rem;min-height:46px;padding:.52rem .62rem;
              border:1px solid var(--cc-border);border-radius:11px;background:#fff;
              color:var(--cc-navy);font-size:.78rem;font-weight:700;
              box-shadow:0 5px 14px rgba(15,23,42,.04);
            }
            .cc-hero-chip i{color:var(--cc-primary);font-size:.95rem}

            .cc-service-card{
              height:100%;padding:1.15rem;border:1px solid var(--cc-border);border-radius:15px;
              background:#fff;box-shadow:0 7px 20px rgba(15,23,42,.05);
              transition:transform .2s ease,box-shadow .2s ease;
            }
            .cc-service-card:hover{transform:translateY(-3px);box-shadow:0 11px 26px rgba(15,23,42,.08)}
            .cc-service-image-wrap{position:relative;overflow:hidden;border-radius:12px;margin-bottom:.85rem}
            .cc-service-image{display:block;width:100%;height:135px;object-fit:cover;transition:transform .35s ease}
            .cc-service-card:hover .cc-service-image{transform:scale(1.035)}
            .cc-service-tag{position:absolute;left:10px;bottom:10px;padding:.28rem .52rem;border-radius:999px;background:rgba(8,28,73,.88);color:#fff;font-size:.7rem;font-weight:700}
            .cc-service-icon{
              width:46px;height:46px;display:inline-flex;align-items:center;justify-content:center;
              border-radius:13px;background:#edf4ff;color:var(--cc-primary);font-size:1.2rem;margin-bottom:.8rem;
            }
            .cc-service-card h3{color:var(--cc-navy);font-size:1.02rem;font-weight:800;margin-bottom:.45rem}
            .cc-service-card p{font-size:.85rem;line-height:1.48;color:var(--cc-muted);margin-bottom:.75rem}
            .cc-service-card ul{padding-left:0;list-style:none;margin-bottom:.75rem}
            .cc-service-card li{display:flex;gap:.42rem;align-items:flex-start;font-size:.8rem;color:#475569;margin-bottom:.3rem}
            .cc-service-card li i{color:#198754;margin-top:.1rem}
            .cc-link{color:var(--cc-primary);text-decoration:none;font-size:.82rem;font-weight:700}

            .cc-step{height:100%;padding:.95rem;border:1px solid var(--cc-border);border-radius:13px;background:#fff}
            .cc-step-number{
              width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;
              border-radius:50%;background:var(--cc-primary);color:#fff;font-weight:800;margin-bottom:.6rem;
            }
            .cc-step h4{color:var(--cc-navy);font-size:.92rem;font-weight:800}
            .cc-step p{color:var(--cc-muted);font-size:.8rem;margin:0}

            .cc-services-cta{
              padding:1.5rem 1.7rem;border-radius:17px;
              background:linear-gradient(135deg,#0d6efd 0%,#07358a 100%);color:#fff;
            }
            .cc-services-cta h2{font-size:1.5rem;font-weight:800}
            .cc-services-cta p{font-size:.88rem;margin-bottom:.9rem}

            .cc-form-header{
              padding:26px 0;background:linear-gradient(135deg,#0d6efd 0%,#0b2865 100%);color:#fff;
            }
            .cc-form-header h1{font-size:clamp(1.8rem,3vw,2.5rem);font-weight:800;margin-bottom:.3rem}
            .cc-form-header p{font-size:.9rem;margin:0;opacity:.9}
            .cc-form-wrap{max-width:980px;margin:28px auto 42px}
            .cc-info-panel,.cc-form-card{
              border:1px solid var(--cc-border);border-radius:15px;background:#fff;
              box-shadow:0 7px 20px rgba(15,23,42,.05);
            }
            .cc-info-panel{padding:.95rem 1.1rem;background:#f8fbff;border-left:4px solid var(--cc-primary)}
            .cc-info-panel h5{color:var(--cc-navy);font-size:.98rem;font-weight:800}
            .cc-info-panel p{font-size:.82rem;margin-bottom:.25rem}
            .cc-form-card{overflow:hidden;margin-bottom:.9rem}
            .cc-form-card-header{
              padding:.72rem .95rem;background:#f8fafc;border-bottom:1px solid var(--cc-border);
              color:var(--cc-navy);font-size:.92rem;font-weight:800;
            }
            .cc-form-card-body{padding:.95rem}
            .cc-form-card .form-label{font-size:.82rem;font-weight:700;color:#475569;margin-bottom:.3rem}
            .cc-form-card .form-control,.cc-form-card .form-select{padding:.6rem .72rem;border-radius:9px;font-size:.88rem}
            .cc-form-card textarea.form-control{min-height:105px}
            .cc-help{display:block;margin-top:.28rem;color:var(--cc-muted);font-size:.73rem}
            .cc-priority{display:flex;flex-wrap:wrap;gap:.4rem}
            .cc-priority .btn{font-size:.76rem;padding:.42rem .65rem;border-radius:999px}
            .photo-preview{max-width:150px;max-height:150px;margin-top:.7rem;border-radius:10px;display:none}
            .cc-submit-row{display:flex;justify-content:space-between;align-items:center;gap:.7rem;margin-top:1.1rem}
            .cc-submit-row .btn{font-size:.86rem;font-weight:700;border-radius:10px;padding:.65rem .95rem}

            @media(max-width:991.98px){
              .cc-hero-service-strip{grid-template-columns:repeat(2,minmax(0,1fr))}
              .cc-section{padding:36px 0}
            }
            @media(max-width:767.98px){
              .cc-services-hero{padding:26px 0 24px}
              .cc-hero-service-strip{grid-template-columns:1fr 1fr}
              .cc-submit-row{flex-direction:column-reverse;align-items:stretch}
              .cc-submit-row .btn{width:100%}
            }
          </style>

          <section class="cc-services-hero">
            <div class="container">
              <div class="cc-kicker mb-3"><i class="bi bi-printer"></i><span>Servicios para empresas</span></div>
              <h1 class="cc-title mb-3">Soluciones de impresión y soporte técnico</h1>
              <p class="mb-3">Alquiler, venta, servicio técnico, repuestos y monitoreo MPS para mantener la operación de impresión de tu empresa.</p>

              <div class="d-flex flex-wrap gap-2 cc-hero-actions">
                <a href="/cotizacion/form" class="btn btn-primary"><i class="bi bi-file-earmark-text me-1"></i>Solicitar cotización</a>
                <a href="https://wa.me/51975399303?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20sus%20servicios."
                   target="_blank" rel="noopener" class="btn cc-btn-whatsapp">
                  <i class="bi bi-whatsapp me-1"></i>WhatsApp
                </a>
              </div>

              <div class="cc-hero-service-strip">
                <div class="cc-hero-chip"><i class="bi bi-printer"></i>Alquiler</div>
                <div class="cc-hero-chip"><i class="bi bi-tag"></i>Venta</div>
                <div class="cc-hero-chip"><i class="bi bi-tools"></i>Servicio técnico</div>
                <div class="cc-hero-chip"><i class="bi bi-box-seam"></i>Repuestos</div>
                <div class="cc-hero-chip"><i class="bi bi-bar-chart-line"></i>MPS</div>
              </div>
            </div>
          </section>

          <section class="cc-section bg-white">
            <div class="container">
              <div class="text-center mb-4">
                <h2 class="cc-section-title mb-2">Nuestros servicios</h2>
                <p class="cc-muted mb-0">Lo principal, explicado de forma clara y directa.</p>
              </div>

              <div class="row g-3">
                <div class="col-lg-4 col-md-6">
                  <div class="cc-service-card">
                    <div class="cc-service-image-wrap">
                      <img src="/copier_company/static/img/services/alquiler.png"
                           alt="Alquiler de fotocopiadoras"
                           class="cc-service-image"/>
                      <span class="cc-service-tag"><i class="bi bi-printer me-1"></i>Alquiler</span>
                    </div>
                    <span class="cc-service-icon"><i class="bi bi-printer"></i></span>
                    <h3>Alquiler de equipos</h3>
                    <p>Planes de alquiler de equipos multifuncionales para diferentes volúmenes de impresión.</p>
                    <ul>
                      <li><i class="bi bi-check-circle-fill"></i><span>Equipos multifuncionales</span></li>
                      <li><i class="bi bi-check-circle-fill"></i><span>Mantenimiento y soporte según el plan</span></li>
                      <li><i class="bi bi-check-circle-fill"></i><span>Alternativas B/N y color</span></li>
                    </ul>
                    <div class="d-flex flex-wrap gap-2">
                      <a href="/cotizacion/form" class="btn btn-sm btn-primary"><i class="bi bi-calculator me-1"></i>Cotizar alquiler</a>
                      <a href="https://wa.me/51975399303?text=Hola%2C%20quisiera%20cotizar%20el%20alquiler%20de%20una%20fotocopiadora."
                         target="_blank" rel="noopener" class="btn btn-sm btn-outline-success"><i class="bi bi-whatsapp me-1"></i>Consultar</a>
                    </div>
                  </div>
                </div>

                <div class="col-lg-4 col-md-6">
                  <div class="cc-service-card">
                    <div class="cc-service-image-wrap">
                      <img src="/copier_company/static/img/services/venta.png"
                           alt="Venta de equipos multifuncionales"
                           class="cc-service-image"/>
                      <span class="cc-service-tag"><i class="bi bi-tag me-1"></i>Venta</span>
                    </div>
                    <span class="cc-service-icon"><i class="bi bi-tag"></i></span>
                    <h3>Venta de equipos</h3>
                    <p>Equipos multifuncionales para empresas que requieren renovar o ampliar su capacidad de impresión.</p>
                    <ul>
                      <li><i class="bi bi-check-circle-fill"></i><span>Ricoh, Konica Minolta y Canon</span></li>
                      <li><i class="bi bi-check-circle-fill"></i><span>Asesoría según volumen de trabajo</span></li>
                      <li><i class="bi bi-check-circle-fill"></i><span>Opciones para oficina y producción</span></li>
                    </ul>
                    <div class="d-flex flex-wrap gap-2">
                      <a href="/cotizacion/form" class="btn btn-sm btn-primary"><i class="bi bi-file-earmark-text me-1"></i>Cotizar equipo</a>
                      <a href="https://wa.me/51975399303?text=Hola%2C%20quisiera%20informaci%C3%B3n%20para%20comprar%20una%20fotocopiadora."
                         target="_blank" rel="noopener" class="btn btn-sm btn-outline-success"><i class="bi bi-whatsapp me-1"></i>Consultar</a>
                    </div>
                  </div>
                </div>

                <div class="col-lg-4 col-md-6">
                  <div class="cc-service-card">
                    <div class="cc-service-image-wrap">
                      <img src="/copier_company/static/img/services/servicio_tecnico.png"
                           alt="Servicio técnico de fotocopiadoras"
                           class="cc-service-image"/>
                      <span class="cc-service-tag"><i class="bi bi-tools me-1"></i>Soporte</span>
                    </div>
                    <span class="cc-service-icon"><i class="bi bi-tools"></i></span>
                    <h3>Servicio técnico</h3>
                    <p>Diagnóstico, mantenimiento y reparación de equipos multifuncionales.</p>
                    <ul>
                      <li><i class="bi bi-check-circle-fill"></i><span>Mantenimiento preventivo</span></li>
                      <li><i class="bi bi-check-circle-fill"></i><span>Reparación y diagnóstico</span></li>
                      <li><i class="bi bi-check-circle-fill"></i><span>Atención de incidencias</span></li>
                    </ul>
                    <div class="d-flex flex-wrap gap-2">
                      <a href="/contactus" class="btn btn-sm btn-primary"><i class="bi bi-tools me-1"></i>Solicitar servicio</a>
                      <a href="https://wa.me/51975399303?text=Hola%2C%20necesito%20servicio%20t%C3%A9cnico%20para%20una%20fotocopiadora."
                         target="_blank" rel="noopener" class="btn btn-sm btn-outline-success"><i class="bi bi-whatsapp me-1"></i>WhatsApp</a>
                    </div>
                  </div>
                </div>

                <div class="col-lg-6 col-md-6">
                  <div class="cc-service-card">
                    <div class="cc-service-image-wrap">
                      <img src="/copier_company/static/img/services/repuestos.png"
                           alt="Repuestos y consumibles"
                           class="cc-service-image"/>
                      <span class="cc-service-tag"><i class="bi bi-box-seam me-1"></i>Repuestos</span>
                    </div>
                    <span class="cc-service-icon"><i class="bi bi-box-seam"></i></span>
                    <h3>Repuestos y consumibles</h3>
                    <p>Suministro de repuestos y consumibles para los equipos y marcas que atendemos.</p>
                    <ul>
                      <li><i class="bi bi-check-circle-fill"></i><span>Tóner y consumibles</span></li>
                      <li><i class="bi bi-check-circle-fill"></i><span>Repuestos para mantenimiento y reparación</span></li>
                    </ul>
                    <div class="d-flex flex-wrap gap-2">
                      <a href="https://wa.me/51975399303?text=Hola%2C%20quisiera%20consultar%20la%20disponibilidad%20de%20un%20repuesto%20o%20t%C3%B3ner."
                         target="_blank" rel="noopener" class="btn btn-sm btn-primary"><i class="bi bi-whatsapp me-1"></i>Consultar repuesto</a>
                      <a href="/contactus" class="btn btn-sm btn-outline-primary">Contacto</a>
                    </div>
                  </div>
                </div>

                <div class="col-lg-6 col-md-6">
                  <div class="cc-service-card">
                    <div class="cc-service-image-wrap">
                      <img src="/copier_company/static/img/services/mps.png"
                           alt="Monitoreo MPS"
                           class="cc-service-image"/>
                      <span class="cc-service-tag"><i class="bi bi-bar-chart-line me-1"></i>MPS</span>
                    </div>
                    <span class="cc-service-icon"><i class="bi bi-bar-chart-line"></i></span>
                    <h3>Monitoreo MPS</h3>
                    <p>Herramientas para facilitar el seguimiento de equipos compatibles dentro de tu flota.</p>
                    <ul>
                      <li><i class="bi bi-check-circle-fill"></i><span>Lecturas de contadores</span></li>
                      <li><i class="bi bi-check-circle-fill"></i><span>Seguimiento de consumibles</span></li>
                      <li><i class="bi bi-check-circle-fill"></i><span>Información centralizada</span></li>
                    </ul>
                    <div class="d-flex flex-wrap gap-2">
                      <a href="https://app.printtrackerpro.com/auth/login" target="_blank" rel="noopener" class="btn btn-sm btn-primary">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Acceder a MPS
                      </a>
                      <a href="https://wa.me/51975399303?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20el%20servicio%20de%20monitoreo%20MPS."
                         target="_blank" rel="noopener" class="btn btn-sm btn-outline-success"><i class="bi bi-whatsapp me-1"></i>Consultar MPS</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="cc-section cc-soft">
            <div class="container">
              <div class="text-center mb-4">
                <h2 class="cc-section-title mb-2">¿Cómo trabajamos?</h2>
                <p class="cc-muted mb-0">Un proceso simple para encontrar la solución adecuada.</p>
              </div>
              <div class="row g-3">
                <div class="col-md-4">
                  <div class="cc-step">
                    <span class="cc-step-number">1</span>
                    <h4>Revisamos tu necesidad</h4>
                    <p>Volumen, tipo de impresión, número de usuarios y requerimientos del equipo.</p>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="cc-step">
                    <span class="cc-step-number">2</span>
                    <h4>Proponemos una solución</h4>
                    <p>Definimos la alternativa de alquiler, venta, soporte o monitoreo que corresponda.</p>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="cc-step">
                    <span class="cc-step-number">3</span>
                    <h4>Coordinamos la atención</h4>
                    <p>Se programa la entrega, instalación o intervención técnica según el servicio solicitado.</p>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="cc-section bg-white">
            <div class="container">
              <div class="cc-services-cta">
                <div class="row align-items-center g-3">
                  <div class="col-lg-8">
                    <h2 class="mb-2">¿Qué solución necesita tu empresa?</h2>
                    <p>Cuéntanos qué equipo utilizas o qué necesitas mejorar y te ayudamos a definir la opción adecuada.</p>
                    <div class="d-flex flex-wrap gap-2">
                      <a href="/cotizacion/form" class="btn btn-light text-primary fw-bold">Solicitar cotización</a>
                      <a href="https://wa.me/51975399303?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20sus%20servicios."
                         target="_blank" rel="noopener" class="btn btn-outline-light fw-semibold">
                        <i class="bi bi-whatsapp me-1"></i>WhatsApp
                      </a>
                    </div>
                  </div>
                  <div class="col-lg-4 text-center d-none d-lg-block">
                    <i class="bi bi-printer" style="font-size:3.5rem;opacity:.8;"></i>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>
      </t>
    </template>

    <template id="portal_service_request" name="Solicitud de Servicio Técnico">
      <t t-call="portal.frontend_layout">
        <t t-set="additional_title">Solicitar Servicio Técnico</t>
        <t t-set="head">
          <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet"/>
        </t>

        <div class="cc-services-page">
          <div class="cc-form-header">
            <div class="container">
              <h1><i class="bi bi-tools me-2"></i>Solicitar servicio técnico</h1>
              <p>Registra la incidencia y los datos necesarios para que podamos atenderla.</p>
            </div>
          </div>

          <div class="container">
            <div class="cc-form-wrap">

              <t t-if="from_qr">
                <div class="alert alert-info py-2 px-3 mb-3">
                  <i class="bi bi-qr-code me-2"></i>
                  Acceso mediante código QR. Complete los datos de contacto para registrar la solicitud.
                </div>
              </t>

              <t t-if="success_message">
                <div class="alert alert-success mb-3">
                  <div class="d-flex gap-3 align-items-start">
                    <i class="bi bi-check-circle-fill fs-3"></i>
                    <div>
                      <h5 class="fw-bold mb-2">Solicitud creada correctamente</h5>
                      <div t-out="success_message"/>
                      <t t-if="request_data">
                        <div class="small mt-2">
                          <strong>Número:</strong> <span t-esc="request_data.get('number')"/>
                          <span class="mx-2">·</span>
                          <strong>Estado:</strong> <span t-esc="request_data.get('estado')"/>
                        </div>
                      </t>
                      <a t-attf-href="/public/equipment_menu?copier_company_id=#{equipment.id}"
                         class="btn btn-sm btn-success mt-3">
                        <i class="bi bi-arrow-left me-1"></i>Volver al menú
                      </a>
                    </div>
                  </div>
                </div>
              </t>

              <t t-if="error_message">
                <div class="alert alert-danger mb-3">
                  <i class="bi bi-exclamation-triangle-fill me-2"></i>
                  <span t-esc="error_message"/>
                </div>
              </t>

              <t t-if="not success_message">
                <div class="cc-info-panel mb-3">
                  <h5 class="mb-2"><i class="bi bi-printer me-2"></i>Información del equipo</h5>
                  <div class="row g-2">
                    <div class="col-md-4">
                      <p><strong>Equipo:</strong> <span t-esc="equipment_data.get('name')"/></p>
                      <p><strong>Serie:</strong> <span t-esc="equipment_data.get('serie')"/></p>
                    </div>
                    <div class="col-md-4">
                      <p><strong>Marca:</strong> <span t-esc="equipment_data.get('marca')"/></p>
                      <p><strong>Tipo:</strong> <span t-esc="equipment_data.get('tipo')"/></p>
                    </div>
                    <div class="col-md-4">
                      <p><strong>Cliente:</strong> <span t-esc="equipment_data.get('cliente_name')"/></p>
                      <p><strong>Ubicación:</strong> <span t-esc="equipment_data.get('ubicacion')"/></p>
                    </div>
                  </div>
                </div>

                <form method="POST" enctype="multipart/form-data" id="serviceForm">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                  <div class="cc-form-card">
                    <div class="cc-form-card-header"><i class="bi bi-person me-2"></i>Datos de contacto</div>
                    <div class="cc-form-card-body">

                      <t t-if="not is_logged">
                        <div class="row g-3">
                          <div class="col-md-4">
                            <label class="form-label" for="contacto">Nombre completo *</label>
                            <input type="text" class="form-control" id="contacto" name="contacto"
                                   t-att-value="contact_data.get('contacto', '')"
                                   placeholder="Nombre de la persona que reporta" required="required"/>
                          </div>
                          <div class="col-md-4">
                            <label class="form-label" for="correo">Correo *</label>
                            <input type="email" class="form-control" id="correo" name="correo"
                                   t-att-value="contact_data.get('correo', '')"
                                   placeholder="correo@empresa.com" required="required"/>
                          </div>
                          <div class="col-md-4">
                            <label class="form-label" for="telefono_contacto">Celular *</label>
                            <input type="tel" class="form-control" id="telefono_contacto" name="telefono_contacto"
                                   t-att-value="contact_data.get('telefono_contacto', '')"
                                   placeholder="987654321" pattern="[0-9]{9,15}" required="required"/>
                          </div>
                        </div>
                      </t>

                      <t t-else="">
                        <input type="hidden" name="contacto" t-att-value="contact_data.get('contacto', '')"/>
                        <input type="hidden" name="correo" t-att-value="contact_data.get('correo', '')"/>
                        <input type="hidden" name="telefono_contacto" t-att-value="contact_data.get('telefono_contacto', '')"/>

                        <div class="small">
                          <strong><t t-esc="contact_data.get('contacto')"/></strong>
                          <span class="mx-2">·</span>
                          <t t-esc="contact_data.get('correo')"/>
                          <span class="mx-2">·</span>
                          <t t-esc="contact_data.get('telefono_contacto')"/>
                        </div>
                      </t>
                    </div>
                  </div>

                  <div class="cc-form-card">
                    <div class="cc-form-card-header"><i class="bi bi-exclamation-circle me-2"></i>Detalle de la incidencia</div>
                    <div class="cc-form-card-body">

                      <div class="row g-3">
                        <div class="col-md-6">
                          <label class="form-label" for="tipo_problema_id">Tipo de problema *</label>
                          <select class="form-select" id="tipo_problema_id" name="tipo_problema_id" required="required">
                            <option value="">Seleccione un tipo</option>
                            <t t-foreach="problem_types" t-as="ptype">
                              <option t-att-value="ptype.id"><t t-esc="ptype.icono"/> <t t-esc="ptype.name"/></option>
                            </t>
                          </select>
                        </div>

                        <div class="col-md-6">
                          <label class="form-label d-block">Prioridad *</label>
                          <div class="cc-priority">
                            <input type="radio" class="btn-check" name="prioridad" id="prioridad_baja" value="0"/>
                            <label class="btn btn-outline-success" for="prioridad_baja">Baja</label>

                            <input type="radio" class="btn-check" name="prioridad" id="prioridad_normal" value="1" checked="checked"/>
                            <label class="btn btn-outline-primary" for="prioridad_normal">Normal</label>

                            <input type="radio" class="btn-check" name="prioridad" id="prioridad_alta" value="2"/>
                            <label class="btn btn-outline-warning" for="prioridad_alta">Alta</label>

                            <input type="radio" class="btn-check" name="prioridad" id="prioridad_critica" value="3"/>
                            <label class="btn btn-outline-danger" for="prioridad_critica">Crítica</label>
                          </div>
                        </div>
                      </div>

                      <div class="mt-3">
                        <label class="form-label" for="problema_reportado">Descripción detallada *</label>
                        <textarea class="form-control" id="problema_reportado" name="problema_reportado" rows="4"
                                  placeholder="Describa qué ocurre, desde cuándo y si aparece algún código o mensaje de error."
                                  required="required"></textarea>
                        <span class="cc-help">Incluya códigos de error, mensajes de pantalla o comportamiento observado.</span>
                      </div>

                      <div class="mt-3">
                        <label class="form-label" for="foto_antes">Foto del problema</label>
                        <input type="file" class="form-control" id="foto_antes" name="foto_antes"
                               accept="image/*" onchange="previewImage(this)"/>
                        <span class="cc-help">Opcional. Puede adjuntar una foto del error o del equipo.</span>
                        <img id="imagePreview" class="photo-preview img-thumbnail" alt="Vista previa"/>
                      </div>
                    </div>
                  </div>

                  <div class="cc-submit-row">
                    <a t-attf-href="/public/equipment_menu?copier_company_id=#{equipment.id}"
                       class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Enviar solicitud</button>
                  </div>
                </form>
              </t>
            </div>
          </div>

          <script>
            function previewImage(input) {
              const preview = document.getElementById('imagePreview');
              if (input.files &amp;&amp; input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                  preview.src = e.target.result;
                  preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
              } else {
                preview.style.display = 'none';
              }
            }

            (function() {
              'use strict';
              const form = document.getElementById('serviceForm');
              if (form) {
                form.addEventListener('submit', function(event) {
                  if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                  }
                  form.classList.add('was-validated');
                }, false);
              }
            })();
          </script>
        </div>
      </t>
    </template>
  </data>
</odoo>
