<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- PLANTILLA 1: CONFIRMACIÓN DE SOLICITUD                    -->
    <!-- ========================================================= -->
    <record id="email_template_service_confirmacion" model="mail.template">
        <field name="name">Servicio Técnico - Confirmación de Solicitud</field>
        <field name="model_id" ref="model_copier_service_request"/>
        <field name="email_from">info@copiercompanysac.com</field>
        <field name="email_to">{{ object.correo }}</field>
        <field name="subject">Solicitud {{ object.name }} recibida - Copier Company</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html"><![CDATA[
<div style="margin:0;padding:0;background-color:#f3f6fa;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#f3f6fa;margin:0;padding:0;">
        <tr>
            <td align="center" style="padding:32px 12px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;background-color:#ffffff;border:1px solid #e5e7eb;border-radius:18px;overflow:hidden;">

                    <tr>
                        <td style="height:5px;background-color:#2563eb;font-size:0;line-height:0;">&nbsp;</td>
                    </tr>

                    <tr>
                        <td style="padding:30px 34px 22px 34px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td>
                                        <div style="font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#64748b;margin-bottom:8px;">
                                            COPIER COMPANY · SERVICIO TÉCNICO
                                        </div>
                                        <h1 style="margin:0;font-size:26px;line-height:1.25;color:#0f172a;font-weight:700;">
                                            Solicitud recibida
                                        </h1>
                                        <p style="margin:9px 0 0 0;font-size:15px;line-height:1.6;color:#64748b;">
                                            Hemos registrado correctamente tu solicitud de atención.
                                        </p>
                                    </td>
                                    <td width="64" align="right" valign="top">
                                        <div style="width:52px;height:52px;line-height:52px;text-align:center;background-color:#eff6ff;border-radius:14px;font-size:24px;">
                                            ✓
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:0 34px 30px 34px;">
                            <p style="margin:0 0 20px 0;font-size:15px;line-height:1.7;color:#334155;">
                                Hola <strong><t t-out="object.contacto or 'Cliente'"/></strong>,
                            </p>

                            <p style="margin:0 0 24px 0;font-size:15px;line-height:1.7;color:#475569;">
                                Recibimos tu solicitud de servicio técnico. Nuestro equipo la revisará y te notificaremos cuando la atención sea programada.
                            </p>

                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;margin-bottom:24px;">
                                <tr>
                                    <td style="padding:20px 22px;">
                                        <div style="font-size:12px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:#64748b;margin-bottom:14px;">
                                            Resumen de la solicitud
                                        </div>
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;width:38%;">Solicitud</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;font-weight:700;"><t t-out="object.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Equipo</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.modelo_maquina.name or 'N/A'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Serie</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.serie_maquina or 'N/A'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Ubicación</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.ubicacion or 'N/A'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Tipo de problema</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.tipo_problema_id.name or 'N/A'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Prioridad</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;">
                                                    <t t-if="object.prioridad == '3'">Crítica</t>
                                                    <t t-elif="object.prioridad == '2'">Alta</t>
                                                    <t t-elif="object.prioridad == '1'">Normal</t>
                                                    <t t-else="">Baja</t>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <t t-if="object.problema_reportado">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin-bottom:24px;">
                                    <tr>
                                        <td style="padding:16px 18px;background-color:#fff7ed;border-left:4px solid #f59e0b;border-radius:10px;">
                                            <div style="font-size:12px;font-weight:700;color:#9a3412;text-transform:uppercase;letter-spacing:.7px;margin-bottom:7px;">
                                                Problema reportado
                                            </div>
                                            <div style="font-size:14px;line-height:1.6;color:#7c2d12;white-space:pre-line;">
                                                <t t-out="object.problema_reportado"/>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </t>

                            <t t-if="object.tracking_url">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td align="center" style="padding:4px 0 8px 0;">
                                            <a t-att-href="object.tracking_url"
                                               style="display:inline-block;background-color:#2563eb;color:#ffffff;text-decoration:none;font-size:14px;font-weight:700;padding:13px 24px;border-radius:10px;">
                                                Ver seguimiento
                                            </a>
                                        </td>
                                    </tr>
                                </table>
                            </t>

                            <p style="margin:18px 0 0 0;font-size:12px;line-height:1.6;color:#94a3b8;text-align:center;">
                                Puedes volver a consultar el estado de tu solicitud desde el enlace de seguimiento.
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:20px 28px;background-color:#f8fafc;border-top:1px solid #e5e7eb;text-align:center;">
                            <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:6px;">Copier Company S.A.C.</div>
                            <div style="font-size:12px;line-height:1.7;color:#64748b;">
                                info@copiercompanysac.com · +51 975 399 303 · www.copiercompanysac.com
                            </div>
                            <div style="margin-top:8px;font-size:11px;color:#94a3b8;">
                                Solicitud <t t-out="object.name"/>
                            </div>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</div>
        ]]></field>
    </record>


    <!-- ========================================================= -->
    <!-- PLANTILLA 2: TÉCNICO ASIGNADO                             -->
    <!-- ========================================================= -->
    <record id="email_template_service_tecnico_asignado" model="mail.template">
        <field name="name">Servicio Técnico - Técnico Asignado</field>
        <field name="model_id" ref="model_copier_service_request"/>
        <field name="email_from">info@copiercompanysac.com</field>
        <field name="email_to">{{ object.correo }}</field>
        <field name="subject">Técnico asignado - Solicitud {{ object.name }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html"><![CDATA[
<div style="margin:0;padding:0;background-color:#f3f6fa;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#f3f6fa;">
        <tr>
            <td align="center" style="padding:32px 12px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;background-color:#ffffff;border:1px solid #e5e7eb;border-radius:18px;overflow:hidden;">

                    <tr>
                        <td style="height:5px;background-color:#0f9f6e;font-size:0;line-height:0;">&nbsp;</td>
                    </tr>

                    <tr>
                        <td style="padding:30px 34px 22px 34px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td>
                                        <div style="font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#64748b;margin-bottom:8px;">
                                            COPIER COMPANY · SERVICIO PROGRAMADO
                                        </div>
                                        <h1 style="margin:0;font-size:26px;line-height:1.25;color:#0f172a;font-weight:700;">
                                            Técnico asignado
                                        </h1>
                                        <p style="margin:9px 0 0 0;font-size:15px;line-height:1.6;color:#64748b;">
                                            La atención de tu solicitud ya fue programada.
                                        </p>
                                    </td>
                                    <td width="64" align="right" valign="top">
                                        <div style="width:52px;height:52px;line-height:52px;text-align:center;background-color:#ecfdf5;border-radius:14px;font-size:24px;">
                                            👨‍🔧
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:0 34px 30px 34px;">
                            <p style="margin:0 0 22px 0;font-size:15px;line-height:1.7;color:#334155;">
                                Hola <strong><t t-out="object.contacto or 'Cliente'"/></strong>,
                            </p>

                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#f0fdf4;border:1px solid #bbf7d0;border-radius:14px;margin-bottom:20px;">
                                <tr>
                                    <td style="padding:20px 22px;">
                                        <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#15803d;margin-bottom:14px;">
                                            Datos del técnico
                                        </div>
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;width:38%;">Técnico</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;font-weight:700;"><t t-out="object.tecnico_id.name or 'Por asignar'"/></td>
                                            </tr>
                                            <tr t-if="object.tecnico_id.vat">
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">DNI</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.tecnico_id.vat"/></td>
                                            </tr>
                                            <tr t-if="object.vehicle_info">
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Vehículo</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.vehicle_info"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Fecha programada</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;font-weight:700;">
                                                    <t t-if="object.fecha_programada">
                                                        <t t-out="format_datetime(object.fecha_programada, dt_format='dd/MM/yyyy', tz=object.env.user.tz or 'America/Lima')"/>
                                                        ·
                                                        <t t-out="format_datetime(object.fecha_programada, dt_format='hh:mm a', tz=object.env.user.tz or 'America/Lima')"/>
                                                    </t>
                                                    <t t-else="">Por confirmar</t>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:14px;margin-bottom:22px;">
                                <tr>
                                    <td style="padding:20px 22px;">
                                        <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#64748b;margin-bottom:14px;">
                                            Equipo a atender
                                        </div>
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;width:38%;">Cliente</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.cliente_id.name or 'N/A'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Equipo</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.modelo_maquina.name or 'N/A'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Serie</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.serie_maquina or 'N/A'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Ubicación</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.ubicacion or 'N/A'"/></td>
                                            </tr>
                                            <tr t-if="object.sede">
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Sede</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.sede"/></td>
                                            </tr>
                                            <tr t-if="object.tipo_problema_id">
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Tipo de problema</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.tipo_problema_id.name"/></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <t t-if="object.problema_reportado">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin-bottom:22px;">
                                    <tr>
                                        <td style="padding:16px 18px;background-color:#fff7ed;border-left:4px solid #f59e0b;border-radius:10px;">
                                            <div style="font-size:12px;font-weight:700;color:#9a3412;text-transform:uppercase;letter-spacing:.7px;margin-bottom:7px;">
                                                Problema reportado
                                            </div>
                                            <div style="font-size:14px;line-height:1.6;color:#7c2d12;white-space:pre-line;">
                                                <t t-out="object.problema_reportado"/>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </t>

                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#eff6ff;border-radius:12px;margin-bottom:22px;">
                                <tr>
                                    <td style="padding:16px 18px;">
                                        <div style="font-size:13px;font-weight:700;color:#1d4ed8;margin-bottom:6px;">Antes de la visita</div>
                                        <div style="font-size:13px;line-height:1.7;color:#475569;">
                                            Procura que el equipo y el área de trabajo estén accesibles, y que haya una persona disponible para recibir al técnico.
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <t t-if="object.tracking_url">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                        <td align="center" style="padding:4px 0 8px 0;">
                                            <a t-att-href="object.tracking_url"
                                               style="display:inline-block;background-color:#0f9f6e;color:#ffffff;text-decoration:none;font-size:14px;font-weight:700;padding:13px 24px;border-radius:10px;">
                                                Ver seguimiento
                                            </a>
                                        </td>
                                    </tr>
                                </table>
                            </t>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:20px 28px;background-color:#f8fafc;border-top:1px solid #e5e7eb;text-align:center;">
                            <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:6px;">Copier Company S.A.C.</div>
                            <div style="font-size:12px;line-height:1.7;color:#64748b;">
                                info@copiercompanysac.com · +51 975 399 303 · www.copiercompanysac.com
                            </div>
                            <div style="margin-top:8px;font-size:11px;color:#94a3b8;">
                                Solicitud <t t-out="object.name"/>
                            </div>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</div>
        ]]></field>
    </record>


    <!-- ========================================================= -->
    <!-- PLANTILLA 3: SERVICIO COMPLETADO                          -->
    <!-- ========================================================= -->
    <record id="email_template_service_completado" model="mail.template">
        <field name="name">Servicio Técnico - Servicio Completado</field>
        <field name="model_id" ref="model_copier_service_request"/>
        <field name="email_from">info@copiercompanysac.com</field>
        <field name="email_to">{{ object.correo }}</field>
        <field name="subject">Servicio completado - Solicitud {{ object.name }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html"><![CDATA[
<div style="margin:0;padding:0;background-color:#f3f6fa;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#f3f6fa;">
        <tr>
            <td align="center" style="padding:32px 12px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;background-color:#ffffff;border:1px solid #e5e7eb;border-radius:18px;overflow:hidden;">

                    <tr>
                        <td style="height:5px;background-color:#10b981;font-size:0;line-height:0;">&nbsp;</td>
                    </tr>

                    <tr>
                        <td style="padding:30px 34px 22px 34px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td>
                                        <div style="font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#64748b;margin-bottom:8px;">
                                            COPIER COMPANY · ATENCIÓN FINALIZADA
                                        </div>
                                        <h1 style="margin:0;font-size:26px;line-height:1.25;color:#0f172a;font-weight:700;">
                                            Servicio completado
                                        </h1>
                                        <p style="margin:9px 0 0 0;font-size:15px;line-height:1.6;color:#64748b;">
                                            La atención técnica ha finalizado.
                                        </p>
                                    </td>
                                    <td width="64" align="right" valign="top">
                                        <div style="width:52px;height:52px;line-height:52px;text-align:center;background-color:#ecfdf5;border-radius:14px;font-size:24px;color:#059669;">
                                            ✓
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:0 34px 30px 34px;">
                            <p style="margin:0 0 22px 0;font-size:15px;line-height:1.7;color:#334155;">
                                Hola <strong><t t-out="object.contacto or 'Cliente'"/></strong>,
                            </p>

                            <p style="margin:0 0 24px 0;font-size:15px;line-height:1.7;color:#475569;">
                                El servicio técnico de tu equipo fue completado. A continuación encontrarás el resumen de la atención.
                            </p>

                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#f0fdf4;border:1px solid #bbf7d0;border-radius:14px;margin-bottom:22px;">
                                <tr>
                                    <td style="padding:20px 22px;">
                                        <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#15803d;margin-bottom:14px;">
                                            Resumen del servicio
                                        </div>
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;width:38%;">Solicitud</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;font-weight:700;"><t t-out="object.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Técnico</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.tecnico_id.name or 'N/A'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Finalizado</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;">
                                                    <t t-if="object.fecha_fin">
                                                        <t t-out="format_datetime(object.fecha_fin, dt_format='dd/MM/yyyy', tz='America/Lima')"/>
                                                        ·
                                                        <t t-out="format_datetime(object.fecha_fin, dt_format='hh:mm a', tz='America/Lima')"/>
                                                    </t>
                                                    <t t-else="">N/A</t>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Equipo</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;">
                                                    <t t-out="object.modelo_maquina.name or 'N/A'"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0;font-size:13px;color:#64748b;">Serie</td>
                                                <td style="padding:6px 0;font-size:14px;color:#0f172a;"><t t-out="object.serie_maquina or 'N/A'"/></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <t t-if="object.trabajo_realizado">
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin-bottom:20px;">
                                    <tr>
                                        <td style="padding:18px 20px;background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;">
                                            <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#64748b;margin-bottom:8px;">
