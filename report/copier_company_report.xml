<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_report_report_cotizacion_alquiler" model="ir.actions.report">
            <field name="name">Propuesta Comercial de Alquiler</field>
            <field name="model">copier.company</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">copier_company.cotizacion_view</field>
            <field name="report_file">copier_company.cotizacion_view</field>
            <field name="print_report_name">'Propuesta Comercial - %s' % object.secuencia</field>
            <field name="binding_model_id" ref="model_copier_company" />
            <field name="binding_type">report</field>
        </record>

        <template id="cotizacion_view">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <!-- CSS -->
                        <link rel="stylesheet" href="/copier_company/static/src/css/cotizacion_styles.css"/>

                        <!-- Mejoras visuales acotadas: conserva el CSS y external_layout existentes -->
                        <style type="text/css">
                          .main-header { background:#17365b; color:#fff; padding:20px 22px; border-radius:9px; margin:0 0 18px; }
                          .main-header h1 { color:#fff !important; font-size:23px !important; font-weight:700; }
                          .main-header p { color:#deebf7; font-size:11px; margin-bottom:0; }
                          .section { margin-bottom:14px; page-break-inside:avoid; }
                          .section-header { background:#eff5fb; border-left:4px solid #1978aa; padding:9px 12px; font-weight:700; color:#17365b; }
                          .tariff-section h4 { background:#e9f3fb; padding:8px 10px; color:#17365b; }
                          .benefits-list li { padding:4px 0; }
                          .total-section { border:1px solid #d5e5f4; border-radius:7px; padding:10px; background:#f1f7fc; }
                          .cc-description-block { white-space:pre-line; font-size:11px; line-height:1.5; padding:12px; background:#f7f9fc; border:1px solid #e5edf5; }
                          .cc-contract-table { width:100%; border-collapse:collapse; font-size:11px; }
                          .cc-contract-table td { padding:7px 9px; border-bottom:1px solid #e8eff6; width:50%; }
                          .cc-tax-hint { background:#fff4e6; border-left:3px solid #dc8d30; padding:9px 12px; font-size:10px; margin-top:9px; }
                        </style>

                        <!-- ENCABEZADO -->
                        <div class="main-header">
                            <div class="flex-between">
                                <h1 style="font-size: 1.75rem; margin: 0;">
                                    COPIER COMPANY SAC · Propuesta Comercial N° <t t-esc="doc.secuencia" />
                                </h1>
                            </div>
                            <p style="margin-top: 1rem;">
                                <t t-esc="doc.fecha_formateada"/>
                            </p>
                        </div>

                        <!-- INFORMACIÓN DEL CLIENTE -->
                        <div class="section">
                            <div class="section-header">
                                <i class="fa fa-user-circle"></i>
                                <span>Información del Cliente</span>
                            </div>
                            <div class="data-grid">
                                <div class="data-row">
                                    <span class="label">Atención:</span>
                                    <span class="value">
                                        <t t-esc="doc.cliente_id.name" />
                                    </span>
                                </div>
                                <div class="data-row">
                                    <span class="label">RUC/DNI:</span>
                                    <span class="value">
                                        <t t-esc="doc.identificacion" />
                                    </span>
                                </div>
                                <div class="data-row">
                                    <span class="label">Dirección:</span>
                                    <span class="value">
                                        <t t-esc="doc.cliente_id.street" />
                                    </span>
                                </div>
                            </div>
                            <p style="margin-top: 1rem;" class="intro-text">
                                Nos complace presentar nuestra <strong>PROPUESTA COMERCIAL</strong> detallando las especificaciones y condiciones para el arrendamiento del siguiente equipo multifuncional de última generación:
                            </p>
                        </div>

                        <!-- EQUIPO PROPUESTO -->
                        <div class="section">
                            <div class="section-header">
                                <i class="fa fa-print"></i>
                                <span>Equipo Multifuncional</span>
                            </div>
                            <div style="text-align: center;">
                                <h3 style="color: var(--primary-blue);">
                                    <t t-esc="doc.name.name" />
                                </h3>
                                <t t-if="doc.imagen_id">
                                    <img
                                        t-att-src="'data:image/png;base64,%s' % doc.imagen_id.decode('utf-8')"
                                        class="machine-image" />
                                </t>
                            </div>
                            <t t-if="doc.especificaciones_id">
                                <div class="specs-section">
                                    <t t-raw="doc.especificaciones_id" />
                                </div>
                            </t>
                        </div>

                        <!-- DESCRIPCIÓN: se prioriza la edición manual del modelo -->
                        <div class="section" t-if="doc.descripcion_cotizacion_final">
                            <div class="section-header"><span>Descripción comercial del equipo</span></div>
                            <div class="cc-description-block"><t t-esc="doc.descripcion_cotizacion_final"/></div>
                        </div>

                        <!-- RESUMEN DEL CONTRATO: usa campos reales -->
                        <div class="section">
                            <div class="section-header"><span>Plazo y condiciones del contrato</span></div>
                            <table class="cc-contract-table">
                                <tr><td><strong>Duración:</strong> <t t-esc="doc.duracion_alquiler_id.name or 'Por definir'"/></td><td><strong>Fecha de inicio:</strong> <t t-esc="doc.fecha_inicio_alquiler or 'Por definir'"/></td></tr>
                                <tr><td><strong>Fecha de fin:</strong> <t t-esc="doc.fecha_fin_alquiler or 'Por definir'"/></td><td><strong>Día de facturación:</strong> <t t-esc="doc.dia_facturacion or 'Por definir'"/></td></tr>
                                <tr><td><strong>Moneda:</strong> <t t-esc="doc.currency_id.name or 'PEN'"/></td><td><strong>Condición de pago:</strong> <t t-esc="doc.payment_term_id.name or 'Por definir'"/></td></tr>
                            </table>
                        </div>

                        <!-- DETALLES DE TARIFA -->
                        <div class="section">
                            <div class="section-header">
                                <i class="fa fa-info-circle"></i>
                                <span>Detalles de Tarifa</span>
                            </div>
                            <div class="pricing-details">
                                <!-- TARIFA BLANCO Y NEGRO -->
                                <div class="tariff-section">
                                    <h4><i class="fa fa-print"></i> TARIFA BLANCO Y NEGRO</h4>
                                    <ul class="benefits-list">
                                        <!-- CON VOLUMEN MENSUAL B/N -->
                                        <t t-if="doc.volumen_mensual_bn &gt; 0">
                                            <li>
                                                Volumen mensual:
                                                <strong>
                                                    <t t-esc="'{:,}'.format(doc.volumen_mensual_bn)"/> impresiones
                                                </strong>
                                            </li>
                                            <li>
                                                Costo por impresión dentro del volumen:
                                                <strong>
                                                    S/.
                                                    <t t-esc="'%.3f' % doc.costo_copia_bn"/>
                                                    <t t-if="doc.precio_bn_incluye_igv">
                                                        (incluye IGV)
                                                    </t>
                                                    <t t-else="">
                                                        + IGV
                                                    </t>
                                                </strong>
                                            </li>
                                            <li>
                                                Excedente por impresión:
                                                <strong>S/. <t t-esc="'%.4f' % doc.precio_excedente_bn"/>
                                                    <t t-if="doc.precio_excedente_bn_incluye_igv">(incluye IGV)</t>
                                                    <t t-else="">+ IGV</t></strong>
                                            </li>
                                            <li>
                                                Renta mensual B/N:
                                                <strong>
                                                    S/. <t t-esc="'%.2f' % doc.renta_mensual_bn"/> Sin IGV
                                                </strong>
                                            </li>
                                        </t>
                                        <!-- SIN VOLUMEN MENSUAL B/N: SOLO SE COBRA LO REALIZADO -->
                                        <t t-else="">
                                            <li>
                                                <strong>Sin volumen mensual mínimo.</strong>
                                                Se cobra únicamente por la cantidad efectivamente impresa.
                                            </li>
                                            <li>
                                                Costo por impresión B/N:
                                                <strong>
                                                    S/.
                                                    <t t-esc="'%.3f' % doc.costo_copia_bn"/>
                                                    <t t-if="doc.precio_bn_incluye_igv">
                                                        (incluye IGV)
                                                    </t>
                                                    <t t-else="">
                                                        + IGV
                                                    </t>
                                                </strong>
                                            </li>
                                        </t>
                                    </ul>

                                    <!-- TARIFA COLOR (SOLO SI LA MÁQUINA ES COLOR) -->
                                    <t t-if="doc.tipo == 'color'">
                                        <h4 class="mt-4"><i class="fa fa-paint-brush"></i> TARIFA COLOR</h4>
                                        <ul class="benefits-list">
                                            <!-- CON VOLUMEN MENSUAL COLOR -->
                                            <t t-if="doc.volumen_mensual_color &gt; 0">
                                                <li>
                                                    Volumen mensual:
                                                    <strong>
                                                        <t t-esc="'{:,}'.format(doc.volumen_mensual_color)"/> impresiones
                                                    </strong>
                                                </li>
                                                <li>
                                                    Costo por impresión dentro del volumen:
                                                    <strong>
                                                        S/.
                                                        <t t-esc="'%.2f' % doc.costo_copia_color"/>
                                                        <t t-if="doc.precio_color_incluye_igv">
                                                            (incluye IGV)
                                                        </t>
                                                        <t t-else="">
                                                            + IGV
                                                        </t>
                                                    </strong>
                                                </li>
                                                <li>
                                                    Excedente por impresión:
                                                    <strong>S/. <t t-esc="'%.4f' % doc.precio_excedente_color"/>
                                                    <t t-if="doc.precio_excedente_color_incluye_igv">(incluye IGV)</t>
                                                    <t t-else="">+ IGV</t></strong>
                                                </li>
                                                <li>
                                                    Renta mensual Color:
                                                    <strong>
                                                        S/. <t t-esc="'%.2f' % doc.renta_mensual_color"/> Sin IGV
                                                    </strong>
                                                </li>
                                            </t>
                                            <!-- SIN VOLUMEN MENSUAL COLOR -->
                                            <t t-else="">
                                                <li>
                                                    <strong>Sin volumen mensual mínimo para color.</strong>
                                                    Se cobra únicamente por la cantidad efectivamente impresa.
                                                </li>
                                                <li>
                                                    Costo por impresión Color:
                                                    <strong>
                                                        S/.
                                                        <t t-esc="'%.2f' % doc.costo_copia_color"/>
                                                        <t t-if="doc.precio_color_incluye_igv">
                                                            (incluye IGV)
                                                        </t>
                                                        <t t-else="">
                                                            + IGV
                                                        </t>
                                                    </strong>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>

                                    <div class="cc-tax-hint">
                                        <strong>Tarifa de excedente:</strong> se aplica únicamente al volumen que supere el contratado.
                                        El importe de excedente no forma parte del total mensual base mostrado.
                                    </div>
                                    <!-- TOTAL MENSUAL -->
                                    <div class="total-section">
                                        <div class="total-header">TOTAL MENSUAL A FACTURAR</div>
                                        <div class="total-amount">
                                            <span class="currency">S/.</span>
                                            <span class="amount">
                                                <t t-esc="'%.2f' % doc.total_facturar_mensual"/>
                                            </span>
                                            <span class="tax-note">Inc. IGV</span>
                                        </div>
                                    </div>

                                    <!-- FEATURES ADICIONALES -->
                                    <div class="additional-features mt-4">
                                        <ul class="benefits-list">
                                            <li class="highlight">
                                                <strong class="text-success">Scanner ilimitado sin costo adicional</strong>
                                            </li>
                                            <li>Disponibilidad: <strong>5 días presentada la orden de compra</strong></li>
                                            <li>IGV: <strong><t t-esc="doc.igv"/>%</strong></li>
                                            <t t-if="doc.descuento &gt; 0">
                                                <li>Descuento aplicado: <strong><t t-esc="doc.descuento"/>%</strong></li>
                                            </t>
                                        </ul>
                                    </div>
                                </div>

                                <!-- INFORMACIÓN ADICIONAL -->
                                <div class="additional-info">
                                    <h4>INFORMACIÓN ADICIONAL</h4>
                                    <ul class="benefits-list">
                                        <li>IGV configurado: <strong><t t-esc="doc.igv"/>%</strong>. Cada tarifa indica si incluye IGV o si se adiciona.</li>
                                        <li>Facturación mensual en <t t-esc="doc.currency_id.name or 'PEN'"/></li>
                                        <li>Incluye instalación y capacitación</li>
                                        <li>Incluye renovación de maquinaria, insumos, repuestos y servicio técnico</li>
                                    </ul>
                                </div>

                                <!-- CONDICIONES -->
                                <div class="conditions">
                                    <h4>CONDICIONES DE ALQUILER</h4>
                                    <ul class="benefits-list">
                                        <li>Los equipos se alquilan sin papel</li>
                                        <li>Periodo de alquiler: desde entrega hasta recepción del equipo</li>
                                        <li>Mantenimiento preventivo cada 2 meses</li>
                                        <li>Duración del contrato: <t t-esc="doc.duracion_alquiler_id.name or 'Por definir'"/></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- INFORMACIÓN DE PAGO -->
                        <div class="section payment-section">
                            <div class="section-header">
                                <i class="fa fa-credit-card"></i>
                                <span>Información de Pago</span>
                            </div>

                            <div class="bank-accounts">
                                <!-- BCP -->
                                <div class="bank-account">
                                    <div class="bank-logo">
                                        <i class="fa fa-university"></i>
                                        <span class="bank-name">BCP</span>
                                    </div>
                                    <div class="account-details">
                                        <div class="account-type">Cuenta Corriente - Soles</div>
                                        <div class="account-number">191-2334609-0-07</div>
                                        <div class="cci-number">CCI: 002-19100233460900751</div>
                                    </div>
                                </div>

                                <!-- Banco de la Nación -->
                                <div class="bank-account">
                                    <div class="bank-logo">
                                        <i class="fa fa-university"></i>
                                        <span class="bank-name">Banco de la Nación</span>
                                    </div>
                                    <div class="account-details">
                                        <div class="account-type">Cuenta de Detracción</div>
                                        <div class="account-number">00802007582</div>
                                    </div>
                                </div>
                            </div>

                            <div class="company-info">
                                <i class="fa fa-building"></i>
                                <span>A nombre de: COPIER COMPANY SAC</span>
                            </div>
                        </div>

                        <!-- FIRMA -->
                        <div style="margin-top: 3rem;">
                            <p>Sin otro particular, quedamos a su disposición para cualquier
                                consulta.</p>
                            <div style="margin-top: 2rem;">
                                <p>Atentamente,</p>
                                <div style="margin-top: 4rem;">
                                    <div style="width: 200px; border-top: 1px solid #000;"></div>
                                    <p>Ejecutivo Comercial</p>
                                </div>
                            </div>
                        </div>

                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
