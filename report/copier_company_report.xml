<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Se conserva el identificador utilizado por action_print_report y los correos. -->
    <record id="action_report_report_cotizacion_alquiler" model="ir.actions.report">
      <field name="name">Propuesta Comercial de Alquiler</field>
      <field name="model">copier.company</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">copier_company.cotizacion_view</field>
      <field name="report_file">copier_company.cotizacion_view</field>
      <field name="print_report_name">'Propuesta Comercial - %s' % object.secuencia</field>
      <field name="binding_model_id" ref="model_copier_company"/>
      <field name="binding_type">report</field>
    </record>

    <template id="cotizacion_view">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
          <t t-call="web.basic_layout">
            <link rel="stylesheet" href="/copier_company/static/src/css/cotizacion_styles.css"/>
            <div class="page cc-pdf">
              <t t-set="symbol" t-value="doc.currency_id.symbol or 'S/'"/>
              <!-- Identidad corporativa tomada de la empresa activa en Odoo -->
              <t t-set="report_company" t-value="doc.env.company"/>
              <div class="cc-brand">
                <table class="cc-brand-table"><tr>
                  <td class="cc-brand-logo-cell">
                    <t t-if="report_company.logo">
                      <img class="cc-brand-logo-large" t-att-src="image_data_uri(report_company.logo)" alt="Logotipo de la empresa"/>
                    </t>
                    <t t-else=""><strong class="cc-brand-name-fallback"><t t-esc="report_company.name"/></strong></t>
                  </td>
                  <td class="cc-brand-right">
                    <span>PROPUESTA COMERCIAL</span>
                    <strong>ALQUILER DE EQUIPOS</strong>
                    <span class="cc-brand-code">N.º <t t-esc="doc.secuencia"/></span>
                  </td>
                </tr></table>
              </div>
              <div class="cc-title">
                <div><div class="cc-kicker">PROPUESTA INDIVIDUAL</div><h1>Cotización de alquiler de equipo</h1></div>
                <div class="cc-quote-code">COTIZACIÓN N.º<br/><strong><t t-esc="doc.secuencia"/></strong></div>
              </div>
              <table class="cc-summary-meta"><tr>
                <td><small>CLIENTE</small><strong><t t-esc="doc.cliente_id.name or 'Por asignar'"/></strong></td>
                <td><small>RUC / DNI</small><strong><t t-esc="doc.identificacion or '—'"/></strong></td>
                <td><small>FECHA</small><strong><t t-esc="doc.fecha_formateada or ''"/></strong></td>
                <td><small>SEDE</small><strong><t t-esc="doc.sede or '—'"/></strong></td>
              </tr></table>
              <div class="cc-section cc-product-section">
                <div class="cc-section-label">01 · EQUIPO PROPUESTO</div>
                <table class="cc-product-table"><tr>
                  <td class="cc-machine-photo">
                    <t t-if="doc.imagen_id"><img t-att-src="image_data_uri(doc.imagen_id)" alt="Equipo"/></t>
                    <t t-else=""><div class="cc-photo-placeholder">EQUIPO MULTIFUNCIONAL</div></t>
                  </td>
                  <td class="cc-machine-detail">
                    <h2><t t-esc="doc.name.name or 'Equipo multifuncional'"/></h2>
                    <div class="cc-pills"><span><t t-esc="'Color' if doc.tipo == 'color' else 'Blanco y negro'"/></span><span><t t-esc="doc.formato.upper() if doc.formato else '—'"/></span><t t-if="doc.marca_id"><span><t t-esc="doc.marca_id.name"/></span></t></div>
                    <p class="cc-copy"><t t-esc="doc.descripcion_cotizacion_final or ''"/></p>
                    <t t-if="doc.serie_id"><p class="cc-subtle">Serie de referencia: <t t-esc="doc.serie_id"/></p></t>
                  </td>
                </tr></table>
                <t t-if="doc.especificaciones_id"><div class="cc-specs" t-field="doc.especificaciones_id"/></t>
              </div>
              <div class="cc-section">
                <div class="cc-section-label">02 · PROPUESTA ECONÓMICA MENSUAL</div>
                <table class="cc-price-table">
                  <thead><tr><th>CONCEPTO</th><th class="cc-right">BLANCO Y NEGRO</th><t t-if="doc.tipo == 'color'"><th class="cc-right">COLOR</th></t></tr></thead>
                  <tbody>
                    <tr><td>Volumen mensual incluido</td><td class="cc-right"><t t-esc="'{:,}'.format(doc.volumen_mensual_bn or 0)"/> impresiones</td><t t-if="doc.tipo == 'color'"><td class="cc-right"><t t-esc="'{:,}'.format(doc.volumen_mensual_color or 0)"/> impresiones</td></t></tr>
                    <tr><td>Tarifa unitaria contratada</td><td class="cc-right"><strong><t t-esc="'%s %.4f' % (symbol, doc.costo_copia_bn)"/></strong><br/><span class="cc-tax-note"><t t-esc="'(incluye IGV)' if doc.precio_bn_incluye_igv else '+ IGV'"/></span></td><t t-if="doc.tipo == 'color'"><td class="cc-right"><strong><t t-esc="'%s %.4f' % (symbol, doc.costo_copia_color)"/></strong><br/><span class="cc-tax-note"><t t-esc="'(incluye IGV)' if doc.precio_color_incluye_igv else '+ IGV'"/></span></td></t></tr>
                    <tr class="cc-excess"><td><strong>Tarifa por impresión excedente</strong></td><td class="cc-right"><strong><t t-esc="'%s %.4f' % (symbol, doc.precio_excedente_bn)"/></strong><br/><span class="cc-tax-note"><t t-esc="'(incluye IGV)' if doc.precio_excedente_bn_incluye_igv else '+ IGV'"/></span></td><t t-if="doc.tipo == 'color'"><td class="cc-right"><strong><t t-esc="'%s %.4f' % (symbol, doc.precio_excedente_color)"/></strong><br/><span class="cc-tax-note"><t t-esc="'(incluye IGV)' if doc.precio_excedente_color_incluye_igv else '+ IGV'"/></span></td></t></tr>
                    <tr><td>Renta mensual sin IGV por categoría</td><td class="cc-right"><t t-esc="'%s %.2f' % (symbol, doc.renta_mensual_bn)"/></td><t t-if="doc.tipo == 'color'"><td class="cc-right"><t t-esc="'%s %.2f' % (symbol, doc.renta_mensual_color)"/></td></t></tr>
                  </tbody>
                </table>
                <div class="cc-information"><strong>¿Cómo se cobra el excedente?</strong> Las impresiones que superen el volumen mensual incluido se facturan a la tarifa de excedente correspondiente, de forma adicional al importe base. El excedente no está incluido en el total estimado.</div>
              </div>
              <table class="cc-two-cols"><tr>
                <td>
                  <div class="cc-section cc-short"><div class="cc-section-label">03 · CONTRATO</div>
                    <table class="cc-keyvalues">
                      <tr><td>Duración</td><td><strong><t t-esc="doc.duracion_alquiler_id.name or 'Por definir'"/></strong></td></tr>
                      <tr><td>Inicio previsto</td><td><t t-esc="doc.fecha_inicio_alquiler or 'Por definir'"/></td></tr>
                      <tr><td>Fin previsto</td><td><t t-esc="doc.fecha_fin_alquiler or 'Por definir'"/></td></tr>
                      <tr><td>Facturación</td><td>Mensual</td></tr>
                    </table>
                  </div>
                </td><td>
                  <div class="cc-section cc-short"><div class="cc-section-label">04 · RESUMEN MENSUAL</div>
                    <table class="cc-keyvalues">
                      <tr><td>Subtotal</td><td><t t-esc="'%s %.2f' % (symbol, doc.subtotal_sin_igv)"/></td></tr>
                      <tr><td>IGV (<t t-esc="'%g' % doc.igv"/>%)</td><td><t t-esc="'%s %.2f' % (symbol, doc.monto_igv)"/></td></tr>
                      <tr class="cc-final"><td>TOTAL MENSUAL</td><td><t t-esc="'%s %.2f' % (symbol, doc.total_facturar_mensual)"/></td></tr>
                    </table>
                    <div class="cc-small-note">Total base calculado con los volúmenes y descuentos de la propuesta, sin consumos excedentes.</div>
                  </div>
                </td>
              </tr></table>
              <div class="cc-section"><div class="cc-section-label">05 · CONDICIONES COMERCIALES</div>
                <table class="cc-conditions"><tr><td>✓ Instalación y capacitación según propuesta.</td><td>✓ Mantenimiento y servicio técnico durante el contrato.</td></tr><tr><td>✓ Consumibles incluidos, excepto papel.</td><td>✓ Lectura y liquidación de excedentes mensualmente.</td></tr><tr><td>✓ Entrega: 5 días desde orden de compra.</td><td>✓ Escaneo sin cargo por página.</td></tr><tr><td>✓ Mantenimiento preventivo cada 2 meses.</td><td>✓ Período desde entrega hasta recepción del equipo.</td></tr></table>
                <p class="cc-small-note">Los términos comerciales consignados son los utilizados en la propuesta vigente; cualquier condición especial debe quedar expresamente acordada.</p>
              </div>
              <div class="cc-section"><div class="cc-section-label">06 · DATOS DE PAGO</div>
                <table class="cc-bank-table"><tr>
                  <td><strong>BCP · Cuenta corriente en soles</strong><br/>191-2334609-0-07<br/>CCI: 002-19100233460900751</td>
                  <td><strong>Banco de la Nación · Detracciones</strong><br/>00802007582<br/>Titular: <t t-esc="report_company.name"/></td>
                </tr></table>
              </div>
              <!-- Pie corporativo dinámico: no contiene contactos inventados -->
              <div class="cc-footer">
                <div class="cc-footer-company"><strong><t t-esc="report_company.name"/></strong><t t-if="report_company.partner_id.vat"> · RUC <t t-esc="report_company.partner_id.vat"/></t></div>
                <table class="cc-footer-contact"><tr>
                  <td>
                    <t t-if="report_company.email"><strong>Correo:</strong> <t t-esc="report_company.email"/></t>
                    <t t-if="report_company.phone"><span class="cc-footer-sep"> | </span><strong>Tel.:</strong> <t t-esc="report_company.phone"/></t>
                  </td>
                  <td class="cc-right">
                    <t t-if="report_company.website"><strong>Web:</strong> <t t-esc="report_company.website"/></t>
                  </td>
                </tr></table>
                <div class="cc-footer-bottom"><span>Propuesta de alquiler · <t t-esc="doc.secuencia"/></span><span>Documento comercial</span></div>
              </div>
            </div>
          </t>
        </t>
      </t>
    </template>
  </data>
</odoo>
