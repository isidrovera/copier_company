<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- FORMATO DE PAPEL VERTICAL (PORTRAIT) -->
    <!-- ===================================================== -->
    <record id="paperformat_service_request_portrait" model="report.paperformat">
        <field name="name">Service Request Portrait</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <!-- ===================================================== -->
    <!-- ACCIÓN DEL REPORTE -->
    <!-- ===================================================== -->
    <record id="action_report_service_request" model="ir.actions.report">
        <field name="name">Reporte de Servicio Técnico</field>
        <field name="model">copier.service.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">copier_company.report_service_request</field>
        <field name="report_file">copier_company.report_service_request</field>
        <field name="paperformat_id" ref="copier_company.paperformat_service_request_portrait"/>
        <field name="print_report_name">'Servicio - %s' % (object.name)</field>
    </record>

    <!-- ===================================================== -->
    <!-- TEMPLATE DEL REPORTE -->
    <!-- ===================================================== -->
    <template id="report_service_request">
        <t t-name="copier_company.report_service_request">
            <t t-call="web.basic_layout">
                <style>
                    body {
                        font-family: 'Segoe UI', Arial, sans-serif;
                        font-size: 10px;
                        color: #17365f;
                        background: #ffffff;
                    }

                    .page {
                        padding: 0;
                    }

                    .report-shell {
                        background: #ffffff;
                    }

                    .hero {
                        position: relative;
                        overflow: hidden;
                        min-height: 118px;
                        padding: 22px 26px;
                        color: #ffffff;
                        background: linear-gradient(120deg, #123a67 0%, #0e2f59 42%, #174e86 100%);
                    }

                    .hero:before {
                        content: '';
                        position: absolute;
                        top: -38px;
                        right: 130px;
                        width: 140px;
                        height: 210px;
                        background: rgba(255,255,255,0.07);
                        transform: skew(-18deg);
                    }

                    .hero:after {
                        content: '';
                        position: absolute;
                        top: -18px;
                        right: 32px;
                        width: 150px;
                        height: 210px;
                        background: rgba(255,255,255,0.10);
                        transform: skew(-18deg);
                    }

                    .hero-table,
                    .split-table,
                    .mini-table,
                    .counter-table,
                    .sign-table {
                        width: 100%;
                        border-collapse: separate;
                    }

                    .hero-table td {
                        vertical-align: middle;
                    }

                    .hero-left {
                        width: 44%;
                    }

                    .hero-right {
                        width: 56%;
                        text-align: right;
                    }

                    .company-logo {
                        max-height: 54px;
                        max-width: 195px;
                        width: auto;
                        filter: brightness(0) invert(1);
                        margin-bottom: 6px;
                    }

                    .company-tagline {
                        font-size: 11px;
                        opacity: 0.88;
                    }

                    .hero-kicker {
                        font-size: 14px;
                        line-height: 1;
                        letter-spacing: .4px;
                        text-transform: uppercase;
                        opacity: .92;
                    }

                    .hero-title {
                        font-size: 28px;
                        line-height: 1.05;
                        font-weight: 800;
                        margin-top: 4px;
                        text-transform: uppercase;
                    }

                    .report-meta {
                        text-align: right;
                        padding: 10px 18px 4px;
                        font-size: 11px;
                        color: #274d7a;
                        font-weight: 600;
                    }

                    .report-meta strong {
                        color: #123a67;
                        font-size: 12px;
                    }

                    .content-area {
                        padding: 6px 12px 0;
                    }

                    .split-table {
                        border-spacing: 8px 0;
                        margin-bottom: 8px;
                    }

                    .split-table td {
                        width: 50%;
                        vertical-align: top;
                    }

                    .full-row {
                        margin-bottom: 8px;
                    }

                    .card {
                        background: #f5f8fc;
                        border: 1px solid #e5edf5;
                        border-radius: 10px;
                        padding: 14px 16px;
                        page-break-inside: avoid;
                    }

                    .section-head {
                        margin-bottom: 10px;
                    }

                    .section-title {
                        font-size: 14px;
                        line-height: 1.2;
                        color: #113d7a;
                        font-weight: 800;
                    }

                    .field-table,
                    .field-table-4 {
                        width: 100%;
                        border-collapse: separate;
                        border-spacing: 0 6px;
                    }

                    .field-table td {
                        width: 50%;
                        vertical-align: top;
                    }

                    .field-table-4 td {
                        width: 25%;
                        vertical-align: top;
                    }

                    .label {
                        font-size: 9px;
                        color: #6f84a0;
                        text-transform: uppercase;
                        letter-spacing: .25px;
                        font-weight: 700;
                        margin-bottom: 2px;
                    }

                    .value {
                        font-size: 11px;
                        color: #17365f;
                        font-weight: 600;
                    }

                    .plain-text {
                        font-size: 11px;
                        color: #284669;
                        line-height: 1.45;
                        margin-top: 2px;
                        white-space: pre-wrap;
                    }

                    .badge {
                        display: inline-block;
                        padding: 3px 10px;
                        border-radius: 12px;
                        font-size: 9px;
                        font-weight: 700;
                        color: #ffffff;
                    }

                    .badge-success { background: #53c79d; }
                    .badge-warning { background: #e0ab3a; }
                    .badge-danger { background: #d35454; }
                    .badge-info { background: #4a86c5; }
                    .badge-primary { background: #245b95; }

                    .mini-table {
                        border-spacing: 8px 8px;
                        margin: 0 -8px 0;
                    }

                    .mini-table td {
                        width: 50%;
                        vertical-align: top;
                    }

                    .mini-card {
                        background: #f5f8fc;
                        border: 1px solid #e5edf5;
                        border-radius: 9px;
                        padding: 12px 14px;
                        min-height: 58px;
                    }

                    .mini-title {
                        font-size: 10px;
                        color: #6c82a0;
                        margin-bottom: 4px;
                    }

                    .mini-value {
                        font-size: 11px;
                        color: #173b73;
                        font-weight: 700;
                        line-height: 1.25;
                    }

                    .counter-table {
                        border-spacing: 8px 0;
                        margin: 8px 0 0;
                    }

                    .counter-table td {
                        width: 33.33%;
                        vertical-align: top;
                    }

                    .counter-card {
                        background: #f5f8fc;
                        border: 1px solid #e5edf5;
                        border-radius: 9px;
                        padding: 12px 14px;
                        text-align: left;
                    }

                    .counter-label {
                        font-size: 10px;
                        color: #6c82a0;
                        margin-bottom: 4px;
                    }

                    .counter-value {
                        font-size: 14px;
                        color: #123d7d;
                        font-weight: 800;
                    }

                    .quote-sign-row {
                        margin-top: 12px;
                    }

                    .quote-box {
                        background: #f5f8fc;
                        border: 1px solid #e5edf5;
                        border-radius: 9px;
                        padding: 18px 18px;
                        min-height: 66px;
                        color: #2f4b73;
                    }

                    .quote-mark {
                        font-size: 46px;
                        color: #0f3a78;
                        line-height: 0.8;
                        font-weight: 700;
                        padding-right: 10px;
                    }

                    .quote-text {
                        font-size: 11px;
                        font-style: italic;
                        color: #2f4b73;
                    }

                    .sign-preview {
                        text-align: center;
                        padding: 16px 10px 4px;
                    }

                    .sign-preview .line {
                        width: 78%;
                        margin: 0 auto 8px;
                        border-top: 1px solid #274f7b;
                    }

                    .sign-preview .role {
                        font-size: 10px;
                        color: #5f7695;
                        margin-bottom: 5px;
                    }

                    .sign-preview .name {
                        font-size: 11px;
                        color: #173b73;
                        font-weight: 700;
                    }

                    .extra-card {
                        background: #f5f8fc;
                        border: 1px solid #e5edf5;
                        border-radius: 9px;
                        padding: 13px 14px;
                        margin-top: 10px;
                        page-break-inside: avoid;
                    }

                    .parts-notice {
                        margin-bottom: 8px;
                        padding: 9px 10px;
                        border-left: 3px solid #dfaa3a;
                        border-radius: 6px;
                        background: #fff8ea;
                        color: #7a5921;
                        font-size: 9.5px;
                        line-height: 1.45;
                    }

                    .parts-table {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                    }

                    .parts-table th {
                        background: #123a67;
                        color: #ffffff;
                        font-size: 9px;
                        font-weight: 700;
                        text-transform: uppercase;
                        padding: 7px 8px;
                        border: 1px solid #dbe6f0;
                    }

                    .parts-table td {
                        color: #284669;
                        font-size: 10px;
                        padding: 7px 8px;
                        border: 1px solid #dbe6f0;
                        vertical-align: top;
                    }

                    .parts-description { width: 82%; white-space: pre-line; }
                    .parts-quantity { width: 18%; text-align: center; font-weight: 700; }

                    .parts-acceptance {
                        margin-top: 8px;
                        padding: 8px 10px;
                        border-radius: 6px;
                        background: #eef5fc;
                        border: 1px solid #d7e5f2;
                        color: #36587f;
                        font-size: 9px;
                        line-height: 1.45;
                    }

                    .evidence-table {
                        width: 100%;
                        border-collapse: separate;
                        border-spacing: 8px 0;
                    }

                    .evidence-table td {
                        width: 50%;
                        vertical-align: top;
                    }

                    .evidence-box {
                        text-align: center;
                        padding: 9px;
                        background: #ffffff;
                        border: 1px solid #dce7f1;
                        border-radius: 8px;
                    }

                    .evidence-label {
                        font-size: 10px;
                        font-weight: 700;
                        color: #123a67;
                        margin-bottom: 6px;
                    }

                    .evidence-box img {
                        max-width: 100%;
                        max-height: 190px;
                        border-radius: 6px;
                        border: 1px solid #dce7f1;
                    }

                    .stars {
                        text-align: center;
                        font-size: 22px;
                        color: #e0ab3a;
                        letter-spacing: 2px;
                    }

                    .sign-table {
                        border-spacing: 10px 0;
                        margin-top: 4px;
                    }

                    .sign-table td {
                        width: 50%;
                        vertical-align: bottom;
                    }

                    .signature-card {
                        background: #ffffff;
                        border: 1px solid #e5edf5;
                        border-radius: 9px;
                        padding: 12px 12px 10px;
                        min-height: 135px;
                        text-align: center;
                    }

                    .signature-area {
                        height: 72px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }

                    .signature-area img {
                        max-height: 68px;
                        max-width: 180px;
                    }

                    .signature-line {
                        width: 82%;
                        margin: 8px auto 6px;
                        border-top: 1px solid #274f7b;
                    }

                    .signature-role {
                        font-size: 10px;
                        color: #6c82a0;
                        text-transform: uppercase;
                        font-weight: 700;
                        margin-bottom: 4px;
                    }

                    .signature-name {
                        font-size: 11px;
                        color: #173b73;
                        font-weight: 700;
                    }

                    .signature-note {
                        font-size: 8.5px;
                        color: #7d90a6;
                        margin-top: 4px;
                        line-height: 1.35;
                    }

                    .footer-info {
                        margin-top: 12px;
                        padding-top: 10px;
                        border-top: 1px solid #dbe6f0;
                        text-align: center;
                        color: #7b8ca0;
                        font-size: 8.5px;
                    }
                </style>

                <div class="page">
                    <div class="report-shell">
                        <div class="hero">
                            <table class="hero-table">
                                <tr>
                                    <td class="hero-left">
                                        <img t-if="docs[0].company_id.logo"
                                             t-att-src="image_data_uri(docs[0].company_id.logo)"
                                             class="company-logo"
                                             alt="Logo"/>
                                        <div class="company-tagline">Soluciones que impulsan</div>
                                    </td>
                                    <td class="hero-right">
                                        <div class="hero-kicker">Reporte de</div>
                                        <div class="hero-title">Servicio Técnico</div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="report-meta">
                            <strong>N° <t t-esc="docs[0].name"/></strong>
                            <span style="margin:0 10px;">|</span>
                            <t t-esc="time.strftime('%d/%m/%Y')"/>
                        </div>

                        <div class="content-area">
                            <!-- Fila 1: Información general + cliente -->
                            <table class="split-table">
                                <tr>
                                    <td>
                                        <div class="card">
                                            <div class="section-head">
                                                <div class="section-title">Información General</div>
                                            </div>
                                            <table class="field-table">
                                                <tr>
                                                    <td>
                                                        <div class="label">Código</div>
                                                        <div class="value"><t t-esc="docs[0].name"/></div>
                                                    </td>
                                                    <td>
                                                        <div class="label">Fecha de solicitud</div>
                                                        <div class="value">
                                                            <t t-if="docs[0].create_date" t-esc="docs[0].create_date.strftime('%d/%m/%Y')"/>
                                                            <t t-else="">—</t>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <div class="label">Tipo de servicio</div>
                                                        <div class="value">
                                                            <t t-if="docs[0].tipo_servicio_id">
                                                                <t t-esc="docs[0].tipo_servicio_id.name"/>
                                                            </t>
                                                            <t t-else="">Mantenimiento</t>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="label">Estado</div>
                                                        <div>
                                                            <t t-set="estado_dict" t-value="{
                                                                'nuevo': ('badge-info', 'Nuevo'),
                                                                'asignado': ('badge-primary', 'Asignado'),
                                                                'confirmado': ('badge-success', 'Confirmado'),
                                                                'en_ruta': ('badge-warning', 'En Ruta'),
                                                                'en_sitio': ('badge-warning', 'En Sitio'),
                                                                'pausado': ('badge-warning', 'Pausado'),
                                                                'completado': ('badge-success', 'Completado'),
                                                                'cancelado': ('badge-danger', 'Cancelado')
                                                            }"/>
                                                            <span class="badge" t-att-class="estado_dict.get(docs[0].estado, ('badge-info', 'N/A'))[0]">
                                                                <t t-esc="estado_dict.get(docs[0].estado, ('badge-info', 'N/A'))[1]"/>
                                                            </span>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <div class="label">Prioridad</div>
                                                        <div class="value">
                                                            <t t-if="docs[0].priority == '0' or not docs[0].priority">Normal</t>
                                                            <t t-elif="docs[0].priority == '1'">Baja</t>
                                                            <t t-elif="docs[0].priority == '2'">Alta</t>
                                                            <t t-elif="docs[0].priority == '3'">Muy Alta</t>
                                                            <t t-else="">Normal</t>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="label">SLA cumplido</div>
                                                        <div>
                                                            <span class="badge" t-att-class="docs[0].sla_cumplido and 'badge-success' or 'badge-danger'">
                                                                <t t-if="docs[0].sla_cumplido">✓ Cumplido</t>
                                                                <t t-else="">✗ No Cumplido</t>
                                                            </span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="card">
                                            <div class="section-head">
                                                <div class="section-title">Datos del Cliente</div>
                                            </div>
                                            <table class="field-table">
                                                <tr>
                                                    <td>
                                                        <div class="label">Empresa</div>
                                                        <div class="value"><t t-esc="docs[0].cliente_id.name"/></div>
                                                    </td>
                                                    <td>
                                                        <div class="label">Contacto</div>
                                                        <div class="value"><t t-esc="docs[0].contacto or '—'"/></div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <div class="label">Teléfono</div>
                                                        <div class="value"><t t-esc="docs[0].telefono_contacto or '—'"/></div>
                                                    </td>
                                                    <td>
                                                        <div class="label">Email</div>
                                                        <div class="value"><t t-esc="docs[0].correo or '—'"/></div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="2">
                                                        <div class="label">Dirección / Ubicación</div>
                                                        <div class="value"><t t-esc="docs[0].ubicacion or '—'"/></div>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Equipo -->
                            <div class="full-row card">
                                <div class="section-head">
                                    <div class="section-title">Equipo / Dispositivo</div>
                                </div>
                                <table class="field-table">
                                    <tr>
                                        <td>
                                            <div class="label">Marca</div>
                                            <div class="value">
                                                <t t-if="docs[0].modelo_maquina and docs[0].modelo_maquina.marca_id">
                                                    <t t-esc="docs[0].modelo_maquina.marca_id.name"/>
                                                </t>
                                                <t t-else="">—</t>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="label">Número de serie</div>
                                            <div class="value"><t t-esc="docs[0].serie_maquina or '—'"/></div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <div class="label">Modelo</div>
                                            <div class="value"><t t-esc="docs[0].modelo_maquina.name or '—'"/></div>
                                        </td>
                                        <td>
                                            <div class="label">Ubicación</div>
                                            <div class="value"><t t-esc="docs[0].ubicacion or '—'"/></div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <div class="label">IP del equipo</div>
                                            <div class="value"><t t-esc="docs[0].ip_maquina or '—'"/></div>
                                        </td>
                                        <td>
                                            <div class="label">Cliente</div>
                                            <div class="value"><t t-esc="docs[0].cliente_id.name or '—'"/></div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Descripción -->
                            <div class="full-row card">
                                <div class="section-head">
                                    <div class="section-title">Descripción del Servicio</div>
                                </div>
                                <div class="plain-text"><t t-esc="docs[0].problema_reportado or '—'"/></div>
                            </div>

                            <!-- Resultados -->
                            <div class="full-row card">
                                <div class="section-head">
                                    <div class="section-title">Resultados / Observaciones</div>
                                </div>
                                <div class="plain-text">
                                    <t t-if="docs[0].trabajo_realizado">
                                        <t t-esc="docs[0].trabajo_realizado"/>
                                    </t>
                                    <t t-else="">No se registraron observaciones adicionales.</t>
                                </div>
                            </div>

                            <!-- Tarjetas pequeñas -->
                            <table class="mini-table">
                                <tr>
                                    <td>
                                        <div class="mini-card">
                                            <div class="mini-title">Técnico responsable</div>
                                            <div class="mini-value"><t t-esc="docs[0].tecnico_id.name or 'No asignado'"/></div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="mini-card">
                                            <div class="mini-title">Tipo de solución</div>
                                            <div class="mini-value">
                                                <t t-if="docs[0].solucion_aplicada">
                                                    <t t-esc="dict(docs[0]._fields['solucion_aplicada'].selection).get(docs[0].solucion_aplicada)"/>
                                                </t>
                                                <t t-else="">—</t>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="mini-card">
                                            <div class="mini-title">Fecha de inicio</div>
                                            <div class="mini-value">
                                                <t t-if="docs[0].fecha_inicio" t-esc="docs[0].fecha_inicio.strftime('%d/%m/%Y %H:%M')"/>
                                                <t t-else="">—</t>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="mini-card">
                                            <div class="mini-title">Fecha de fin</div>
                                            <div class="mini-value">
                                                <t t-if="docs[0].fecha_fin" t-esc="docs[0].fecha_fin.strftime('%d/%m/%Y %H:%M')"/>
                                                <t t-else="">—</t>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Contadores -->
                            <t t-if="docs[0].contador_bn or docs[0].contador_color or docs[0].contador_total">
                                <table class="counter-table">
                                    <tr>
                                        <td>
                                            <div class="counter-card">
                                                <div class="counter-label">Contador B/N</div>
                                                <div class="counter-value"><t t-esc="'{:,}'.format(docs[0].contador_bn or 0)"/></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="counter-card">
                                                <div class="counter-label">Contador color</div>
                                                <div class="counter-value"><t t-esc="'{:,}'.format(docs[0].contador_color or 0)"/></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="counter-card">
                                                <div class="counter-label">Contador total</div>
                                                <div class="counter-value"><t t-esc="'{:,}'.format(docs[0].contador_total or 0)"/></div>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </t>

                            <!-- Frase + firma previa -->
                            <table class="split-table quote-sign-row">
                                <tr>
                                    <td>
                                        <div class="quote-box">
                                            <table style="width:100%; border-collapse:collapse;">
                                                <tr>
                                                    <td style="width:38px; vertical-align:top;">
                                                        <div class="quote-mark">“</div>
                                                    </td>
                                                    <td style="vertical-align:middle;">
                                                        <div class="quote-text">La tecnología funciona mejor cuando alguien la cuida.</div>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="sign-preview">
                                            <div class="line"></div>
                                            <div class="role">Técnico Responsable</div>
                                            <div class="name"><t t-esc="docs[0].tecnico_id.name or '___________________'"/></div>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Insumos usados -->
                            <t t-if="docs[0].insumos_utilizados">
                                <div class="extra-card">
                                    <div class="section-head">
                                        <div class="section-title">Insumos / Repuestos Utilizados</div>
                                    </div>
                                    <div class="plain-text"><t t-esc="docs[0].insumos_utilizados"/></div>
                                </div>
                            </t>

                            <!-- Repuestos solicitados -->
                            <t t-if="docs[0].requiere_repuestos and docs[0].sale_order_id">
                                <div class="extra-card">
                                    <div class="section-head">
                                        <div class="section-title">Repuestos Solicitados</div>
                                    </div>

                                    <div class="parts-notice">
                                        Los siguientes repuestos fueron identificados durante la atención técnica y quedan sujetos a revisión de disponibilidad y aprobación comercial.
                                    </div>

                                    <table class="parts-table">
                                        <thead>
                                            <tr>
                                                <th class="parts-description">Descripción</th>
                                                <th class="parts-quantity">Cantidad</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="docs[0].sale_order_id.order_line" t-as="line">
                                                <tr t-if="not line.display_type">
                                                    <td class="parts-description"><t t-esc="line.name"/></td>
                                                    <td class="parts-quantity"><t t-esc="('{:,.2f}'.format(line.product_uom_qty or 0)).rstrip('0').rstrip('.')"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>

                                    <div class="parts-acceptance">
                                        <strong>Constancia:</strong>
                                        con su firma, el cliente confirma que fue informado sobre la necesidad técnica de los repuestos descritos. Este documento no constituye aceptación de precio ni aprobación de compra; la cotización comercial será comunicada por separado.
                                    </div>
                                </div>
                            </t>

                            <!-- Evidencias -->
                            <t t-if="docs[0].foto_antes or docs[0].foto_despues">
                                <div class="extra-card">
                                    <div class="section-head">
                                        <div class="section-title">Evidencias Fotográficas</div>
                                    </div>
                                    <table class="evidence-table">
                                        <tr>
                                            <td t-if="docs[0].foto_antes">
                                                <div class="evidence-box">
                                                    <div class="evidence-label">ANTES DEL SERVICIO</div>
                                                    <img t-att-src="'data:image/png;base64,%s' % docs[0].foto_antes" alt="Foto Antes"/>
                                                </div>
                                            </td>
                                            <td t-if="docs[0].foto_despues">
                                                <div class="evidence-box">
                                                    <div class="evidence-label">DESPUÉS DEL SERVICIO</div>
                                                    <img t-att-src="'data:image/png;base64,%s' % docs[0].foto_despues" alt="Foto Después"/>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </t>

                            <!-- Evaluación -->
                            <t t-if="docs[0].calificacion">
                                <div class="extra-card">
                                    <div class="section-head">
                                        <div class="section-title">Evaluación del Cliente</div>
                                    </div>
                                    <div class="stars"><t t-esc="'⭐' * int(docs[0].calificacion)"/></div>
                                    <t t-if="docs[0].comentario_cliente">
                                        <div class="plain-text" style="margin-top: 10px;"><t t-esc="docs[0].comentario_cliente"/></div>
                                    </t>
                                </div>
                            </t>

                            <!-- Firmas -->
                            <div class="extra-card">
                                <div class="section-head">
                                    <div class="section-title">Firmas y Conformidad</div>
                                </div>
                                <table class="sign-table">
                                    <tr>
                                        <td>
                                            <div class="signature-card">
                                                <div class="signature-area">
                                                    <!-- Espacio para firma del técnico -->
                                                </div>
                                                <div class="signature-line"></div>
                                                <div class="signature-role">Técnico responsable</div>
                                                <div class="signature-name"><t t-esc="docs[0].tecnico_id.name or '___________________'"/></div>
                                                <div class="signature-note">Firma y sello</div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="signature-card">
                                                <div class="signature-area">
                                                    <t t-if="docs[0].firma_cliente">
                                                        <img t-att-src="'data:image/png;base64,%s' % docs[0].firma_cliente" alt="Firma Cliente"/>
                                                    </t>
                                                </div>
                                                <div class="signature-line"></div>
                                                <div class="signature-role">Conformidad del cliente</div>
                                                <div class="signature-name"><t t-esc="docs[0].nombre_firma or '___________________'"/></div>
                                                <div class="signature-note">
                                                    <t t-if="docs[0].requiere_repuestos and docs[0].sale_order_id">Firma, conformidad e información de repuestos</t>
                                                    <t t-else="">Firma y conformidad</t>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div class="footer-info">
                                <p style="margin:0;">
                                    <strong><t t-esc="docs[0].company_id.name"/></strong><br/>
                                    <t t-if="docs[0].company_id.phone">Tel: <t t-esc="docs[0].company_id.phone"/> | </t>
                                    <t t-if="docs[0].company_id.email">Email: <t t-esc="docs[0].company_id.email"/></t>
                                </p>
                                <p style="margin:5px 0 0 0; font-size:8.5px;">Este documento es válido como constancia del servicio técnico realizado</p>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
