<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- FORMATO DE PAPEL VERTICAL (PORTRAIT) -->
    <!-- ===================================================== -->
    <record id="paperformat_service_request_portrait" model="report.paperformat">
        <field name="name">Service Request Portrait</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">23</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- ===================================================== -->
    <!-- ACCIÓN DEL REPORTE -->
    <!-- ===================================================== -->
    <record id="action_report_service_request" model="ir.actions.report">
        <field name="name">Reporte de Servicio Técnico</field>
        <field name="model">copier.service.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">copier_company.report_service_request</field>
        <field name="report_file">copier_company.report_service_request</field>
        <field name="paperformat_id" ref="copier_company.paperformat_service_request_portrait"/>
        <field name="print_report_name">'Servicio - %s' % (object.name)</field>
    </record>

    <!-- ===================================================== -->
    <!-- TEMPLATE DEL REPORTE -->
    <!-- ===================================================== -->
    <template id="report_service_request">
        <t t-name="copier_company.report_service_request">
            <t t-call="web.basic_layout">
                
                <!-- Estilos del reporte: diseño corporativo moderno sin números -->
                <style>
                    body {
                        font-family: 'Segoe UI', Arial, sans-serif;
                        font-size: 10.5px;
                        color: #183153;
                        background: #ffffff;
                    }
                    .page {
                        padding: 0;
                    }
                    .header-container {
                        position: relative;
                        overflow: hidden;
                        background: linear-gradient(115deg, #123a67 0%, #0d2d52 48%, #164b7c 100%);
                        color: #ffffff;
                        border-radius: 0;
                        padding: 24px 28px;
                        margin-bottom: 14px;
                        min-height: 105px;
                    }
                    .header-container:after {
                        content: '';
                        position: absolute;
                        right: -55px;
                        top: -70px;
                        width: 300px;
                        height: 240px;
                        border: 1px solid rgba(255,255,255,.12);
                        transform: rotate(18deg);
                        background: rgba(255,255,255,.035);
                    }
                    .company-logo {
                        max-height: 58px;
                        max-width: 185px;
                        width: auto;
                        filter: brightness(0) invert(1);
                    }
                    .report-kicker {
                        font-size: 12px;
                        font-weight: 400;
                        letter-spacing: .7px;
                        text-transform: uppercase;
                        opacity: .92;
                    }
                    .report-title {
                        font-size: 23px;
                        font-weight: 800;
                        line-height: 1.05;
                        margin: 3px 0 0;
                        color: #ffffff;
                        text-transform: uppercase;
                    }
                    .report-meta {
                        text-align: right;
                        color: #25486f;
                        font-size: 10px;
                        margin: 0 6px 13px;
                    }
                    .report-meta strong {
                        color: #123a67;
                        font-size: 11px;
                    }
                    .summary-grid {
                        width: 100%;
                        border-collapse: separate;
                        border-spacing: 8px 0;
                        margin: 0 -8px 10px;
                    }
                    .summary-cell {
                        width: 50%;
                        vertical-align: top;
                    }
                    .card-container {
                        background: #f7f9fc;
                        border: 1px solid #e7edf4;
                        border-radius: 9px;
                        padding: 14px 16px;
                        margin-bottom: 10px;
                        page-break-inside: avoid;
                    }
                    .card-plain {
                        background: #ffffff;
                        border: 0;
                        border-bottom: 1px solid #dfe7f0;
                        border-radius: 0;
                        padding: 11px 2px 13px;
                    }
                    .section-title {
                        font-size: 13px;
                        font-weight: 800;
                        color: #123a67;
                        padding: 0;
                        margin: 0 0 11px;
                        border: 0;
                        display: flex;
                        align-items: center;
                    }
                    .section-title i {
                        width: 32px;
                        height: 32px;
                        line-height: 32px;
                        text-align: center;
                        margin-right: 10px;
                        border-radius: 50%;
                        color: #ffffff;
                        background: #123a67;
                        font-size: 14px;
                        flex-shrink: 0;
                    }
                    .section-title-text {
                        display: flex;
                        align-items: center;
                    }
                    .info-row { margin-bottom: 8px; }
                    .label {
                        font-size: 8.5px;
                        color: #6b7f95;
                        text-transform: uppercase;
                        letter-spacing: .35px;
                        font-weight: 700;
                        margin-bottom: 2px;
                    }
                    .value {
                        font-size: 10.5px;
                        color: #183153;
                        font-weight: 600;
                    }
                    .badge {
                        display: inline-block;
                        padding: 3px 9px;
                        border-radius: 12px;
                        font-size: 9px;
                        font-weight: 700;
                        color: white;
                    }
                    .badge-success { background-color: #28a779; }
                    .badge-warning { background-color: #d49422; }
                    .badge-danger { background-color: #cc4b4b; }
                    .badge-info { background-color: #337ab7; }
                    .badge-primary { background-color: #245e98; }
                    .text-content {
                        background: #ffffff;
                        border: 1px solid #e5ebf2;
                        border-radius: 7px;
                        padding: 10px 12px;
                        color: #334e68;
                        line-height: 1.5;
                        white-space: pre-wrap;
                    }
                    .metric-row { width:100%; border-collapse:separate; border-spacing:7px 0; margin:0 -7px; }
                    .metric-card {
                        width: 33.333%;
                        background: #f4f7fb;
                        border: 1px solid #e5ebf2;
                        border-radius: 7px;
                        padding: 10px 12px;
                        vertical-align: middle;
                    }
                    .metric-card .metric-label { color:#6b7f95; font-size:8.5px; font-weight:700; text-transform:uppercase; }
                    .metric-card .metric-value { color:#123a67; font-size:13px; font-weight:800; margin-top:2px; }
                    .parts-notice {
                        margin-bottom: 9px; padding: 8px 10px; border-left: 3px solid #d49422;
                        border-radius: 5px; background: #fff9ed; color: #74531c; line-height: 1.4;
                    }
                    .parts-table { width:100%; border-collapse:collapse; table-layout:fixed; }
                    .parts-table th {
                        padding:7px 8px; border:1px solid #dce5ef; background:#123a67; color:#fff;
                        font-size:9px; font-weight:700; text-transform:uppercase;
                    }
                    .parts-table td { padding:8px; border:1px solid #dce5ef; color:#24425f; vertical-align:top; }
                    .parts-table .parts-description { width:82%; white-space:pre-line; }
                    .parts-table .parts-quantity { width:18%; text-align:center; font-weight:700; }
                    .parts-acceptance {
                        margin-top:9px; padding:8px 10px; border:1px solid #d4e3f2; border-radius:5px;
                        background:#f4f8fc; color:#315a83; font-size:9px; line-height:1.4;
                    }
                    .evidence-box {
                        text-align:center; padding:9px; background:#fff; border:1px solid #e2e9f1; border-radius:7px;
                    }
                    .evidence-box img { max-height:185px; max-width:100%; border-radius:5px; border:1px solid #dce5ef; }
                    .evidence-label { font-weight:800; color:#123a67; margin-bottom:6px; font-size:10px; }
                    .calificacion-stars { font-size:22px; color:#d49422; letter-spacing:2px; }
                    .signature-wrap {
                        margin-top: 8px;
                        page-break-inside: avoid;
                    }
                    .signature-table { width:100%; border-collapse:separate; border-spacing:14px 0; margin:0 -14px; }
                    .signature-cell { width:50%; vertical-align:bottom; padding:12px 16px 4px; text-align:center; }
                    .signature-box {
                        min-height: 110px;
                        padding: 8px 10px;
                        background: #ffffff;
                        border: 0;
                        text-align: center;
                    }
                    .signature-box img { max-height:72px; max-width:180px; margin-bottom:2px; }
                    .signature-line { border-top:1px solid #284968; width:78%; margin:14px auto 6px; }
                    .signature-label { font-size:8.5px; color:#73869a; font-weight:700; text-transform:uppercase; }
                    .signature-name { font-size:10.5px; color:#183153; font-weight:800; margin-top:2px; }
                    .footer-info {
                        margin-top: 14px; padding-top: 9px; border-top:1px solid #dfe7ef; text-align:center;
                        color:#77899a; font-size:8.5px;
                    }
                </style>

                <div class="page">
                    
                    <!-- =================== HEADER CORPORATIVO =================== -->
                    <div class="header-container">
                        <div class="row align-items-center">
                            <div class="col-5">
                                <img t-if="docs[0].company_id.logo"
                                     t-att-src="image_data_uri(docs[0].company_id.logo)"
                                     class="company-logo"
                                     alt="Logo"/>
                            </div>
                            <div class="col-7 text-end">
                                <div class="report-kicker">Reporte de</div>
                                <h1 class="report-title">SERVICIO TÉCNICO</h1>
                            </div>
                        </div>
                    </div>
                    <div class="report-meta">
                        <strong>Nº <t t-esc="docs[0].name"/></strong>
                        <span style="margin:0 8px;">|</span>
                        <t t-esc="time.strftime('%d/%m/%Y')"/>
                    </div>

                    <!-- =================== INFORMACIÓN DEL CLIENTE =================== -->
                    <div class="card-container">
                        <div class="section-title">
                            <i class="fa fa-building"/>
                            <span class="section-title-text">INFORMACIÓN DEL CLIENTE</span>
                        </div>
                        <div class="row">
                            <div class="col-6 info-row">
                                <div class="label">Cliente</div>
                                <div class="value"><t t-esc="docs[0].cliente_id.name"/></div>
                            </div>
                            <div class="col-6 info-row">
                                <div class="label">Contacto</div>
                                <div class="value"><t t-esc="docs[0].contacto or '—'"/></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6 info-row">
                                <div class="label">Teléfono</div>
                                <div class="value"><t t-esc="docs[0].telefono_contacto or '—'"/></div>
                            </div>
                            <div class="col-6 info-row">
                                <div class="label">Email</div>
                                <div class="value"><t t-esc="docs[0].correo or '—'"/></div>
                            </div>
                        </div>
                    </div>

                    <!-- =================== INFORMACIÓN DEL EQUIPO =================== -->
                    <div class="card-container">
                        <div class="section-title">
                            <i class="fa fa-print"/>
                            <span class="section-title-text">INFORMACIÓN DEL EQUIPO</span>
                        </div>
                        <div class="row">
                            <div class="col-6 info-row">
                                <div class="label">Modelo</div>
                                <div class="value"><t t-esc="docs[0].modelo_maquina.name"/></div>
                            </div>
                            <div class="col-6 info-row">
                                <div class="label">Serie</div>
                                <div class="value"><t t-esc="docs[0].serie_maquina"/></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6 info-row">
                                <div class="label">Ubicación</div>
                                <div class="value"><t t-esc="docs[0].ubicacion"/></div>
                            </div>
                            <div class="col-6 info-row">
                                <div class="label">IP del Equipo</div>
                                <div class="value"><t t-esc="docs[0].ip_maquina or '—'"/></div>
                            </div>
                        </div>
                    </div>

                    <!-- =================== DETALLE DEL SERVICIO =================== -->
                    <div class="card-container">
                        <div class="section-title">
                            <i class="fa fa-wrench"/>
                            <span class="section-title-text">DETALLE DEL SERVICIO</span>
                        </div>
                        <div class="row">
                            <div class="col-12 info-row">
                                <div class="label">Problema Reportado</div>
                                <div class="text-content">
                                    <t t-esc="docs[0].problema_reportado"/>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="margin-top: 1rem;">
                            <div class="col-6 info-row">
                                <div class="label">Técnico Asignado</div>
                                <div class="value">
                                    <t t-esc="docs[0].tecnico_id.name or 'No asignado'"/>
                                </div>
                            </div>
                            <div class="col-6 info-row">
                                <div class="label">Estado</div>
                                <div>
                                    <t t-set="estado_dict" t-value="{
                                        'nuevo': ('badge-info', 'Nuevo'),
                                        'asignado': ('badge-primary', 'Asignado'),
                                        'confirmado': ('badge-success', 'Confirmado'),
                                        'en_ruta': ('badge-warning', 'En Ruta'),
                                        'en_sitio': ('badge-warning', 'En Sitio'),
                                        'pausado': ('badge-warning', 'Pausado'),
                                        'completado': ('badge-success', 'Completado'),
                                        'cancelado': ('badge-danger', 'Cancelado')
                                    }"/>
                                    <span class="badge" 
                                          t-att-class="estado_dict.get(docs[0].estado, ('badge-info', 'N/A'))[0]">
                                        <t t-esc="estado_dict.get(docs[0].estado, ('badge-info', 'N/A'))[1]"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- =================== EJECUCIÓN DEL SERVICIO =================== -->
                    <div class="card-container">
                        <div class="section-title">
                            <i class="fa fa-clock-o"/>
                            <span class="section-title-text">EJECUCIÓN DEL SERVICIO</span>
                        </div>
                        <div class="row">
                            <div class="col-4 info-row">
                                <div class="label">Fecha Inicio</div>
                                <div class="value">
                                    <t t-if="docs[0].fecha_inicio" 
                                       t-esc="docs[0].fecha_inicio.strftime('%d/%m/%Y %H:%M')"/>
                                    <t t-else="">—</t>
                                </div>
                            </div>
                            <div class="col-4 info-row">
                                <div class="label">Fecha Fin</div>
                                <div class="value">
                                    <t t-if="docs[0].fecha_fin" 
                                       t-esc="docs[0].fecha_fin.strftime('%d/%m/%Y %H:%M')"/>
                                    <t t-else="">—</t>
                                </div>
                            </div>
                            <div class="col-4 info-row">
                                <div class="label">Duración (horas)</div>
                                <div class="value">
                                    <t t-esc="round(docs[0].duracion_real or 0, 2)"/> h
                                </div>
                            </div>
                        </div>
                        <div class="row" style="margin-top: 1rem;">
                            <div class="col-6 info-row">
                                <div class="label">Tipo de Solución</div>
                                <div class="value">
                                    <t t-if="docs[0].solucion_aplicada">
                                        <t t-esc="dict(docs[0]._fields['solucion_aplicada'].selection).get(docs[0].solucion_aplicada)"/>
                                    </t>
                                    <t t-else="">—</t>
                                </div>
                            </div>
                            <div class="col-6 info-row">
                                <div class="label">SLA Cumplido</div>
                                <div>
                                    <span class="badge" 
                                          t-att-class="docs[0].sla_cumplido and 'badge-success' or 'badge-danger'">
                                        <t t-if="docs[0].sla_cumplido">✓ Cumplido</t>
                                        <t t-else="">✗ No Cumplido</t>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- =================== TRABAJO REALIZADO =================== -->
                    <t t-if="docs[0].trabajo_realizado">
                        <div class="card-container">
                            <div class="section-title">
                                <i class="fa fa-check-square-o"/>
                                <span class="section-title-text">TRABAJO REALIZADO</span>
                            </div>
                            <div class="text-content">
                                <t t-esc="docs[0].trabajo_realizado"/>
                            </div>
                        </div>
                    </t>

                    <!-- =================== INSUMOS UTILIZADOS =================== -->
                    <t t-if="docs[0].insumos_utilizados">
                        <div class="card-container">
                            <div class="section-title">
                                <i class="fa fa-cubes"/>
                                <span class="section-title-text">INSUMOS / REPUESTOS UTILIZADOS</span>
                            </div>
                            <div class="text-content">
                                <t t-esc="docs[0].insumos_utilizados"/>
                            </div>
                        </div>
                    </t>

                    <!-- =================== REPUESTOS SOLICITADOS =================== -->
                    <t t-if="docs[0].requiere_repuestos and docs[0].sale_order_id">
                        <div class="card-container">
                            <div class="section-title">
                                <i class="fa fa-cogs"/>
                                <span class="section-title-text">REPUESTOS SOLICITADOS</span>
                            </div>

                            <div class="parts-notice">
                                Los siguientes repuestos fueron identificados durante la atención técnica
                                y quedan sujetos a revisión de disponibilidad y aprobación comercial.
                            </div>

                            <table class="parts-table">
                                <thead>
                                    <tr>
                                        <th class="parts-description">Descripción</th>
                                        <th class="parts-quantity">Cantidad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="docs[0].sale_order_id.order_line" t-as="line">
                                        <tr t-if="not line.display_type">
                                            <td class="parts-description">
                                                <t t-esc="line.name"/>
                                            </td>
                                            <td class="parts-quantity">
                                                <t t-esc="('{:,.2f}'.format(line.product_uom_qty or 0)).rstrip('0').rstrip('.')"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <div class="parts-acceptance">
                                <strong>Constancia:</strong>
                                con su firma, el cliente confirma que fue informado sobre la necesidad
                                técnica de los repuestos descritos. Este documento no constituye aceptación
                                de precio ni aprobación de compra; la cotización comercial será comunicada por separado.
                            </div>
                        </div>
                    </t>

                    <!-- =================== CONTADORES =================== -->
                    <t t-if="docs[0].contador_bn or docs[0].contador_color">
                        <div class="card-container">
                            <div class="section-title">
                                <i class="fa fa-tachometer"/>
                                <span class="section-title-text">CONTADORES</span>
                            </div>
                            <div class="row">
                                <div class="col-4 info-row">
                                    <div class="label">Contador B/N</div>
                                    <div class="value">
                                        <t t-esc="'{:,}'.format(docs[0].contador_bn or 0)"/>
                                    </div>
                                </div>
                                <div class="col-4 info-row">
                                    <div class="label">Contador Color</div>
                                    <div class="value">
                                        <t t-esc="'{:,}'.format(docs[0].contador_color or 0)"/>
                                    </div>
                                </div>
                                <div class="col-4 info-row">
                                    <div class="label">Total</div>
                                    <div class="value">
                                        <t t-esc="'{:,}'.format(docs[0].contador_total or 0)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- =================== EVIDENCIAS FOTOGRÁFICAS =================== -->
                    <t t-if="docs[0].foto_antes or docs[0].foto_despues">
                        <div class="card-container">
                            <div class="section-title">
                                <i class="fa fa-camera"/>
                                <span class="section-title-text">EVIDENCIAS FOTOGRÁFICAS</span>
                            </div>
                            <div class="row">
                                <div class="col-6" t-if="docs[0].foto_antes">
                                    <div class="evidence-box">
                                        <div class="evidence-label">ANTES DEL SERVICIO</div>
                                        <img t-att-src="'data:image/png;base64,%s' % docs[0].foto_antes" 
                                             alt="Foto Antes"/>
                                    </div>
                                </div>
                                <div class="col-6" t-if="docs[0].foto_despues">
                                    <div class="evidence-box">
                                        <div class="evidence-label">DESPUÉS DEL SERVICIO</div>
                                        <img t-att-src="'data:image/png;base64,%s' % docs[0].foto_despues" 
                                             alt="Foto Después"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- =================== EVALUACIÓN DEL CLIENTE =================== -->
                    <t t-if="docs[0].calificacion">
                        <div class="card-container">
                            <div class="section-title">
                                <i class="fa fa-star"/>
                                <span class="section-title-text">EVALUACIÓN DEL CLIENTE</span>
                            </div>
                            <div class="row">
                                <div class="col-12 info-row text-center">
                                    <div class="calificacion-stars">
                                        <t t-esc="'⭐' * int(docs[0].calificacion)"/>
                                    </div>
                                </div>
                            </div>
                            <t t-if="docs[0].comentario_cliente">
                                <div class="text-content" style="margin-top: 1rem;">
                                    <t t-esc="docs[0].comentario_cliente"/>
                                </div>
                            </t>
                        </div>
                    </t>

                    <!-- =================== FIRMAS Y CONFORMIDAD =================== -->
                    <div class="card-container card-plain signature-wrap">
                        <div class="section-title">
                            <i class="fa fa-pencil"/>
                            <span class="section-title-text">FIRMAS Y CONFORMIDAD</span>
                        </div>
                        <table class="signature-table">
                            <tr>
                                <td class="signature-cell">
                                    <div class="signature-box">
                                        <div style="height:74px;">
                                            <!-- Espacio reservado para firma física/digital del técnico -->
                                        </div>
                                        <div class="signature-line"></div>
                                        <div class="signature-label">Técnico responsable</div>
                                        <div class="signature-name">
                                            <t t-esc="docs[0].tecnico_id.name or '___________________'"/>
                                        </div>
                                        <div style="font-size:8.5px;color:#7b8ea2;margin-top:3px;">Firma y sello</div>
                                    </div>
                                </td>
                                <td class="signature-cell">
                                    <div class="signature-box">
                                        <div style="height:74px;">
                                            <t t-if="docs[0].firma_cliente">
                                                <img t-att-src="'data:image/png;base64,%s' % docs[0].firma_cliente"
                                                     alt="Firma Cliente"/>
                                            </t>
                                        </div>
                                        <div class="signature-line"></div>
                                        <div class="signature-label">Conformidad del cliente</div>
                                        <div class="signature-name">
                                            <t t-esc="docs[0].nombre_firma or '___________________'"/>
                                        </div>
                                        <div style="font-size:8.5px;color:#7b8ea2;margin-top:3px;">
                                            <t t-if="docs[0].requiere_repuestos and docs[0].sale_order_id">
                                                Firma, conformidad e información de repuestos
                                            </t>
                                            <t t-else="">Firma y conformidad</t>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- =================== FOOTER =================== -->
                    <div class="footer-info">
                        <p style="margin: 0;">
                            <strong><t t-esc="docs[0].company_id.name"/></strong><br/>
                            <t t-if="docs[0].company_id.phone">
                                Tel: <t t-esc="docs[0].company_id.phone"/> |
                            </t>
