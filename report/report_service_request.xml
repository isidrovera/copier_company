<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- FORMATO DE PAPEL VERTICAL (PORTRAIT) -->
    <!-- ===================================================== -->
    <record id="paperformat_service_request_portrait" model="report.paperformat">
        <field name="name">Service Request Portrait</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <!-- ===================================================== -->
    <!-- ACCIÓN DEL REPORTE -->
    <!-- ===================================================== -->
    <record id="action_report_service_request" model="ir.actions.report">
        <field name="name">Reporte de Servicio Técnico</field>
        <field name="model">copier.service.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">copier_company.report_service_request</field>
        <field name="report_file">copier_company.report_service_request</field>
        <field name="paperformat_id" ref="copier_company.paperformat_service_request_portrait"/>
        <field name="print_report_name">'Servicio - %s' % (object.name)</field>
    </record>

    <!-- ===================================================== -->
    <!-- TEMPLATE DEL REPORTE -->
    <!-- ===================================================== -->
    <template id="report_service_request">
        <t t-name="copier_company.report_service_request">
            <t t-call="web.basic_layout">
                <style>
                    body { font-family: Arial, 'Segoe UI', sans-serif; font-size: 9px; color:#17365f; background:#fff; }
                    .page { padding:0; margin:0; }
                    .report-shell { background:#fff; }
                    .hero { background-color:#123a67; color:#fff; padding:10px 16px; min-height:68px; margin:0 0 4px 0; }
                    .hero-table,.split-table,.mini-table,.counter-table,.sign-table { width:100%; border-collapse:separate; }
                    .hero-table td { vertical-align:middle; }
                    .hero-left { width:46%; }
                    .hero-right { width:54%; text-align:right; }
                    .company-logo { width:220px; max-width:220px; max-height:68px; height:auto; display:block; }
                    .company-tagline { color:#dce8f5; font-size:8px; margin-top:1px; }
                    .hero-kicker { color:#dce8f5; font-size:9px; line-height:1; text-transform:uppercase; }
                    .hero-title { color:#fff; font-size:20px; line-height:1.05; font-weight:800; margin-top:3px; text-transform:uppercase; }
                    .report-meta { text-align:right; padding:2px 10px 4px; font-size:9px; color:#274d7a; font-weight:600; }
                    .report-meta strong { color:#123a67; font-size:10px; }
                    .content-area { padding:0 6px; }
                    .split-table { border-spacing:4px 0; margin-bottom:4px; }
                    .split-table td { width:50%; vertical-align:top; }
                    .full-row { margin-bottom:4px; }
                    .card,.extra-card { background-color:#f3f7fb; border:1px solid #e2eaf3; border-radius:5px; padding:7px 9px; page-break-inside:avoid; }
                    .extra-card { margin-top:4px; }
                    .section-head { margin-bottom:4px; }
                    .section-title { font-size:10.5px; line-height:1.1; color:#123a67; font-weight:800; }
                    .field-table { width:100%; border-collapse:separate; border-spacing:0 2px; }
                    .field-table td { width:50%; vertical-align:top; padding-right:4px; }
                    .label { font-size:6.8px; color:#71849b; text-transform:uppercase; letter-spacing:.1px; font-weight:700; margin-bottom:1px; }
                    .value { font-size:8.5px; line-height:1.18; color:#17365f; font-weight:700; }
                    .plain-text { font-size:8.4px; color:#284669; line-height:1.22; margin-top:1px; white-space:pre-wrap; }
                    .badge { display:inline-block; padding:2px 6px; border-radius:8px; font-size:7px; font-weight:700; color:#fff; }
                    .badge-success { background-color:#39a97b; } .badge-warning { background-color:#cc8d1d; } .badge-danger { background-color:#c94b4b; } .badge-info { background-color:#397ab5; } .badge-primary { background-color:#245b95; }
                    .mini-table { border-spacing:4px 3px; margin:0 -4px; }
                    .mini-table td { width:50%; vertical-align:top; }
                    .mini-card { background-color:#f3f7fb; border:1px solid #e2eaf3; border-radius:5px; padding:5px 7px; min-height:30px; }
                    .mini-title { font-size:7px; color:#71849b; margin-bottom:1px; }
                    .mini-value { font-size:8.5px; color:#173b73; font-weight:700; line-height:1.15; }
                    .counter-table { border-spacing:4px 0; margin:3px 0 0; }
                    .counter-table td { width:33.33%; vertical-align:top; }
                    .counter-card { background-color:#f3f7fb; border:1px solid #e2eaf3; border-radius:5px; padding:5px 7px; }
                    .counter-label { font-size:7px; color:#71849b; margin-bottom:1px; }
                    .counter-value { font-size:9.5px; color:#123d7d; font-weight:800; }
                    .parts-notice { margin-bottom:4px; padding:4px 6px; border-left:3px solid #dfaa3a; background:#fff8ea; color:#7a5921; font-size:7.5px; line-height:1.2; }
                    .parts-table { width:100%; border-collapse:collapse; table-layout:fixed; }
                    .parts-table th { background:#123a67; color:#fff; font-size:7px; font-weight:700; text-transform:uppercase; padding:3px 4px; border:1px solid #dbe6f0; }
                    .parts-table td { color:#284669; font-size:7.5px; padding:3px 4px; border:1px solid #dbe6f0; vertical-align:top; }
                    .parts-description { width:82%; white-space:pre-line; } .parts-quantity { width:18%; text-align:center; font-weight:700; }
                    .parts-acceptance { margin-top:4px; padding:4px 6px; background:#eef5fc; border:1px solid #d7e5f2; color:#36587f; font-size:7px; line-height:1.2; }
                    .evidence-table { width:100%; border-collapse:separate; border-spacing:4px 0; }
                    .evidence-table td { width:50%; vertical-align:top; }
                    .evidence-box { text-align:center; padding:4px; background:#fff; border:1px solid #dce7f1; }
                    .evidence-label { font-size:7.5px; font-weight:700; color:#123a67; margin-bottom:2px; }
                    .evidence-box img { max-width:100%; max-height:95px; border:1px solid #dce7f1; }
                    .stars { text-align:center; font-size:15px; color:#e0ab3a; letter-spacing:1px; }
                    .sign-table { border-spacing:6px 0; margin-top:1px; }
                    .sign-table td { width:50%; vertical-align:bottom; }
                    .signature-card { background:#fff; border:1px solid #e2eaf3; border-radius:5px; padding:4px 7px; min-height:64px; text-align:center; }
                    .signature-area { height:28px; text-align:center; }
                    .signature-area img { max-height:27px; max-width:145px; }
                    .signature-line { width:82%; margin:2px auto; border-top:1px solid #274f7b; }
                    .signature-role { font-size:6.8px; color:#71849b; text-transform:uppercase; font-weight:700; margin-bottom:1px; }
                    .signature-name { font-size:8px; color:#173b73; font-weight:700; }
                    .signature-note { font-size:6.5px; color:#7d90a6; margin-top:1px; line-height:1.1; }
                    .footer-info { margin-top:4px; padding-top:3px; border-top:1px solid #dbe6f0; text-align:center; color:#7b8ca0; font-size:6.8px; }
                </style>

                <div class="page">
                    <div class="report-shell">
                        <div class="hero">
                            <table class="hero-table">
                                <tr>
                                    <td class="hero-left">
                                        <img t-if="docs[0].company_id.logo"
                                             t-att-src="image_data_uri(docs[0].company_id.logo)"
                                             class="company-logo"
                                             alt="Logo"/>
                                        <div class="company-tagline">Soluciones que impulsan</div>
                                    </td>
                                    <td class="hero-right">
                                        <div class="hero-kicker">Reporte de</div>
                                        <div class="hero-title">Servicio Técnico</div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="report-meta">
                            <strong>N° <t t-esc="docs[0].name"/></strong>
                            <span style="margin:0 10px;">|</span>
                            <t t-esc="time.strftime('%d/%m/%Y')"/>
                        </div>

                        <div class="content-area">
                            <!-- Fila 1: Información general + cliente -->
                            <table class="split-table">
                                <tr>
                                    <td>
                                        <div class="card">
                                            <div class="section-head">
                                                <div class="section-title">Información General</div>
                                            </div>
                                            <table class="field-table">
                                                <tr>
                                                    <td>
                                                        <div class="label">Estado</div>
                                                        <div>
                                                            <t t-set="estado_dict" t-value="{
                                                                'nuevo': ('badge-info', 'Nuevo'),
                                                                'asignado': ('badge-primary', 'Asignado'),
                                                                'confirmado': ('badge-success', 'Confirmado'),
                                                                'en_ruta': ('badge-warning', 'En Ruta'),
                                                                'en_sitio': ('badge-warning', 'En Sitio'),
                                                                'pausado': ('badge-warning', 'Pausado'),
                                                                'completado': ('badge-success', 'Completado'),
                                                                'cancelado': ('badge-danger', 'Cancelado')
                                                            }"/>
                                                            <span class="badge" t-att-class="estado_dict.get(docs[0].estado, ('badge-info', 'N/A'))[0]">
                                                                <t t-esc="estado_dict.get(docs[0].estado, ('badge-info', 'N/A'))[1]"/>
                                                            </span>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="label">SLA cumplido</div>
                                                        <div>
                                                            <span class="badge" t-att-class="docs[0].sla_cumplido and 'badge-success' or 'badge-danger'">
                                                                <t t-if="docs[0].sla_cumplido">✓ Cumplido</t>
                                                                <t t-else="">✗ No Cumplido</t>
                                                            </span>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <div class="label">Duración</div>
                                                        <div class="value"><t t-esc="round(docs[0].duracion_real or 0, 2)"/> h</div>
                                                    </td>
                                                    <td>
                                                        <div class="label">Tipo de solución</div>
                                                        <div class="value">
                                                            <t t-if="docs[0].solucion_aplicada"><t t-esc="dict(docs[0]._fields['solucion_aplicada'].selection).get(docs[0].solucion_aplicada)"/></t>
                                                            <t t-else="">—</t>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="card">
                                            <div class="section-head">
                                                <div class="section-title">Datos del Cliente</div>
                                            </div>
                                            <table class="field-table">
                                                <tr>
                                                    <td>
                                                        <div class="label">Empresa</div>
                                                        <div class="value"><t t-esc="docs[0].cliente_id.name"/></div>
                                                    </td>
                                                    <td>
                                                        <div class="label">Contacto</div>
                                                        <div class="value"><t t-esc="docs[0].contacto or '—'"/></div>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <div class="label">Teléfono</div>
                                                        <div class="value"><t t-esc="docs[0].telefono_contacto or '—'"/></div>
                                                    </td>
                                                    <td>
                                                        <div class="label">Email</div>
                                                        <div class="value"><t t-esc="docs[0].correo or '—'"/></div>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Equipo -->
                            <div class="full-row card">
                                <div class="section-head">
                                    <div class="section-title">Equipo / Dispositivo</div>
                                </div>
                                <table class="field-table">
                                    <tr>
                                        <td>
                                            <div class="label">Modelo</div>
                                            <div class="value"><t t-esc="docs[0].modelo_maquina.name"/></div>
                                        </td>
                                        <td>
                                            <div class="label">Número de serie</div>
                                            <div class="value"><t t-esc="docs[0].serie_maquina"/></div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <div class="label">Ubicación</div>
                                            <div class="value"><t t-esc="docs[0].ubicacion"/></div>
                                        </td>
                                        <td>
                                            <div class="label">IP del equipo</div>
                                            <div class="value"><t t-esc="docs[0].ip_maquina or '—'"/></div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- Descripción -->
                            <div class="full-row card">
                                <div class="section-head">
                                    <div class="section-title">Descripción del Servicio</div>
                                </div>
                                <div class="plain-text"><t t-esc="docs[0].problema_reportado or '—'"/></div>
                            </div>

                            <!-- Resultados -->
                            <div class="full-row card">
                                <div class="section-head">
                                    <div class="section-title">Resultados / Observaciones</div>
                                </div>
                                <div class="plain-text">
                                    <t t-if="docs[0].trabajo_realizado">
                                        <t t-esc="docs[0].trabajo_realizado"/>
                                    </t>
                                    <t t-else="">No se registraron observaciones adicionales.</t>
                                </div>
                            </div>

                            <!-- Fechas de ejecución -->
                            <table class="mini-table">
                                <tr>
                                    <td>
                                        <div class="mini-card">
                                            <div class="mini-title">Fecha de inicio</div>
                                            <div class="mini-value">
                                                <t t-if="docs[0].fecha_inicio" t-esc="docs[0].fecha_inicio.strftime('%d/%m/%Y %H:%M')"/>
                                                <t t-else="">—</t>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="mini-card">
                                            <div class="mini-title">Fecha de fin</div>
                                            <div class="mini-value">
                                                <t t-if="docs[0].fecha_fin" t-esc="docs[0].fecha_fin.strftime('%d/%m/%Y %H:%M')"/>
                                                <t t-else="">—</t>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Contadores -->
                            <t t-if="docs[0].contador_bn or docs[0].contador_color or docs[0].contador_total">
                                <table class="counter-table">
                                    <tr>
                                        <td>
                                            <div class="counter-card">
                                                <div class="counter-label">Contador B/N</div>
                                                <div class="counter-value"><t t-esc="'{:,}'.format(docs[0].contador_bn or 0)"/></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="counter-card">
                                                <div class="counter-label">Contador color</div>
                                                <div class="counter-value"><t t-esc="'{:,}'.format(docs[0].contador_color or 0)"/></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="counter-card">
                                                <div class="counter-label">Contador total</div>
                                                <div class="counter-value"><t t-esc="'{:,}'.format(docs[0].contador_total or 0)"/></div>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </t>

                            <!-- Insumos usados -->
                            <t t-if="docs[0].insumos_utilizados">
                                <div class="extra-card">
                                    <div class="section-head">
                                        <div class="section-title">Insumos / Repuestos Utilizados</div>
                                    </div>
                                    <div class="plain-text"><t t-esc="docs[0].insumos_utilizados"/></div>
                                </div>
                            </t>

                            <!-- Repuestos solicitados -->
                            <t t-if="docs[0].requiere_repuestos and docs[0].sale_order_id">
                                <div class="extra-card">
                                    <div class="section-head">
                                        <div class="section-title">Repuestos Solicitados</div>
                                    </div>

                                    <div class="parts-notice">
                                        Los siguientes repuestos fueron identificados durante la atención técnica y quedan sujetos a revisión de disponibilidad y aprobación comercial.
                                    </div>

                                    <table class="parts-table">
                                        <thead>
                                            <tr>
                                                <th class="parts-description">Descripción</th>
                                                <th class="parts-quantity">Cantidad</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="docs[0].sale_order_id.order_line" t-as="line">
                                                <tr t-if="not line.display_type">
                                                    <td class="parts-description"><t t-esc="line.name"/></td>
                                                    <td class="parts-quantity"><t t-esc="('{:,.2f}'.format(line.product_uom_qty or 0)).rstrip('0').rstrip('.')"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>

                                    <div class="parts-acceptance">
                                        <strong>Constancia:</strong>
                                        con su firma, el cliente confirma que fue informado sobre la necesidad técnica de los repuestos descritos. Este documento no constituye aceptación de precio ni aprobación de compra; la cotización comercial será comunicada por separado.
                                    </div>
                                </div>
                            </t>

                            <!-- Evidencias -->
                            <t t-if="docs[0].foto_antes or docs[0].foto_despues">
                                <div class="extra-card">
                                    <div class="section-head">
                                        <div class="section-title">Evidencias Fotográficas</div>
                                    </div>
                                    <table class="evidence-table">
                                        <tr>
                                            <td t-if="docs[0].foto_antes">
                                                <div class="evidence-box">
                                                    <div class="evidence-label">ANTES DEL SERVICIO</div>
                                                    <img t-att-src="'data:image/png;base64,%s' % docs[0].foto_antes" alt="Foto Antes"/>
                                                </div>
                                            </td>
                                            <td t-if="docs[0].foto_despues">
                                                <div class="evidence-box">
                                                    <div class="evidence-label">DESPUÉS DEL SERVICIO</div>
                                                    <img t-att-src="'data:image/png;base64,%s' % docs[0].foto_despues" alt="Foto Después"/>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </t>

                            <!-- Evaluación -->
                            <t t-if="docs[0].calificacion">
                                <div class="extra-card">
                                    <div class="section-head">
                                        <div class="section-title">Evaluación del Cliente</div>
                                    </div>
                                    <div class="stars"><t t-esc="'⭐' * int(docs[0].calificacion)"/></div>
                                    <t t-if="docs[0].comentario_cliente">
                                        <div class="plain-text" style="margin-top: 10px;"><t t-esc="docs[0].comentario_cliente"/></div>
                                    </t>
                                </div>
                            </t>

                            <!-- Firmas -->
                            <div class="extra-card">
                                <div class="section-head">
                                    <div class="section-title">Firmas y Conformidad</div>
                                </div>
                                <table class="sign-table">
                                    <tr>
                                        <td>
                                            <div class="signature-card">
                                                <div class="signature-area">
                                                    <!-- Espacio para firma del técnico -->
                                                </div>
                                                <div class="signature-line"></div>
                                                <div class="signature-role">Técnico responsable</div>
                                                <div class="signature-name"><t t-esc="docs[0].tecnico_id.name or '___________________'"/></div>
                                                <div class="signature-note">Firma y sello</div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="signature-card">
                                                <div class="signature-area">
                                                    <t t-if="docs[0].firma_cliente">
                                                        <img t-att-src="'data:image/png;base64,%s' % docs[0].firma_cliente" alt="Firma Cliente"/>
                                                    </t>
                                                </div>
                                                <div class="signature-line"></div>
                                                <div class="signature-role">Conformidad del cliente</div>
                                                <div class="signature-name"><t t-esc="docs[0].nombre_firma or '___________________'"/></div>
                                                <div class="signature-note">
                                                    <t t-if="docs[0].requiere_repuestos and docs[0].sale_order_id">Firma, conformidad e información de repuestos</t>
                                                    <t t-else="">Firma y conformidad</t>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div class="footer-info">
                                <p style="margin:0;">
                                    <strong><t t-esc="docs[0].company_id.name"/></strong><br/>
                                    <t t-if="docs[0].company_id.phone">Tel: <t t-esc="docs[0].company_id.phone"/> | </t>
                                    <t t-if="docs[0].company_id.email">Email: <t t-esc="docs[0].company_id.email"/></t>
                                </p>
                                <p style="margin:2px 0 0 0; font-size:6.8px;">Este documento es válido como constancia del servicio técnico realizado</p>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
