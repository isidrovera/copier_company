<?xml version='1.0' encoding='UTF-8'?>
<odoo>
     <!-- Definición del formato de papel personalizado -->
    <record id="paperformat_counter_landscape" model="report.paperformat">
        <field name="name">Counter Report Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">23</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- Definición del Reporte -->
    <record id="action_report_counter_readings" model="ir.actions.report">
        <field name="name">Reporte de Lecturas</field>
        <field name="model">copier.counter</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">copier_company.report_counter_readings</field>
        <field name="report_file">copier_company.report_counter_readings</field>
        <field name="paperformat_id" ref="copier_company.paperformat_counter_landscape"/>
        <field name="print_report_name">'Lecturas - %s - %s' % (object.cliente_id.name or '', time.strftime('%d-%m-%Y'))</field>
    </record>
    <!-- Template del Reporte -->
    <template id="report_counter_readings">
        <t t-name="copier_company.report_counter_readings">
  <t t-call="web.basic_layout">
    <t t-set="empresa" t-value="docs[0].env.company"/>
    <t t-set="cliente" t-value="docs[0].cliente_id"/>
    <t t-set="maquinas_mono" t-value="docs.filtered(lambda x: x.maquina_id.tipo == 'monocroma')"/>
    <t t-set="maquinas_color" t-value="docs.filtered(lambda x: x.maquina_id.tipo == 'color')"/>
    <t t-set="total_general" t-value="sum(docs.mapped('total'))"/>
    <t t-set="total_bn" t-value="sum(docs.mapped('total_copias_bn'))"/>
    <t t-set="total_color" t-value="sum(docs.mapped('total_copias_color'))"/>
    <t t-set="total_exceso_bn" t-value="sum(docs.mapped('exceso_bn'))"/>
    <t t-set="total_exceso_color" t-value="sum(docs.mapped('exceso_color'))"/>
    <t t-set="total_antes_desc" t-value="sum(docs.mapped('subtotal_antes_descuento'))"/>
    <t t-set="total_desc" t-value="sum(docs.mapped('monto_descuento'))"/>
    <t t-set="total_subtotal" t-value="sum(docs.mapped('subtotal'))"/>
    <t t-set="total_igv" t-value="sum(docs.mapped('igv'))"/>
    <style type="text/css">
      .ccr-page{font-family:Arial,Helvetica,sans-serif;color:#1d2b43;font-size:10px;line-height:1.38;}
      .ccr-head{width:100%;border-collapse:collapse;border-bottom:3px solid #17365d;margin-bottom:12px;}
      .ccr-head td{padding:5px 7px 12px;vertical-align:middle;border:none;}
      .ccr-logo{max-width:275px;max-height:90px;width:auto;height:auto;}
      .ccr-eyebrow{font-size:10px;font-weight:700;letter-spacing:1.4px;color:#557194;}
      .ccr-headline{font-size:21px;color:#152d50;font-weight:800;margin:5px 0 2px;}
      .ccr-small{font-size:9px;color:#61728a;}
      .ccr-meta{width:100%;border-collapse:separate;border-spacing:7px 0;margin:3px -7px 11px;}
      .ccr-meta td{width:25%;border:1px solid #dae3ed;background:#f6f9fd;border-radius:5px;vertical-align:top;padding:9px 10px;}
      .ccr-label{color:#62758f;font-weight:700;font-size:8px;letter-spacing:.7px;text-transform:uppercase;display:block;margin-bottom:4px;}
      .ccr-value{color:#142a49;font-size:10.5px;font-weight:700;word-wrap:break-word;}
      .ccr-kpis{width:100%;border-collapse:separate;border-spacing:7px 0;margin:0 -7px 12px;}
      .ccr-kpis td{width:25%;border:1px solid #dce6f2;border-radius:6px;padding:9px 11px;background:#fff;}
      .ccr-kpi-num{display:block;font-size:17px;font-weight:800;color:#183f70;}
      .ccr-kpi-label{display:block;font-size:9px;color:#5b6e85;margin-top:1px;}
      .ccr-section{margin:11px 0 6px;page-break-inside:avoid;}
      .ccr-section h2{font-size:12px;font-weight:800;color:#123154;margin:0 0 7px;padding:0 0 5px;border-bottom:2px solid #dfe8f3;letter-spacing:.2px;}
      .ccr-tag{display:inline-block;background:#e8eff7;color:#24496f;padding:3px 7px;border-radius:4px;font-size:9px;font-weight:700;margin-left:6px;}
      .ccr-tag-color{background:#e2f2fb;color:#086c9e;}
      .ccr-table{width:100%;border-collapse:collapse;font-size:9px;table-layout:auto;}
      .ccr-table thead{display:table-header-group;}
      .ccr-table th{background:#173a62;color:#fff;font-weight:700;font-size:8px;padding:8px 6px;text-align:left;border:1px solid #173a62;}
      .ccr-table td{padding:7px 6px;border-bottom:1px solid #e2e9f1;vertical-align:middle;}
      .ccr-table tbody tr:nth-child(even){background:#f5f8fc;}
      .ccr-table tr{page-break-inside:avoid;}
      .ccr-right{text-align:right!important;white-space:nowrap;}
      .ccr-strong{font-weight:800;color:#17365d;}
      .ccr-muted{color:#748398;}
      .ccr-note{border-left:3px solid #2a7cbb;background:#f1f7fc;padding:7px 10px;margin-top:7px;color:#3c5874;font-size:9px;}
      .ccr-finance{width:100%;border-collapse:collapse;margin-top:10px;}
      .ccr-finance&gt;tbody&gt;tr&gt;td{vertical-align:top;border:none;}
      .ccr-finance-box{border:1px solid #dce5ef;border-radius:5px;background:#f8fafc;padding:11px 13px;}
      .ccr-money{width:100%;border-collapse:collapse;font-size:10px;}
      .ccr-money td{padding:5px 0;border-bottom:1px solid #e2e8f0;}
      .ccr-money .ccr-grand td{font-size:15px;font-weight:800;background:#173a62;color:#fff;padding:11px 9px;border:0;}
      .ccr-footer{margin-top:17px;border-top:2px solid #dce5f0;padding-top:8px;font-size:9px;color:#64758c;}
      .ccr-footer-name{font-weight:800;color:#17365d;font-size:10px;}
    </style>
    <div class="page ccr-page">
      <!-- Datos e identificadores provienen de Odoo, no hay marca fija -->
      <table class="ccr-head"><tr>
        <td style="width:45%;">
          <t t-if="empresa.logo"><img t-att-src="image_data_uri(empresa.logo)" class="ccr-logo" alt="Logotipo empresarial"/></t>
          <t t-else=""><strong t-esc="empresa.name"/></t>
        </td>
        <td style="width:55%;text-align:right;">
          <div class="ccr-eyebrow">INFORME DE CONSUMO Y FACTURACIÓN</div>
          <div class="ccr-headline">Reporte de lecturas</div>
          <div class="ccr-small">Fecha de emisión: <t t-esc="time.strftime('%d/%m/%Y')"/></div>
        </td>
      </tr></table>
      <table class="ccr-meta"><tr>
        <td><span class="ccr-label">Cliente</span><span class="ccr-value" t-esc="cliente.name or '—'"/></td>
        <td><span class="ccr-label">RUC / DNI</span><span class="ccr-value" t-esc="cliente.vat or '—'"/></td>
        <td><span class="ccr-label">Ubicación de referencia</span><span class="ccr-value" t-esc="docs[0].ubicacion or '—'"/></td>
        <td><span class="ccr-label">Periodo de referencia</span><span class="ccr-value" t-esc="docs[0].mes_facturacion or '—'"/></td>
      </tr></table>
      <table class="ccr-kpis"><tr>
        <td><span class="ccr-kpi-num" t-esc="len(docs)"/><span class="ccr-kpi-label">Lecturas incluidas</span></td>
        <td><span class="ccr-kpi-num" t-esc="'{:,}'.format(total_bn)"/><span class="ccr-kpi-label">Consumo B/N</span></td>
        <td><span class="ccr-kpi-num" t-esc="'{:,}'.format(total_color)"/><span class="ccr-kpi-label">Consumo color</span></td>
        <td><span class="ccr-kpi-num" t-esc="'{:,}'.format(total_exceso_bn + total_exceso_color)"/><span class="ccr-kpi-label">Impresiones excedentes</span></td>
      </tr></table>
      <t t-if="maquinas_mono">
        <div class="ccr-section"><h2>01 · Máquinas blanco y negro <span class="ccr-tag">B/N</span></h2>
          <table class="ccr-table"><thead><tr>
            <th>Modelo / equipo</th><th>Serie</th><th class="ccr-right">Anterior B/N</th><th class="ccr-right">Actual B/N</th><th class="ccr-right">Consumo</th><th class="ccr-right">Excedente</th><th class="ccr-right">Importe excedente</th><th class="ccr-right">Total con IGV</th>
          </tr></thead><tbody>
            <t t-foreach="maquinas_mono" t-as="m"><tr>
              <td><span class="ccr-strong" t-esc="m.maquina_id.name.name or '—'"/></td>
              <td t-esc="m.serie or '—'"/>
              <td class="ccr-right" t-esc="'{:,}'.format(m.contador_anterior_bn or 0)"/>
              <td class="ccr-right" t-esc="'{:,}'.format(m.contador_actual_bn or 0)"/>
              <td class="ccr-right ccr-strong" t-esc="'{:,}'.format(m.total_copias_bn or 0)"/>
              <td class="ccr-right" t-esc="'{:,}'.format(m.exceso_bn or 0)"/>
              <td class="ccr-right"><span t-field="m.monto_exceso_bn" t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:m.currency_id}"/></td>
              <td class="ccr-right ccr-strong"><span t-field="m.total" t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:m.currency_id}"/></td>
            </tr></t>
          </tbody></table>
        </div>
      </t>
      <t t-if="maquinas_color">
        <div class="ccr-section"><h2>02 · Máquinas a color <span class="ccr-tag ccr-tag-color">COLOR</span></h2>
          <table class="ccr-table"><thead><tr>
            <th>Modelo / equipo</th><th>Serie</th><th class="ccr-right">Anterior B/N</th><th class="ccr-right">Actual B/N</th><th class="ccr-right">Consumo B/N</th><th class="ccr-right">Anterior color</th><th class="ccr-right">Actual color</th><th class="ccr-right">Consumo color</th><th class="ccr-right">Exceso B/N</th><th class="ccr-right">Exceso color</th><th class="ccr-right">Total con IGV</th>
          </tr></thead><tbody>
            <t t-foreach="maquinas_color" t-as="m"><tr>
              <td><span class="ccr-strong" t-esc="m.maquina_id.name.name or '—'"/></td>
              <td t-esc="m.serie or '—'"/>
              <td class="ccr-right" t-esc="'{:,}'.format(m.contador_anterior_bn or 0)"/>
              <td class="ccr-right" t-esc="'{:,}'.format(m.contador_actual_bn or 0)"/>
              <td class="ccr-right ccr-strong" t-esc="'{:,}'.format(m.total_copias_bn or 0)"/>
              <td class="ccr-right" t-esc="'{:,}'.format(m.contador_anterior_color or 0)"/>
              <td class="ccr-right" t-esc="'{:,}'.format(m.contador_actual_color or 0)"/>
              <td class="ccr-right ccr-strong" t-esc="'{:,}'.format(m.total_copias_color or 0)"/>
              <td class="ccr-right" t-esc="'{:,}'.format(m.exceso_bn or 0)"/>
              <td class="ccr-right" t-esc="'{:,}'.format(m.exceso_color or 0)"/>
              <td class="ccr-right ccr-strong"><span t-field="m.total" t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:m.currency_id}"/></td>
            </tr></t>
          </tbody></table>
        </div>
      </t>
      <!-- Se mantiene la sección de desglose por usuario -->
      <t t-if="any(doc.informe_por_usuario for doc in docs)">
        <div class="ccr-section"><h2>03 · Detalle por usuario</h2>
          <table class="ccr-table"><thead><tr>
            <th>Máquina</th><th>Usuario / empresa</th><th class="ccr-right">Copias B/N</th>
            <t t-if="maquinas_color"><th class="ccr-right">Copias color</th></t>
            <th class="ccr-right">Total</th>
          </tr></thead><tbody>
            <t t-foreach="docs.filtered(lambda d: d.informe_por_usuario)" t-as="doc">
              <t t-foreach="doc.usuario_detalle_ids" t-as="detalle"><tr>
                <td><t t-esc="doc.maquina_id.name.name or '—'"/> · <t t-esc="doc.serie or '—'"/></td>
                <td t-esc="detalle.usuario_id.name or '—'"/>
                <td class="ccr-right" t-esc="'{:,}'.format(detalle.cantidad_bn or 0)"/>
                <t t-if="maquinas_color"><td class="ccr-right"><t t-esc="'{:,}'.format(detalle.cantidad_color or 0)" t-if="doc.maquina_id.tipo == 'color'"/><t t-else="">—</t></td></t>
                <td class="ccr-right ccr-strong" t-esc="'{:,}'.format(detalle.total_copias or 0)"/>
              </tr></t>
            </t>
          </tbody></table>
        </div>
      </t>
      <div class="ccr-section"><h2>Resumen económico</h2>
        <table class="ccr-finance"><tr>
          <td style="width:52%;padding-right:18px;">
            <div class="ccr-finance-box">
              <div style="font-weight:800;font-size:11px;margin-bottom:8px;color:#173a62;">Desglose de renta y excedentes</div>
              <table class="ccr-money">
                <tr><td>Renta fija B/N</td><td class="ccr-right" t-esc="'%s %.2f' % (docs[0].currency_id.symbol or 'S/',sum(docs.mapped('renta_fija_bn')))"/></tr>
                <tr><td>Renta fija color</td><td class="ccr-right" t-esc="'%s %.2f' % (docs[0].currency_id.symbol or 'S/',sum(docs.mapped('renta_fija_color')))"/></tr>
                <tr><td>Excedente B/N</td><td class="ccr-right" t-esc="'%s %.2f' % (docs[0].currency_id.symbol or 'S/',sum(docs.mapped('monto_exceso_bn')))"/></tr>
                <tr><td>Excedente color</td><td class="ccr-right" t-esc="'%s %.2f' % (docs[0].currency_id.symbol or 'S/',sum(docs.mapped('monto_exceso_color')))"/></tr>
              </table>
            </div>
          </td>
          <td style="width:48%;">
            <div class="ccr-finance-box">
              <table class="ccr-money">
                <tr><td>Subtotal antes de descuento</td><td class="ccr-right" t-esc="'%s %.2f' % (docs[0].currency_id.symbol or 'S/',total_antes_desc)"/></tr>
                <tr><td>Descuento</td><td class="ccr-right" t-esc="'%s %.2f' % (docs[0].currency_id.symbol or 'S/',total_desc)"/></tr>
                <tr><td>Subtotal</td><td class="ccr-right" t-esc="'%s %.2f' % (docs[0].currency_id.symbol or 'S/',total_subtotal)"/></tr>
                <tr><td>IGV</td><td class="ccr-right" t-esc="'%s %.2f' % (docs[0].currency_id.symbol or 'S/',total_igv)"/></tr>
                <tr class="ccr-grand"><td>TOTAL A PAGAR</td><td class="ccr-right"><span t-esc="total_general" t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:docs[0].currency_id}"/></td></tr>
              </table>
            </div>
          </td>
        </tr></table>
        <div class="ccr-note">Los importes de excedentes y las rentas corresponden a los valores calculados y guardados en las lecturas seleccionadas. El reporte no recalcula ni modifica la facturación.</div>
      </div>
      <div class="ccr-footer">
        <table style="width:100%;border-collapse:collapse;"><tr>
          <td style="width:60%;vertical-align:top;"><span class="ccr-footer-name" t-esc="empresa.name or ''"/>
            <t t-if="empresa.vat"><br/>RUC: <t t-esc="empresa.vat"/></t>
            <t t-if="empresa.email"><br/><t t-esc="empresa.email"/></t>
            <t t-if="empresa.website"><br/><t t-esc="empresa.website"/></t>
          </td>
          <td style="width:40%;text-align:right;vertical-align:top;">
            <t t-if="empresa.phone"><t t-esc="empresa.phone"/><br/></t>
            <span>Reporte de lecturas · <t t-esc="time.strftime('%d/%m/%Y')"/></span>
          </td>
        </tr></table>
      </div>
    </div>
  </t>
</t></template>
</odoo>
