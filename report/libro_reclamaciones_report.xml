<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ========================================================= -->
    <!-- FORMATO DE PAPEL                                          -->
    <!-- ========================================================= -->

    <record id="paperformat_libro_reclamaciones" model="report.paperformat">
    <field name="name">Libro de Reclamaciones</field>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">7</field>
    <field name="margin_bottom">8</field>
    <field name="margin_left">8</field>
    <field name="margin_right">8</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">0</field>
    <field name="dpi">90</field>
</record>

    <!-- ========================================================= -->
    <!-- ACCIÓN DEL REPORTE                                        -->
    <!-- ========================================================= -->

    <record id="action_report_libro_reclamaciones" model="ir.actions.report">
    <field name="name">Hoja de Reclamación</field>
    <field name="model">libro.reclamaciones</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">copier_company.report_libro_reclamaciones</field>
    <field name="report_file">copier_company.report_libro_reclamaciones</field>
    <field name="paperformat_id" ref="copier_company.paperformat_libro_reclamaciones"/>
    <field name="print_report_name">'Hoja de Reclamacion - %s' % (object.name or '')</field>
</record>

    <!-- ========================================================= -->
    <!-- TEMPLATE QWEB                                             -->
    <!-- ========================================================= -->

    <template id="report_libro_reclamaciones">

        <t t-name="copier_company.report_libro_reclamaciones">

            <t t-call="web.basic_layout">

                <style>

                    /* =================================================
                       BASE
                    ================================================= */

                    .lr-page {
                        font-family: Arial, Helvetica, sans-serif;
                        color: #172033;
                        font-size: 9.5px;
                        line-height: 1.28;
                    }

                    .lr-page,
                    .lr-page * {
                        box-sizing: border-box;
                    }

                    .lr-page p {
                        margin: 0;
                        padding: 0;
                    }


                    /* =================================================
                       CABECERA
                    ================================================= */

                    .lr-header {
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 7px;
                    }

                    .lr-header td {
                        vertical-align: middle;
                    }

                    .lr-header-logo {
                        width: 26%;
                    }

                    .lr-header-title {
                        width: 48%;
                        text-align: center;
                    }

                    .lr-header-number {
                        width: 26%;
                        text-align: right;
                    }

                    .lr-logo {
                        max-height: 46px;
                        max-width: 165px;
                    }

                    .lr-main-title {
                        font-size: 17px;
                        font-weight: 700;
                        color: #172b4d;
                        margin: 0;
                    }

                    .lr-subtitle {
                        font-size: 10px;
                        font-weight: 700;
                        color: #667085;
                        margin-top: 2px;
                    }

                    .lr-number-box {
                        display: inline-block;
                        border: 1px solid #cdd5df;
                        border-radius: 5px;
                        padding: 6px 9px;
                        min-width: 145px;
                        background: #f8fafc;
                    }

                    .lr-number-label {
                        font-size: 7.5px;
                        color: #667085;
                        text-transform: uppercase;
                        letter-spacing: .5px;
                    }

                    .lr-number-value {
                        font-size: 11px;
                        font-weight: 700;
                        color: #172b4d;
                        margin-top: 1px;
                    }


                    /* =================================================
                       PROVEEDOR
                    ================================================= */

                    .lr-provider {
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 7px;
                        background: #f8fafc;
                        border: 1px solid #dfe5ec;
                    }

                    .lr-provider td {
                        padding: 5px 7px;
                        vertical-align: top;
                    }

                    .lr-provider-label {
                        font-size: 7px;
                        font-weight: 700;
                        text-transform: uppercase;
                        color: #667085;
                        letter-spacing: .35px;
                    }

                    .lr-provider-value {
                        font-size: 9px;
                        font-weight: 600;
                        color: #172033;
                        margin-top: 1px;
                    }


                    /* =================================================
                       SECCIONES
                    ================================================= */

                    .lr-section {
                        margin-bottom: 7px;
                        page-break-inside: avoid;
                    }

                    .lr-section-title {
                        background: #edf3fa;
                        color: #172b4d;
                        border-left: 4px solid #315b91;
                        padding: 5px 8px;
                        font-size: 9.5px;
                        font-weight: 700;
                        margin-bottom: 4px;
                    }


                    /* =================================================
                       TABLAS
                    ================================================= */

                    .lr-table {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                    }

                    .lr-table td,
                    .lr-table th {
                        border: 1px solid #d8dee7;
                        padding: 4px 6px;
                        vertical-align: top;
                    }

                    .lr-label {
                        width: 22%;
                        background: #f8fafc;
                        color: #475467;
                        font-size: 8px;
                        font-weight: 700;
                    }

                    .lr-value {
                        color: #172033;
                        font-size: 9px;
                    }

                    .lr-value-big {
                        min-height: 36px;
                    }

                    .lr-text-pre {
                        white-space: pre-wrap;
                        word-wrap: break-word;
                    }

                    .lr-center {
                        text-align: center;
                    }

                    .lr-right {
                        text-align: right;
                    }


                    /* =================================================
                       SELECCIONES
                    ================================================= */

                    .lr-option {
                        display: inline-block;
                        margin-right: 13px;
                    }

                    .lr-check {
                        display: inline-block;
                        width: 12px;
                        height: 12px;
                        line-height: 11px;
                        border: 1px solid #98a2b3;
                        text-align: center;
                        vertical-align: middle;
                        margin-right: 3px;
                        font-size: 9px;
                        font-weight: 700;
                    }

                    .lr-check-active {
                        background: #172b4d;
                        color: #ffffff;
                        border-color: #172b4d;
                    }


                    /* =================================================
                       FIRMA
                    ================================================= */

                    .lr-signature-table {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                    }

                    .lr-signature-table td {
                        width: 50%;
                        vertical-align: top;
                        text-align: center;
                        padding: 4px 8px;
                    }

                    .lr-signature-box {
                        height: 72px;
                        border-bottom: 1px solid #667085;
                        display: table;
                        width: 100%;
                    }

                    .lr-signature-inner {
                        display: table-cell;
                        vertical-align: bottom;
                        text-align: center;
                    }

                    .lr-signature-img {
                        max-height: 62px;
                        max-width: 210px;
                    }

                    .lr-signature-label {
                        margin-top: 3px;
                        font-size: 8px;
                        font-weight: 600;
                        color: #475467;
                    }


                    /* =================================================
                       ESTADO RESPUESTA
                    ================================================= */

                    .lr-response-empty {
                        color: #98a2b3;
                        font-style: italic;
                    }

                    .lr-date-response {
                        font-weight: 700;
                    }


                    /* =================================================
                       LEGALES
                    ================================================= */

                    .lr-legal {
                        border: 1px solid #d8dee7;
                        background: #fafbfc;
                        padding: 6px 8px;
                        font-size: 7.6px;
                        line-height: 1.3;
                        color: #475467;
                        page-break-inside: avoid;
                    }

                    .lr-legal p {
                        margin-bottom: 3px;
                    }

                    .lr-legal p:last-child {
                        margin-bottom: 0;
                    }

                    .lr-legal strong {
                        color: #172033;
                    }


                    /* =================================================
                       PIE
                    ================================================= */

                    .lr-footer {
                        width: 100%;
                        margin-top: 5px;
                        padding-top: 4px;
                        border-top: 1px solid #e4e7ec;
                        font-size: 7px;
                        color: #98a2b3;
                    }

                    .lr-footer-table {
                        width: 100%;
                        border-collapse: collapse;
                    }

                </style>


                <!-- ================================================= -->
                <!-- DOCUMENTOS                                       -->
                <!-- ================================================= -->

                <t t-foreach="docs"
                   t-as="o">

                    <div class="page lr-page">


                        <!-- ========================================= -->
                        <!-- CABECERA                                  -->
                        <!-- ========================================= -->

                        <table class="lr-header">

                            <tr>

                                <td class="lr-header-logo">

                                    <t t-if="o.company_id and o.company_id.logo">

                                        <img t-att-src="image_data_uri(o.company_id.logo)"
                                             class="lr-logo"/>

                                    </t>

                                </td>


                                <td class="lr-header-title">

                                    <div class="lr-main-title">
                                        LIBRO DE RECLAMACIONES
                                    </div>

                                    <div class="lr-subtitle">
                                        HOJA DE RECLAMACIÓN VIRTUAL
                                    </div>

                                </td>


                                <td class="lr-header-number">

                                    <div class="lr-number-box">

                                        <div class="lr-number-label">
                                            N.º de hoja
                                        </div>

                                        <div class="lr-number-value">
                                            <t t-esc="o.name or ''"/>
                                        </div>

                                        <div style="
                                            font-size:7.5px;
                                            margin-top:3px;
                                            color:#667085;
                                        ">

                                            Fecha:

                                            <t t-if="o.fecha_reclamo_date">
                                                <span t-field="o.fecha_reclamo_date"
                                                      t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                            </t>

                                        </div>

                                    </div>

                                </td>

                            </tr>

                        </table>


                        <!-- ========================================= -->
                        <!-- PROVEEDOR                                 -->
                        <!-- ========================================= -->

                        <table class="lr-provider">

                            <tr>

                                <td style="width:36%;">

                                    <div class="lr-provider-label">
                                        Proveedor
                                    </div>

                                    <div class="lr-provider-value">
                                        <t t-esc="o.proveedor_razon_social or ''"/>
                                    </div>

                                </td>


                                <td style="width:19%;">

                                    <div class="lr-provider-label">
                                        RUC
                                    </div>

                                    <div class="lr-provider-value">
                                        <t t-esc="o.proveedor_ruc or ''"/>
                                    </div>

                                </td>


                                <td style="width:45%;">

                                    <div class="lr-provider-label">
                                        Domicilio
                                    </div>

                                    <div class="lr-provider-value">
                                        <t t-esc="o.proveedor_domicilio or ''"/>
                                    </div>

                                </td>

                            </tr>

                        </table>


                        <!-- ========================================= -->
                        <!-- 1. CONSUMIDOR                             -->
                        <!-- ========================================= -->

                        <div class="lr-section">

                            <div class="lr-section-title">
                                1. IDENTIFICACIÓN DEL CONSUMIDOR RECLAMANTE
                            </div>

                            <table class="lr-table">

                                <tr>

                                    <td class="lr-label">
                                        NOMBRE
                                    </td>

                                    <td class="lr-value"
                                        colspan="3">

                                        <t t-esc="o.nombre_consumidor or ''"/>

                                    </td>

                                </tr>


                                <tr>

                                    <td class="lr-label">
                                        DOCUMENTO
                                    </td>

                                    <td class="lr-value">

                                        <t t-if="o.tipo_documento == 'dni'">
                                            DNI:
                                        </t>

                                        <t t-elif="o.tipo_documento == 'ce'">
                                            CE:
                                        </t>

                                        <t t-else="">
                                            Documento:
                                        </t>

                                        <strong>
                                            <t t-esc="o.numero_documento or ''"/>
                                        </strong>

                                    </td>


                                    <td class="lr-label">
                                        TELÉFONO
                                    </td>

                                    <td class="lr-value">
                                        <t t-esc="o.telefono or ''"/>
                                    </td>

                                </tr>


                                <tr>

                                    <td class="lr-label">
                                        DOMICILIO
                                    </td>

                                    <td class="lr-value"
                                        colspan="3">

                                        <t t-esc="o.domicilio_consumidor or ''"/>

                                    </td>

                                </tr>


                                <tr>

                                    <td class="lr-label">
                                        E-MAIL
                                    </td>

                                    <td class="lr-value"
                                        colspan="3">

                                        <t t-esc="o.email or ''"/>

                                    </td>

                                </tr>


                                <tr t-if="o.es_menor_edad">

                                    <td class="lr-label">
                                        MENOR DE EDAD
                                    </td>

                                    <td class="lr-value"
                                        colspan="3">

                                        Padre, madre o apoderado:

                                        <strong>
                                            <t t-esc="o.representante_menor_nombre or ''"/>
                                        </strong>

                                    </td>

                                </tr>

                            </table>

                        </div>


                        <!-- ========================================= -->
                        <!-- 2. BIEN CONTRATADO                        -->
                        <!-- ========================================= -->

                        <div class="lr-section">

                            <div class="lr-section-title">
                                2. IDENTIFICACIÓN DEL BIEN CONTRATADO
                            </div>

                            <table class="lr-table">

                                <tr>

                                    <td class="lr-label">
                                        TIPO
                                    </td>

                                    <td class="lr-value"
                                        style="width:30%;">

                                        <span class="lr-option">

                                            <span t-att-class="'lr-check lr-check-active' if o.tipo_bien == 'producto' else 'lr-check'">

                                                <t t-if="o.tipo_bien == 'producto'">
                                                    X
                                                </t>

                                            </span>

                                            PRODUCTO

                                        </span>


                                        <span class="lr-option">

                                            <span t-att-class="'lr-check lr-check-active' if o.tipo_bien == 'servicio' else 'lr-check'">

                                                <t t-if="o.tipo_bien == 'servicio'">
                                                    X
                                                </t>

                                            </span>

                                            SERVICIO

                                        </span>

                                    </td>


                                    <td class="lr-label"
                                        style="width:20%;">
                                        MONTO RECLAMADO
                                    </td>

                                    <td class="lr-value lr-right"
                                        style="width:28%;">

                                        <t t-if="o.monto_reclamado">

                                            <span t-field="o.monto_reclamado"
                                                  t-options='{
                                                      "widget": "monetary",
                                                      "display_currency": o.currency_id
                                                  }'/>

                                        </t>

                                        <t t-else="">
                                            -
                                        </t>

                                    </td>

                                </tr>


                                <tr t-if="o.numero_documento_comercial">

                                    <td class="lr-label">
                                        DOCUMENTO
                                    </td>

                                    <td class="lr-value"
                                        colspan="3">

                                        Pedido / Factura / Cotización:

                                        <strong>
                                            <t t-esc="o.numero_documento_comercial"/>
                                        </strong>

                                    </td>

                                </tr>


                                <tr>

                                    <td class="lr-label">
                                        DESCRIPCIÓN
                                    </td>

                                    <td class="lr-value lr-value-big lr-text-pre"
                                        colspan="3">

                                        <t t-esc="o.descripcion_bien or ''"/>

                                    </td>

                                </tr>

                            </table>

                        </div>


                        <!-- ========================================= -->
                        <!-- 3. RECLAMACIÓN                            -->
                        <!-- ========================================= -->

                        <div class="lr-section">

                            <div class="lr-section-title">
                                3. DETALLE DE LA RECLAMACIÓN Y PEDIDO DEL CONSUMIDOR
                            </div>

                            <table class="lr-table">

                                <tr>

                                    <td class="lr-label">
                                        TIPO
                                    </td>

                                    <td class="lr-value"
                                        colspan="3">

                                        <span class="lr-option">

                                            <span t-att-class="'lr-check lr-check-active' if o.tipo_reclamacion == 'reclamo' else 'lr-check'">

                                                <t t-if="o.tipo_reclamacion == 'reclamo'">
                                                    X
                                                </t>

                                            </span>

                                            RECLAMO

                                        </span>


                                        <span class="lr-option">

                                            <span t-att-class="'lr-check lr-check-active' if o.tipo_reclamacion == 'queja' else 'lr-check'">

                                                <t t-if="o.tipo_reclamacion == 'queja'">
                                                    X
                                                </t>

                                            </span>

                                            QUEJA

                                        </span>

                                    </td>

                                </tr>


                                <tr>

                                    <td class="lr-label">
                                        DETALLE
                                    </td>

                                    <td class="lr-value lr-value-big lr-text-pre"
                                        colspan="3">

                                        <t t-esc="o.detalle or ''"/>

                                    </td>

                                </tr>


                                <tr>

                                    <td class="lr-label">
                                        PEDIDO
                                    </td>

                                    <td class="lr-value lr-value-big lr-text-pre"
                                        colspan="3">

                                        <t t-esc="o.pedido_consumidor or ''"/>

                                    </td>

                                </tr>

                            </table>


                            <!-- ===================================== -->
                            <!-- FIRMA CONSUMIDOR                      -->
                            <!-- ===================================== -->

                            <table class="lr-signature-table">

                                <tr>

                                    <td>

                                        <div class="lr-signature-box">

                                            <div class="lr-signature-inner">

                                                <t t-if="o.firma_consumidor">

                                                    <img t-att-src="image_data_uri(o.firma_consumidor)"
                                                         class="lr-signature-img"/>

                                                </t>

                                            </div>

                                        </div>

                                        <div class="lr-signature-label">
                                            FIRMA DEL CONSUMIDOR
                                        </div>

                                    </td>


                                    <td>

                                        <div style="
                                            height:72px;
                                            display:table;
                                            width:100%;
                                        ">

                                            <div style="
                                                display:table-cell;
                                                vertical-align:middle;
                                                text-align:left;
                                                padding-left:12px;
                                            ">

                                                <div style="
                                                    font-size:8px;
                                                    color:#667085;
                                                ">
                                                    Consumidor
                                                </div>

                                                <div style="
                                                    font-size:9px;
                                                    font-weight:700;
                                                ">
                                                    <t t-esc="o.nombre_consumidor or ''"/>
                                                </div>

                                                <div style="
                                                    font-size:8px;
                                                    color:#667085;
                                                    margin-top:3px;
                                                ">
                                                    Documento:
                                                    <t t-esc="o.numero_documento or ''"/>
                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                </tr>

                            </table>

                        </div>


                        <!-- ========================================= -->
                        <!-- 4. RESPUESTA PROVEEDOR                    -->
                        <!-- ========================================= -->

                        <div class="lr-section">

                            <div class="lr-section-title">
                                4. OBSERVACIONES Y ACCIONES ADOPTADAS POR EL PROVEEDOR
                            </div>

                            <table class="lr-table">

                                <tr>

                                    <td class="lr-label">
                                        OBSERVACIONES
                                    </td>

                                    <td class="lr-value lr-value-big"
                                        colspan="3">

                                        <t t-if="o.observaciones_proveedor">

                                            <span t-field="o.observaciones_proveedor"/>

                                        </t>

                                        <t t-else="">

                                            <span class="lr-response-empty">
                                                Pendiente de atención.
                                            </span>

                                        </t>

                                    </td>

                                </tr>


                                <tr>

                                    <td class="lr-label">
                                        ACCIONES ADOPTADAS
                                    </td>

                                    <td class="lr-value lr-value-big"
                                        colspan="3">

                                        <t t-if="o.acciones_adoptadas">

                                            <span t-field="o.acciones_adoptadas"/>

                                        </t>

                                        <t t-else="">

                                            <span class="lr-response-empty">
                                                Pendiente de atención.
                                            </span>

                                        </t>

                                    </td>

                                </tr>


                                <tr t-if="o.respuesta">

                                    <td class="lr-label">
                                        RESPUESTA
                                    </td>

                                    <td class="lr-value lr-value-big"
                                        colspan="3">

                                        <span t-field="o.respuesta"/>

                                    </td>

                                </tr>


                                <tr>

                                    <td class="lr-label">
                                        FECHA DE COMUNICACIÓN
                                    </td>

                                    <td class="lr-value">

                                        <t t-if="o.fecha_comunicacion_respuesta">

                                            <span t-field="o.fecha_comunicacion_respuesta"
                                                  t-options='{
                                                      "widget": "datetime",
                                                      "format": "dd/MM/yyyy HH:mm"
                                                  }'/>

                                        </t>

                                        <t t-else="">
                                            Pendiente
                                        </t>

                                    </td>


                                    <td class="lr-label">
                                        ESTADO
                                    </td>

                                    <td class="lr-value">

                                        <t t-if="o.state == 'draft'">
                                            Borrador
                                        </t>

                                        <t t-elif="o.state == 'submitted'">
                                            Registrado
                                        </t>

                                        <t t-elif="o.state == 'review'">
                                            En revisión
                                        </t>

                                        <t t-elif="o.state == 'answered'">
                                            Respondido
                                        </t>

                                        <t t-elif="o.state == 'closed'">
                                            Cerrado
                                        </t>

                                        <t t-elif="o.state == 'cancelled'">
                                            Anulado
                                        </t>

                                    </td>

                                </tr>

                            </table>


                            <!-- ===================================== -->
                            <!-- FIRMA PROVEEDOR                       -->
                            <!-- ===================================== -->

                            <t t-if="o.firma_proveedor">

                                <table class="lr-signature-table">

                                    <tr>

                                        <td>
                                        </td>

                                        <td>

                                            <div class="lr-signature-box">

                                                <div class="lr-signature-inner">

                                                    <img t-att-src="image_data_uri(o.firma_proveedor)"
                                                         class="lr-signature-img"/>

                                                </div>

                                            </div>

                                            <div class="lr-signature-label">
                                                FIRMA DEL PROVEEDOR
                                            </div>

                                            <t t-if="o.usuario_respuesta_id">

                                                <div style="
                                                    font-size:7px;
                                                    color:#667085;
                                                ">

                                                    <t t-esc="o.usuario_respuesta_id.name"/>

                                                </div>

                                            </t>

                                        </td>

                                    </tr>

                                </table>

                            </t>

                        </div>


                        <!-- ========================================= -->
                        <!-- TEXTO LEGAL                               -->
                        <!-- ========================================= -->

                        <div class="lr-legal">

                            <p>

                                <strong>1 RECLAMO:</strong>

                                Disconformidad relacionada a los productos
                                o servicios.

                            </p>

                            <p>

                                <strong>2 QUEJA:</strong>

                                Disconformidad no relacionada a los productos
                                o servicios; o, malestar o descontento respecto
                                a la atención al público.

                            </p>

                            <p>

                                * La formulación del reclamo no impide acudir
                                a otras vías de solución de controversias ni
                                es requisito previo para interponer una denuncia
                                ante el INDECOPI.

                            </p>

                            <p>

                                * El proveedor debe dar respuesta al reclamo
                                o queja en un plazo no mayor a quince (15)
                                días hábiles, el cual es improrrogable.

                            </p>

                        </div>


                        <!-- ========================================= -->
                        <!-- PIE                                       -->
                        <!-- ========================================= -->

                        <div class="lr-footer">

                            <table class="lr-footer-table">

                                <tr>

                                    <td style="width:60%;">

                                        Documento generado electrónicamente por

                                        <strong>
                                            <t t-esc="o.company_id.name or ''"/>
                                        </strong>

                                    </td>

                                    <td style="
                                        width:40%;
                                        text-align:right;
                                    ">

                                        Página
                                        <span class="page"/>
                                        /
